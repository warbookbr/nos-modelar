  "restricoes": [
    {
      "id": "flange-maior-que-o-corpo",
      "expressao": "diametro + 2 * diametroDoFuroDoFlange + 4 - diametroDoFlange <= 0",
      "motivo": "a flange de fixação precisa passar do corpo o bastante para os furos"
    },
    {
      "id": "furos-do-flange-fora-do-corpo",
      "expressao": "diametro / 2 + diametroDoFuroDoFlange / 2 + 1 - circuloDoFlange / 2 <= 0",
      "motivo": "os furos da flange de fixação caem dentro do corpo"
    },
    {
      "id": "furos-do-flange-dentro-dela",
      "expressao": "circuloDoFlange / 2 + diametroDoFuroDoFlange / 2 + 1 - diametroDoFlange / 2 <= 0",
      "motivo": "os furos passam da borda da flange de fixação"
    },
    {
      "id": "saida-dentro-do-corpo",
      "expressao": "diametroDaSaida / 2 + chanfro + 1 - diametro / 2 <= 0",
      "motivo": "a flange de saída passa da face da frente da carcaça"
    },
    {
      "id": "furos-da-saida-dentro-dela",
      "expressao": "circuloDaSaida / 2 + diametroDoFuroDaSaida / 2 + chanfro + 0.5 - diametroDaSaida / 2 <= 0",
      "motivo": "os furos passam da borda da flange de saída"
    },
    {
      "id": "chanfro-cabe-no-flange",
      "expressao": "2 * chanfro + 1 - espessuraDoFlange <= 0",
      "motivo": "o chanfro passa da metade da espessura da flange"
    },
    {
      "id": "chanfro-cabe-na-saida",
      "expressao": "2 * chanfro + 1 - espessuraDaSaida <= 0",
      "motivo": "o chanfro passa da metade da espessura da saída"
    },
    {
      "id": "corpo-mais-longo-que-o-flange",
      "expressao": "espessuraDoFlange + diametroDoCabo + 4 - comprimento <= 0",
      "motivo": "o corpo precisa passar da flange o bastante para a saída do cabo"
    }
  ],
  "portas": [
    {
      "id": "fixacao",
      "tipo": "padraoFuros",
      "papel": "recebe"
    },
    {
      "id": "saida",
