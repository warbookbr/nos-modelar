  "restricoes": [
    {
      "id": "flange-maior-que-o-corpo",
      "expressao": "max(0, 2 - forma) * (diametro + 2 * diametroDoFuroDoFlange + 4 - diametroDoFlange) <= 0",
      "motivo": "no cilíndrico (forma 1), a flange de fixação precisa passar do corpo o bastante para os furos"
    },
    {
      "id": "furos-do-flange-fora-do-corpo",
      "expressao": "max(0, 2 - forma) * (diametro / 2 + diametroDoFuroDoFlange / 2 + 1 - circuloDoFlange / 2) <= 0",
      "motivo": "no cilíndrico (forma 1), os furos da flange de fixação caem dentro do corpo"
    },
    {
      "id": "furos-do-flange-dentro-dela",
      "expressao": "max(0, 2 - forma) * (circuloDoFlange / 2 + diametroDoFuroDoFlange / 2 + 1 - diametroDoFlange / 2) <= 0",
      "motivo": "no cilíndrico (forma 1), os furos passam da borda da flange de fixação"
    },
    {
      "id": "saida-dentro-do-corpo",
      "expressao": "max(0, 2 - forma) * (diametroDaSaida / 2 + chanfro + 1 - diametro / 2) <= 0",
      "motivo": "no cilíndrico (forma 1), a flange de saída passa da face da frente da carcaça"
    },
    {
      "id": "furos-da-saida-dentro-dela",
      "expressao": "max(0, 2 - forma) * (circuloDaSaida / 2 + diametroDoFuroDaSaida / 2 + chanfro + 0.5 - diametroDaSaida / 2) <= 0",
      "motivo": "no cilíndrico (forma 1), os furos passam da borda da flange de saída"
    },
    {
      "id": "chanfro-cabe-no-flange",
      "expressao": "max(0, 2 - forma) * (2 * chanfro + 1 - espessuraDoFlange) <= 0",
      "motivo": "no cilíndrico (forma 1), o chanfro passa da metade da espessura da flange"
    },
    {
      "id": "chanfro-cabe-na-saida",
      "expressao": "max(0, 2 - forma) * (2 * chanfro + 1 - espessuraDaSaida) <= 0",
      "motivo": "no cilíndrico (forma 1), o chanfro passa da metade da espessura da saída"
    },
    {
      "id": "corpo-mais-longo-que-o-flange",
      "expressao": "max(0, 2 - forma) * (espessuraDoFlange + diametroDoCabo + 4 - comprimento) <= 0",
      "motivo": "no cilíndrico (forma 1), o corpo precisa passar da flange o bastante para a saída do cabo"
    },
    {
      "id": "aba-abaixo-do-topo",
      "expressao": "max(0, forma - 1) * (alturaDaAba + espessuraDaAba + 1 - alturaDaCaixa) <= 0",
      "motivo": "no de caixa (forma 2), as orelhas de fixação passam do topo da caixa"
    },
    {
      "id": "cabo-abaixo-da-aba",
      "expressao": "max(0, forma - 1) * (0.25 * alturaDaCaixa + 0.12 * larguraDaCaixa + 1 - alturaDaAba) <= 0",
      "motivo": "no de caixa (forma 2), a saída do cabo encosta nas orelhas de fixação"
    },
    {
      "id": "furo-cabe-na-aba",
      "expressao": "max(0, forma - 1) * (diametroDoFuroDaAba + 1 - abaDeFixacao) <= 0",
      "motivo": "no de caixa (forma 2), o furo da orelha passa da largura dela"
    },
    {
      "id": "furos-da-aba-dentro-dela",
      "expressao": "max(0, forma - 1) * (distanciaDosFurosDaAba + diametroDoFuroDaAba + 1 - larguraDaCaixa) <= 0",
      "motivo": "no de caixa (forma 2), os furos das orelhas passam da borda delas"
    },
    {
      "id": "furos-da-aba-separados",
      "expressao": "max(0, forma - 1) * (diametroDoFuroDaAba + 1 - distanciaDosFurosDaAba) <= 0",
      "motivo": "no de caixa (forma 2), os dois furos de cada orelha se juntam"
    },
    {
      "id": "torre-dentro-da-caixa",
      "expressao": "max(0, forma - 1) * (deslocamentoDoEixo + 0.25 * larguraDaCaixa + 1 - comprimentoDaCaixa / 2) <= 0",
      "motivo": "no de caixa (forma 2), a torre do eixo passa da ponta da caixa"
    },
    {
      "id": "horn-maior-que-a-torre",
      "expressao": "max(0, forma - 1) * (0.5 * larguraDaCaixa + 2 - diametroDoHorn) <= 0",
      "motivo": "no de caixa (forma 2), o horn precisa cobrir a torre do eixo"
    }
  ],
  "portas": [
    {
      "id": "fixacao",
      "tipo": "padraoFuros",
      "papel": "recebe"
    },
    {
      "id": "saida",
      "tipo": "padraoFuros",
      "papel": "recebe"
    }
  ],
  "ferramentas": [
    "articula",
    "atuador"
  ],
  "perguntas": {
    "articula": [
      "O atuador tem a carcaça com a flange de fixação atrás, a saída do cabo de lado e a flange de saída que gira na frente, com os furos em círculo e as bordas chanfradas?",
      "O servo tem a caixa com as orelhas de fixação furadas, a torre do eixo deslocada para uma ponta, o cabo na outra e o horn redondo com quatro furos em cima?"
    ]
  },
