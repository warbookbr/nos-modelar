  "restricoes": [
    {
      "id": "rolo-cabe-no-passo",
      "expressao": "diametroDoRolo + 2 - passo <= 0",
      "motivo": "o rolo precisa ser menor que o passo da corrente"
    },
    {
      "id": "cubo-dentro-da-raiz",
      "expressao": "diametroDoCubo + passo - passo / sin(180 / dentes) + diametroDoRolo <= 0",
      "motivo": "o cubo passa da raiz dos dentes menos um passo, onde passam as placas da corrente; diminua o cubo ou aumente os dentes"
    },
    {
      "id": "furo-dentro-do-cubo",
      "expressao": "furo + 4 - diametroDoCubo <= 0",
      "motivo": "o furo precisa deixar parede de 2 mm no cubo"
    }
  ],
  "portas": [
    {
      "id": "furo",
      "tipo": "anel",
      "papel": "recebe"
    }
  ],
  "ferramentas": [
