  "restricoes": [
    {
      "id": "pino-dentro-do-rolo",
      "expressao": "diametroDoPino + 1 - diametroDoRolo <= 0",
      "motivo": "o pino precisa ser mais fino que o rolo"
    },
    {
      "id": "rolo-dentro-da-placa",
      "expressao": "diametroDoRolo + 1 - alturaDaPlaca <= 0",
      "motivo": "a placa precisa ser mais alta que o rolo"
    },
    {
      "id": "placa-cabe-no-passo",
      "expressao": "alturaDaPlaca - 2 * passo <= 0",
      "motivo": "a placa passa de dois passos de altura"
    },
    {
      "id": "distancia-cabe-as-rodas",
      "expressao": "passo / (2 * sin(180 / dentes1)) + passo / (2 * sin(180 / dentes2)) + 6 * passo - distancia <= 0",
      "motivo": "a distância entre as rodas precisa passar da soma dos raios primitivos mais seis passos, para cada trecho reto ter ao menos quatro elos"
    }
  ],
