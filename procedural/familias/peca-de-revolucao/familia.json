  "restricoes": [
    {
      "id": "copo-fundo-de-dentro-cabe-na-base",
      "expressao": "max(0, 1 - abs(forma - 0)) * (parede + 6) <= max(0, 1 - abs(forma - 0)) * (copoDiametroBase / 2)",
      "motivo": "o copo: a base precisa ter raio de ao menos a parede mais 6 mm para o fundo de dentro existir; use base maior ou parede mais fina"
    },
    {
      "id": "copo-fundo-nao-menor-que-a-parede",
      "expressao": "max(0, 1 - abs(forma - 0)) * (parede) <= max(0, 1 - abs(forma - 0)) * (copoFundo)",
      "motivo": "o copo: o fundo maciço não pode ser mais fino que a parede"
    },
    {
      "id": "copo-fundo-deixa-altura-livre",
      "expressao": "max(0, 1 - abs(forma - 0)) * (copoFundo + 10) <= max(0, 1 - abs(forma - 0)) * (copoAltura)",
      "motivo": "o copo: o fundo de dentro precisa deixar ao menos 10 mm de altura livre; use fundo mais fino ou copo mais alto"
    },
    {
      "id": "copo-boca-nao-menor-que-a-base",
      "expressao": "max(0, 1 - abs(forma - 0)) * (copoDiametroBase) <= max(0, 1 - abs(forma - 0)) * (copoDiametroBoca)",
      "motivo": "o copo afina da boca para a base; a boca menor que a base fecha o copo"
    },
    {
      "id": "copo-borda-cabe-na-parede",
      "expressao": "max(0, 1 - abs(forma - 0)) * (raioBoca) <= max(0, 1 - abs(forma - 0)) * (parede * 0.49)",
      "motivo": "o copo: os dois cantos da borda concordam em meia-cana, e o raio não passa de meia parede"
    },
    {
      "id": "copo-canto-de-baixo-cabe",
      "expressao": "max(0, 1 - abs(forma - 0)) * (raioCanto * 2) <= max(0, 1 - abs(forma - 0)) * (copoAltura / 2)",
      "motivo": "o copo: o raio do canto de baixo de fora não passa de um quarto da altura"
    },
    {
      "id": "copo-canto-do-fundo-de-dentro-cabe",
      "expressao": "max(0, 1 - abs(forma - 0)) * (copoRaioCantoFundoDentro * 1.5) <= max(0, 1 - abs(forma - 0)) * (copoDiametroBase / 2 - parede)",
      "motivo": "o copo: o raio do canto de dentro do fundo precisa caber no fundo plano"
    },
    {
      "id": "copo-canto-do-fundo-cabe-na-altura",
      "expressao": "max(0, 1 - abs(forma - 0)) * (2 * copoRaioCantoFundoDentro) <= max(0, 1 - abs(forma - 0)) * (copoAltura - copoFundo)",
      "motivo": "o copo: o canto de dentro do fundo precisa caber na parede acima do fundo"
    },
    {
      "id": "garrafa-gargalo-menor-que-o-corpo",
      "expressao": "max(0, 1 - abs(forma - 1)) * (garrafaRaioGargalo + 3) <= max(0, 1 - abs(forma - 1)) * (garrafaRaioCorpo)",
      "motivo": "a garrafa: o gargalo é mais estreito que o corpo; sem 3 mm de diferença o ombro some"
    },
    {
      "id": "garrafa-ombro-sobe",
      "expressao": "max(0, 1 - abs(forma - 1)) * (garrafaAlturaCorpo + 5) <= max(0, 1 - abs(forma - 1)) * (garrafaAlturaGargalo)",
      "motivo": "a garrafa: o ombro precisa subir ao menos 5 mm do corpo ao gargalo"
    },
    {
      "id": "garrafa-colar-acima-do-ombro",
      "expressao": "max(0, 1 - abs(forma - 1)) * (garrafaAlturaGargalo + 3) <= max(0, 1 - abs(forma - 1)) * (garrafaColarY)",
      "motivo": "a garrafa: o colar fica no gargalo, ao menos 3 mm acima do fim do ombro"
    },
    {
      "id": "garrafa-colar-abaixo-da-boca",
      "expressao": "max(0, 1 - abs(forma - 1)) * (garrafaColarY + garrafaColarAltura + 7) <= max(0, 1 - abs(forma - 1)) * (garrafaAltura)",
      "motivo": "a garrafa: o colar, com o afinamento de 2 mm, termina ao menos 5 mm abaixo da boca"
    },
    {
      "id": "garrafa-colar-mais-largo-que-o-gargalo",
      "expressao": "max(0, 1 - abs(forma - 1)) * (garrafaRaioGargalo + 3) <= max(0, 1 - abs(forma - 1)) * (garrafaColarRaio)",
      "motivo": "a garrafa: o colar sai do gargalo ao menos 3 mm"
    },
    {
      "id": "garrafa-parede-cabe-no-gargalo",
      "expressao": "max(0, 1 - abs(forma - 1)) * (parede + 5) <= max(0, 1 - abs(forma - 1)) * (garrafaRaioGargalo)",
      "motivo": "a garrafa: o furo da boca precisa ter ao menos 5 mm de raio"
    },
    {
      "id": "garrafa-apoio-dentro-do-anel",
      "expressao": "max(0, 1 - abs(forma - 1)) * (garrafaRaioApoioInterno + raioCanto + 1) <= max(0, 1 - abs(forma - 1)) * (garrafaRaioApoioExterno)",
      "motivo": "a garrafa: o anel de apoio precisa ter largura, e a cúpula do fundo acaba onde ele começa"
    },
    {
      "id": "garrafa-apoio-dentro-do-corpo",
      "expressao": "max(0, 1 - abs(forma - 1)) * (garrafaRaioApoioExterno) <= max(0, 1 - abs(forma - 1)) * (garrafaRaioCorpo)",
      "motivo": "a garrafa: o anel de apoio não passa do raio do corpo"
    },
    {
      "id": "garrafa-canto-de-baixo-cabe",
      "expressao": "max(0, 1 - abs(forma - 1)) * (raioCanto * 2 + 10) <= max(0, 1 - abs(forma - 1)) * (garrafaAlturaCorpo)",
      "motivo": "a garrafa: o canto de baixo do corpo precisa caber abaixo do ombro"
    },
    {
      "id": "garrafa-cupula-cabe-no-corpo",
      "expressao": "max(0, 1 - abs(forma - 1)) * (garrafaCupula + parede + 2) <= max(0, 1 - abs(forma - 1)) * (garrafaAlturaCorpo)",
      "motivo": "a garrafa: a cúpula do fundo precisa caber abaixo do ombro"
    },
    {
      "id": "garrafa-borda-cabe-na-parede",
      "expressao": "max(0, 1 - abs(forma - 1)) * (raioBoca) <= max(0, 1 - abs(forma - 1)) * (parede * 0.49)",
      "motivo": "a garrafa: os dois cantos da borda concordam, e o raio não passa de meia parede"
    },
    {
      "id": "vaso-boca-nao-menor-que-o-pescoco",
      "expressao": "max(0, 1 - abs(forma - 2)) * (vasoPescocoDiametro) <= max(0, 1 - abs(forma - 2)) * (vasoBocaDiametro)",
      "motivo": "o vaso: o lábio vira para fora, então a boca não é menor que o pescoço"
    },
    {
      "id": "vaso-pescoco-mais-estreito-que-a-barriga",
      "expressao": "max(0, 1 - abs(forma - 2)) * (vasoPescocoDiametro + 20) <= max(0, 1 - abs(forma - 2)) * (vasoBarrigaDiametro)",
      "motivo": "o vaso: o pescoço é ao menos 20 mm mais estreito que a barriga"
    },
    {
      "id": "vaso-pe-dentro-da-barriga",
      "expressao": "max(0, 1 - abs(forma - 2)) * (vasoPeDiametro + 10) <= max(0, 1 - abs(forma - 2)) * (vasoBarrigaDiametro)",
      "motivo": "o vaso: a barriga é a parte mais larga, e o pé fica 10 mm dentro dela"
    },
    {
      "id": "vaso-barriga-acima-do-pe",
      "expressao": "max(0, 1 - abs(forma - 2)) * (vasoPeAltura + 4) <= max(0, 1 - abs(forma - 2)) * (vasoBarrigaAltura - vasoBarrigaSemieixoY * cos(vasoAnguloInicioBarriga))",
      "motivo": "o vaso: a elipse da barriga começa acima da saia do pé"
    },
    {
      "id": "vaso-barriga-abaixo-do-pescoco",
      "expressao": "max(0, 1 - abs(forma - 2)) * (vasoBarrigaAltura - vasoBarrigaSemieixoY * cos(vasoAnguloFimBarriga) + 16) <= max(0, 1 - abs(forma - 2)) * (vasoPescocoAltura)",
      "motivo": "o vaso: a barriga termina ao menos 16 mm abaixo do ponto mais estreito do pescoço"
    },
    {
      "id": "vaso-labio-acima-do-pescoco",
      "expressao": "max(0, 1 - abs(forma - 2)) * (vasoPescocoAltura + vasoLabioAltura + 14) <= max(0, 1 - abs(forma - 2)) * (vasoAltura)",
      "motivo": "o vaso: o pescoço sobe ao menos 14 mm antes do lábio"
    },
    {
      "id": "vaso-rebaixo-dentro-da-saia",
      "expressao": "max(0, 1 - abs(forma - 2)) * (vasoRebaixoDoPe + 2) <= max(0, 1 - abs(forma - 2)) * (vasoPeAltura)",
      "motivo": "o vaso: o teto do rebaixo sob o fundo fica ao menos 2 mm abaixo do topo da saia"
    },
    {
      "id": "vaso-parede-cabe-no-pescoco",
      "expressao": "max(0, 1 - abs(forma - 2)) * (parede + 6) <= max(0, 1 - abs(forma - 2)) * (vasoPescocoDiametro / 2)",
      "motivo": "o vaso: o furo do pescoço precisa ter ao menos 6 mm de raio"
    },
    {
      "id": "vaso-parede-cabe-no-pe",
      "expressao": "max(0, 1 - abs(forma - 2)) * (parede + 5) <= max(0, 1 - abs(forma - 2)) * (vasoPeDiametro / 2)",
      "motivo": "o vaso: o rebaixo do pé precisa ter ao menos 5 mm de raio"
    },
    {
