  "restricoes": [
    {
      "id": "bucha-dentro-do-elo",
      "expressao": "diametroDaBucha + 6 - alturaDoElo <= 0",
      "motivo": "a bucha precisa caber na altura do elo"
    },
    {
      "id": "bucha-proporcional-ao-passo",
      "expressao": "0.33 * passo - diametroDaBucha <= 0",
      "motivo": "a bucha abaixo de 0,33 passo faz os flancos do dente da motriz se cruzarem"
    },
    {
      "id": "bucha-cabe-no-passo",
      "expressao": "diametroDaBucha + 10 - passo <= 0",
      "motivo": "a bucha precisa ser menor que o passo"
    },
    {
      "id": "sapata-mais-larga-que-os-elos",
      "expressao": "larguraInterna + 2 * espessuraDoElo + 20 - larguraDaSapata <= 0",
      "motivo": "a sapata precisa passar dos dois trilhos"
    },
    {
      "id": "distancia-cabe-as-rodas",
      "expressao": "passo / sin(180 / dentes) + 6 * passo - distancia <= 0",
      "motivo": "a distância precisa passar do diâmetro das rodas mais seis passos, para cada trecho reto ter ao menos quatro elos"
    }
  ],
