  "restricoes": [
    {
      "id": "carro-no-trilho",
      "expressao": "posicaoDoCarro + comprimentoDoCarro - comprimento <= 0",
      "motivo": "o carro passa da ponta do trilho; diminua a posição do carro ou aumente o trilho"
    },
    {
      "id": "dois-furos-no-trilho",
      "expressao": "passo + diametroDoRebaixo - comprimento <= 0",
      "motivo": "o trilho precisa de ao menos dois furos: o comprimento passa do passo mais o rebaixo"
    },
    {
      "id": "rebaixo-maior-que-o-furo",
      "expressao": "diametroDoFuro + 1 - diametroDoRebaixo <= 0",
      "motivo": "o rebaixo do furo do trilho precisa ser mais largo que o furo"
    },
    {
      "id": "rebaixo-cabe-no-trilho",
      "expressao": "diametroDoRebaixo + 0.2 * larguraDoTrilho + 1 - larguraDoTrilho <= 0",
      "motivo": "o rebaixo do furo come os canais das esferas do trilho"
    },
    {
      "id": "furo-nao-vara-o-trilho",
      "expressao": "profundidadeDoRebaixo + 2 - alturaDoTrilho <= 0",
      "motivo": "o rebaixo é mais fundo que o trilho"
    },
    {
      "id": "carro-mais-largo-que-o-trilho",
      "expressao": "larguraDoTrilho + 8 - larguraDoCarro <= 0",
      "motivo": "o carro precisa de parede dos dois lados do trilho"
    },
    {
      "id": "carro-acima-do-trilho",
      "expressao": "alturaDoTrilho + 3 - alturaDeMontagem <= 0",
      "motivo": "o topo do carro precisa ficar acima do trilho"
    },
    {
      "id": "folga-abaixo-do-canal",
      "expressao": "folgaDeBaixo - 0.5 * alturaDoTrilho <= 0",
      "motivo": "a folga de baixo do carro passa da metade da altura do trilho"
    },
    {
      "id": "furos-do-carro-fora-do-trilho",
      "expressao": "larguraDoTrilho + 2 + 0.85 * rosca - furosDoCarroX <= 0",
      "motivo": "os furos roscados do carro caem em cima do trilho"
    },
    {
      "id": "furos-do-carro-dentro-x",
      "expressao": "furosDoCarroX + rosca + 2 - larguraDoCarro <= 0",
      "motivo": "os furos roscados do carro passam da largura dele"
    },
    {
      "id": "furos-do-carro-dentro-y",
      "expressao": "furosDoCarroY + rosca + 2 - comprimentoDoCarro <= 0",
      "motivo": "os furos roscados do carro passam do comprimento dele"
    },
    {
      "id": "furo-roscado-cabe-no-carro",
      "expressao": "folgaDeBaixo + 1.5 * rosca + 2 - alturaDeMontagem <= 0",
      "motivo": "o fundo dos furos roscados passa da altura da parede do carro"
    }
  ],
  "portas": [
