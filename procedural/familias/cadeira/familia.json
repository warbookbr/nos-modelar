  "restricoes": [
    {
      "id": "pernas-separadas-na-largura",
      "expressao": "100 + 2 * recuoLateral + 2 * larguraDaPerna <= larguraDoAssento",
      "motivo": "as pernas de um lado e do outro ficam a menos de 100 mm entre si; use pernas mais finas, menos recuo lateral ou um assento mais largo"
    },
    {
      "id": "pernas-separadas-na-profundidade",
      "expressao": "70 + recuoDeTras + 2 * profundidadeDaPerna <= profundidadeDoAssento",
      "motivo": "as pernas da frente e as de trás ficam a menos de 60 mm entre si; use pernas mais finas, menos recuo de trás ou um assento mais fundo"
    },
    {
      "id": "saia-alta-ou-nenhuma",
      "expressao": "min(1, alturaDaSaia) * (30 - alturaDaSaia) <= 0",
      "motivo": "a saia tem 0 (sem saia) ou ao menos 30 mm de altura"
    },
    {
      "id": "saia-cabe-sob-o-assento",
      "expressao": "alturaDaSaia <= alturaDoAssento - espessuraDoAssento - 50",
      "motivo": "a saia desce da face de baixo do assento e deixa ao menos 50 mm até o chão; use uma saia mais baixa ou um assento mais alto"
    },
    {
      "id": "travessao-alto-ou-nenhum",
      "expressao": "min(1, alturaDoTravessaoLateral) * (60 - alturaDoTravessaoLateral) <= 0",
      "motivo": "o travessão lateral tem 0 (sem travessão) ou o centro a ao menos 60 mm do chão"
    },
    {
      "id": "travessao-sob-o-assento",
      "expressao": "min(1, alturaDoTravessaoLateral) * (alturaDoTravessaoLateral + 20 - (alturaDoAssento - espessuraDoAssento)) <= 0",
      "motivo": "o travessão lateral fica abaixo do assento; use uma altura menor para ele ou um assento mais alto"
    },
    {
      "id": "postes-altos-ou-nenhum",
      "expressao": "min(1, alturaDosPostes) * (alturaDoAssento + 250 - alturaDosPostes) <= 0",
      "motivo": "os postes do encosto têm 0 (as pernas de trás acabam no assento) ou sobem ao menos 250 mm acima do assento"
    },
    {
      "id": "ripas-cabem-no-vao",
      "expressao": "larguraDoConjuntoDasRipas <= larguraDoAssento - 2 * recuoLateral",
      "motivo": "o conjunto de ripas passa da largura entre as faces de fora das pernas de trás; use um conjunto mais estreito, menos recuo lateral ou um assento mais largo"
    },
    {
      "id": "ripas-tem-largura",
      "expressao": "10 * numeroDeRipas + (numeroDeRipas - 1) * vaoEntreRipas <= larguraDoConjuntoDasRipas",
      "motivo": "com esse vão entre as ripas cada uma ficaria com menos de 10 mm; use menos ripas, um vão menor ou um conjunto mais largo"
    },
    {
      "id": "ripas-acima-do-assento",
      "expressao": "alturaDoAssento - 100 <= baseDasRipas",
      "motivo": "as ripas começam mais de 100 mm abaixo do topo do assento; suba a base das ripas ou baixe o assento"
    },
    {
      "id": "ripas-tem-altura",
      "expressao": "baseDasRipas + 150 <= topoDasRipas",
      "motivo": "as ripas têm menos de 150 mm de altura; suba o topo ou baixe a base"
    },
    {
      "id": "travessa-alta-ou-nenhuma",
      "expressao": "min(1, alturaDaTravessaAlta) * (40 - alturaDaTravessaAlta) <= 0",
      "motivo": "a travessa alta tem 0 (sem travessa) ou ao menos 40 mm de altura"
    },
    {
      "id": "travessa-alta-acima-do-assento",
      "expressao": "min(1, alturaDaTravessaAlta) * (alturaDoAssento + 50 - (topoDaTravessaAlta - alturaDaTravessaAlta)) <= 0",
      "motivo": "a travessa alta desce a menos de 50 mm do assento; suba o topo dela ou use uma travessa mais baixa"
    },
    {
      "id": "travessa-baixa-ou-nenhuma",
      "expressao": "min(1, alturaDaTravessaBaixa) * (20 - alturaDaTravessaBaixa) <= 0",
      "motivo": "a travessa baixa tem 0 (sem travessa) ou ao menos 20 mm de altura"
    },
    {
      "id": "travessa-baixa-acima-do-assento",
      "expressao": "min(1, alturaDaTravessaBaixa) * (alturaDoAssento - (baseDasRipas - alturaDaTravessaBaixa)) <= 0",
      "motivo": "a travessa baixa, que fica sob as ripas, desceria abaixo do topo do assento; suba a base das ripas ou use uma travessa mais baixa"
    },
    {
      "id": "travessas-entram-nos-postes",
      "expressao": "min(1, alturaDosPostes) * min(1, alturaDaTravessaAlta + alturaDaTravessaBaixa) * (larguraDoAssento - 2 * recuoLateral - 2 * larguraDaPerna + 4 - larguraDasTravessas) <= 0",
      "motivo": "com postes, as travessas precisam passar do vão entre eles em ao menos 4 mm, para entrar 2 mm em cada poste; use travessas mais largas, pernas mais grossas ou um assento mais estreito"
    },
    {
      "id": "travessas-cabem-no-assento",
      "expressao": "larguraDasTravessas <= larguraDoAssento",
      "motivo": "as travessas do encosto são mais largas que o assento; use travessas mais estreitas ou um assento mais largo"
    }
  ],
