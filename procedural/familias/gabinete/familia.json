  "restricoes": [
    {
      "id": "base-abaixo-do-topo",
      "expressao": "alturaDaBase + alturaDoEncaixe + 2 * parede + 2 - altura <= 0",
      "motivo": "a base com o encaixe precisa ficar abaixo do teto da tampa"
    },
    {
      "id": "base-acima-do-fundo",
      "expressao": "2 * parede + 2 - alturaDaBase <= 0",
      "motivo": "a base precisa passar de duas paredes de altura"
    },
    {
      "id": "canto-maior-que-a-parede",
      "expressao": "parede + 0.5 - raioDoCanto <= 0",
      "motivo": "o raio do canto precisa passar da parede, para o vão de dentro ter canto"
    },
    {
      "id": "furo-dentro-do-ressalto",
      "expressao": "diametroDoFuro + 2 - diametroDoRessalto <= 0",
      "motivo": "o furo precisa deixar parede de 1 mm no ressalto"
    },
    {
      "id": "ressaltos-cabem-na-largura",
      "expressao": "2 * (parede + folgaDoRessalto + diametroDoRessalto) + 4 - largura <= 0",
      "motivo": "os ressaltos dos dois lados não cabem na largura"
    },
    {
      "id": "ressaltos-cabem-na-profundidade",
      "expressao": "2 * (parede + folgaDoRessalto + diametroDoRessalto) + 4 - profundidade <= 0",
      "motivo": "os ressaltos dos dois lados não cabem na profundidade"
    },
    {
      "id": "canto-nao-come-o-ressalto",
      "expressao": "raioDoCanto - parede - folgaDoRessalto - diametroDoRessalto / 2 <= 0",
      "motivo": "o raio do canto de dentro passa do ressalto; diminua o canto ou aumente a folga"
    },
    {
      "id": "rasgo-cabe-entre-os-ressaltos",
      "expressao": "max(0, grade) * (comprimentoDoRasgo + 2 * (parede + folgaDoRessalto + diametroDoRessalto) + 4 - largura) <= 0",
      "motivo": "com a grade, o rasgo passa da largura entre os ressaltos da tampa"
    },
    {
      "id": "rasgos-cabem-na-profundidade",
      "expressao": "max(0, grade) * ((rasgos - 1) * passoDosRasgos + larguraDoRasgo + 2 * (parede + folgaDoRessalto + diametroDoRessalto) + 4 - profundidade) <= 0",
      "motivo": "com a grade, os rasgos passam da profundidade entre os ressaltos da tampa"
    },
    {
      "id": "rasgos-nao-se-tocam",
      "expressao": "max(0, grade) * (larguraDoRasgo + 1 - passoDosRasgos) <= 0",
      "motivo": "com a grade, o passo dos rasgos precisa deixar 1 mm entre eles"
    },
    {
      "id": "rasgo-mais-longo-que-largo",
      "expressao": "max(0, grade) * (larguraDoRasgo + 1 - comprimentoDoRasgo) <= 0",
      "motivo": "o rasgo precisa ser mais comprido que largo"
    },
    {
      "id": "recortes-na-altura-da-base",
      "expressao": "max(0, recortes) * (max(alturaDoRetangulo, diametroDoRedondo) / 2 + parede + 1 - alturaDosRecortes) <= 0",
      "motivo": "com os recortes, eles descem abaixo do fundo da base"
    },
    {
      "id": "recortes-abaixo-da-divisao",
      "expressao": "max(0, recortes) * (alturaDosRecortes + max(alturaDoRetangulo, diametroDoRedondo) / 2 + 1 - alturaDaBase) <= 0",
      "motivo": "com os recortes, eles sobem acima da divisão da base"
    },
    {
      "id": "retangulo-dentro-da-frente",
      "expressao": "max(0, recortes) * (abs(centroDoRetangulo) + larguraDoRetangulo / 2 + raioDoCanto + 1 - largura / 2) <= 0",
      "motivo": "com os recortes, o retangular passa da parte reta da frente"
    },
    {
      "id": "redondo-dentro-da-frente",
      "expressao": "max(0, recortes) * (abs(centroDoRedondo) + diametroDoRedondo / 2 + raioDoCanto + 1 - largura / 2) <= 0",
      "motivo": "com os recortes, o redondo passa da parte reta da frente"
    },
    {
      "id": "recortes-separados",
      "expressao": "max(0, recortes) * (larguraDoRetangulo / 2 + diametroDoRedondo / 2 + 2 - abs(centroDoRedondo - centroDoRetangulo)) <= 0",
      "motivo": "com os recortes, o retangular e o redondo se encostam"
    }
  ],
