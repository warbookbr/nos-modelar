      "PN4": ["=frenteDoCapo+0.4", "painel"], "PN5": ["=frenteDoCapo+111.7", "painel"], "PN6": ["=frenteDoCapo+111.7", "=capo-3.5"],

      "CA1": ["frenteDoCapo", "baseCapo"], "CA2": ["comprimento", "baseCapo"], "CA3": ["=comprimento-9.9", "=baseCapo+141.1"],
      "CA4": ["=comprimento-94.3", "=baseCapo+170.9"], "CA5": ["=comprimento-186", "=capo-15.6"], "CA6": ["=frenteDoCapo+27.6", "capo"],
      "CA7": ["frenteDoCapo", "=topo-20"],

