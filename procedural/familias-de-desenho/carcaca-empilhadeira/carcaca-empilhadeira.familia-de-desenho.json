  "desenho": {
    "formato": "mecanifica.desenho@3",
    "objeto": "carcaça de empilhadeira",
    "vista": "lateral",
    "olhando": "do lado direito, frente à esquerda, sem rodas, torre, garfos, assento nem volante",
    "parametros": {
      "arcoT": "=comprimento-raioT-balanco",
      "painel": "=encosto+subidaDoPainel",
      "capo": "=painel-quedaDoCapo",
      "altura": "=painel+folgaDaTampa",
      "pe": 24,
      "raioD": "=vaoD-14.8",
      "centroT": 129.8,
      "saidaDoLateral": 170.2,
      "topoDoLateral": 247.85,
      "baseCapo": "=raioT+152.4",
      "quebraDaRampa": 50.9,
      "arestaDoPainel": "=quedaDoCapo+(111.7-(capo-topo+20)/tan(81.79))*tan(2.41)",
      "retoDoPainel": "=228.535-(subidaDoPainel-56.292-tan(2.18)*(topoDaRampa-avanco-752.25))/tan(28.34)",
      "raioDoPainel": "=min(20*arestaDoPainel/23.138, retoDoPainel-19)",
      "topoDaRampa": "=arcoT-raioT+saidaDoLateral-topoDoLateral",
      "peDaRampa": "=topoDaRampa-(piso-quebraDaRampa-posto)/tan(rampa)-(topo-piso+quebraDaRampa)/tan(rampa+5.15)",
      "frenteDoCapo": "=arcoT-raioT+136.5"
    },
    "referencias": {
      "chao": { "reta": "horizontal", "v": 0 },
      "frente": { "reta": "vertical", "h": 0 },
      "traseira": { "reta": "vertical", "h": "comprimento" }
    },
    "usos": {
      "arco": {
        "peca": "arcoRecortadoComAro",
        "parametros": { "altura": "=face-pe", "topo": "=arcoD-pe", "vao": "vaoD", "raio": "aro" },
        "origem": ["avanco", "pe"],
        "nomeiaPartes": { "aro": "aro" }
      },
      "vao": {
        "peca": "vaoFechadoPelaLongarina",
        "parametros": { "raio": "raioT", "saidaDianteira": "saidaDoLateral", "fundo": "=centroT-pe" },
        "origem": ["arcoT", "centroT"],
        "nomeiaPartes": { "longarina": "longarina" }
      },
      "rampa": {
        "peca": "rampaComOmbro",
        "parametros": { "baixa": "=piso-quebraDaRampa-posto", "alta": "=topo-piso+quebraDaRampa", "anguloBaixo": "rampa", "anguloAlto": "=rampa+5.15" },
        "origem": ["peDaRampa", "posto"]
      }
    },
    "pontos": {
      "PA": [0, "=face+22"], "PD": [0, "face"],
      "SA": ["=avanco-49", "face"], "SB": ["=avanco-58", "=face-58"], "SC": ["avanco", "=face-62"],

      "SF": ["=avanco+vaoD+120", "pe"], "SG": ["=avanco+vaoD+150", 0],
      "SH": ["=arcoT-raioT-52.8", 0], "SI": ["=arcoT-raioT-42.8", "pe"],
      "LU": ["=arcoT-raioT+saidaDoLateral", "topo"],
      "G0": ["=avanco+aro+6", "posto"], "G1": ["=avanco+aro+6", "=face-aro-4"],

      "PI2": ["=avanco+29", "=piso+173"], "PI3": ["=avanco+327", "piso"], "PI4": ["=peDaRampa+(piso-posto)/tan(rampa)", "piso"],

      "E1": ["=avanco+623", "=piso-8"], "E2": ["=avanco+623", "=encosto-96.4"], "E3": ["=avanco+692.6", "encosto"],
      "E4": ["=topoDaRampa-59.65", "=encosto+15"], "E5b": ["=topoDaRampa+31.8", "=encosto+60.4"], "E5": ["=topoDaRampa+61.05", "=encosto+60.4"],
      "E6": ["=topoDaRampa+14.66", "=topo+17.7"], "E7": ["=topoDaRampa-7.33", "=topo-6.04"],
