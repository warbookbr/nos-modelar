{
  "formato": "mecanifica.familia-de-desenho@1",
  "id": "braco-colaborativo",
  "versao": "1.0.0",
  "descricao": "a vista lateral de um braço robótico colaborativo de seis eixos, na pose de L (coluna em pé, antebraço na horizontal, punho para baixo), com as 14 partes do contorno da referência lateral-sem-cabo do braço robótico",
  "parametros": {
    "alturaBase": { "unidade": "mm", "padrao": 236, "minimo": 190, "medio": 236, "maximo": 280, "descricao": "do chão ao topo do corpo da base" },
    "diametroBaixo": { "unidade": "mm", "padrao": 206, "minimo": 185, "medio": 206, "maximo": 236, "descricao": "a largura do corpo da base; o anel da cintura tem 6 mm a menos e o ombro 9" },
    "alturaOmbro": { "unidade": "mm", "padrao": 181, "minimo": 155, "medio": 181, "maximo": 205, "descricao": "a altura do ombro, com a junta do ombro no meio dela" },
    "comprimentoBraco": { "unidade": "mm", "padrao": 509.5, "minimo": 400, "medio": 509.5, "maximo": 610, "descricao": "da junta do ombro ao eixo do antebraço, na vertical" },
    "diametroCima": { "unidade": "mm", "padrao": 175.5, "minimo": 150, "medio": 175.5, "maximo": 195, "descricao": "a largura da coluna de cima (anel do cotovelo, cotovelo e topo do braço)" },
    "comprimentoAntebraco": { "unidade": "mm", "padrao": 636, "minimo": 510, "medio": 636, "maximo": 720, "descricao": "do eixo da base ao eixo do punho, na horizontal" },
    "diametroAntebraco": { "unidade": "mm", "padrao": 130, "minimo": 110, "medio": 130, "maximo": 148, "descricao": "o tubo do antebraço; a junta e o anel do antebraço passam 11 mm de cada lado" },
    "larguraPunho": { "unidade": "mm", "padrao": 110, "minimo": 92, "medio": 110, "maximo": 126, "descricao": "a largura dos anéis do punho; o garfo, o pescoço e a flange seguem a proporção da referência" },
    "alturaPunho": { "unidade": "mm", "padrao": 250, "minimo": 210, "medio": 250, "maximo": 285, "descricao": "do fundo da carcaça do punho à face de baixo da flange" }
  },
  "perfis": {
    "referencia": {
      "descricao": "as medidas do desenho ajustado à referência lateral-sem-cabo (banco de provas familias-de-desenho-2026-10-14/braco)",
      "parametros": {
        "alturaBase": 236, "diametroBaixo": 206, "alturaOmbro": 181, "comprimentoBraco": 509.5, "diametroCima": 175.5,
        "comprimentoAntebraco": 636, "diametroAntebraco": 130, "larguraPunho": 110, "alturaPunho": 250
      }
    }
  },
  "desenho": {
    "formato": "mecanifica.desenho@3",
    "objeto": "braço robótico colaborativo",
    "vista": "lateral",
    "olhando": "de lado, coluna à esquerda e antebraço horizontal indo para a direita, no sistema do contorno da referência lateral-sem-cabo",
    "parametros": {
      "nivelDoChao": -5,
      "escalaBaixo": "=diametroBaixo/206",
      "escalaCima": "=diametroCima/175.5",
      "escalaAntebraco": "=diametroAntebraco/130",
      "escalaLarguraPunho": "=larguraPunho/110",
      "escalaAlturaPunho": "=alturaPunho/250",

      "topoBase": "=nivelDoChao+alturaBase",
      "meiaBase": "=diametroBaixo/2",
      "espessuraChapa": "=28*escalaBaixo",
      "sobraChapa": "=12*escalaBaixo",
      "raioChapa": "=10*escalaBaixo",
      "folgaCaixa": "=24*escalaBaixo",
      "alturaCaixa": "=alturaBase-28*escalaBaixo",
      "larguraCaixa": "=64.5*escalaBaixo",
      "avancoCaixa": "=13*escalaBaixo",

      "alturaCintura": "=51*escalaBaixo",
      "diametroCintura": "=diametroBaixo-6",
      "diametroOmbro": "=diametroBaixo-9",
      "juntaOmbro": "=topoBase+alturaCintura+alturaOmbro/2",
      "topoOmbro": "=juntaOmbro+alturaOmbro/2",
      "raioPeloOmbroAlto": "=alturaOmbro/2-4.5*escalaBaixo",
      "raioPeloOmbroLargo": "=diametroOmbro/2-12.5*escalaBaixo",
      "raioPontaBraco": "=(raioPeloOmbroAlto+raioPeloOmbroLargo-sqrt((raioPeloOmbroAlto-raioPeloOmbroLargo)*(raioPeloOmbroAlto-raioPeloOmbroLargo)))/2",

      "eixoAntebraco": "=juntaOmbro+comprimentoBraco",
      "bordaCimaDireita": "=78.5*escalaCima",
      "bordaCimaEsquerda": "=97*escalaCima",
      "recuoCima": "=9.25*escalaCima",
      "anelCotoveloAbaixo": "=134*escalaCima",
      "alturaAnelCotovelo": "=52*escalaCima",
      "alturaCotovelo": "=195*escalaCima",
      "raioCotovelo": "=32*escalaCima",
      "recuoSaidaOmbro": "=6.5*escalaCima",
      "recuoAlargamento": "=10.5*escalaCima",
      "inicioAlargamento": "=45*escalaCima",
      "fimAlargamento": "=20*escalaCima",

      "diametroJunta": "=diametroAntebraco+22",
      "larguraJunta": "=30.5*escalaAntebraco",
      "larguraAnelAntebraco": "=72*escalaAntebraco",
      "raioAnelAntebraco": "=6*escalaAntebraco",
      "raioPontaCarcaca": "=67*escalaAntebraco",
      "comprimentoCarcaca": "=295*escalaAntebraco",
      "raioCarcaca": "=30*escalaAntebraco",
      "entradaDoTubo": "=30*escalaAntebraco",

      "aneisAbaixoDaCarcaca": "=81*escalaAlturaPunho",
      "comprimentoAneis": "=raioPontaCarcaca+aneisAbaixoDaCarcaca",
      "raioAneis": "=12*escalaLarguraPunho"
    },
    "referencias": {
      "chao": { "reta": "horizontal", "v": "nivelDoChao" },
      "eixoDaBase": { "reta": "vertical", "h": 0 }
    },
    "pontos": {
      "BA": ["=-meiaBase-sobraChapa", "nivelDoChao"],
      "BB": ["=meiaBase+sobraChapa", "nivelDoChao"],
      "BC": ["=meiaBase+sobraChapa", "=nivelDoChao+espessuraChapa"],
      "BD": ["meiaBase", "=nivelDoChao+espessuraChapa"],
      "BE": ["meiaBase", "topoBase"],
      "BF": ["=-meiaBase", "topoBase"],
      "BG": ["=-meiaBase", "=nivelDoChao+espessuraChapa"],
      "BH": ["=-meiaBase-sobraChapa", "=nivelDoChao+espessuraChapa"],

      "R4": ["=bordaCimaDireita-recuoSaidaOmbro", "topoOmbro"],
      "R5": ["=bordaCimaDireita-recuoAlargamento", "=eixoAntebraco-anelCotoveloAbaixo-inicioAlargamento"],
      "R6": ["bordaCimaDireita", "=eixoAntebraco-anelCotoveloAbaixo-fimAlargamento"],
      "U2": ["bordaCimaDireita", "=eixoAntebraco-anelCotoveloAbaixo"],
      "U1": ["=-bordaCimaEsquerda", "=eixoAntebraco-anelCotoveloAbaixo"],
      "R9": ["=-bordaCimaEsquerda", "=eixoAntebraco-anelCotoveloAbaixo-fimAlargamento"],
      "R10": ["=-bordaCimaEsquerda+recuoAlargamento", "=eixoAntebraco-anelCotoveloAbaixo-inicioAlargamento"],
      "R11": ["=-bordaCimaEsquerda+recuoSaidaOmbro", "topoOmbro"],

      "F3": ["=comprimentoAntebraco+raioPontaCarcaca-comprimentoCarcaca+entradaDoTubo", "eixoAntebraco"],
      "P1": ["=comprimentoAntebraco+raioPontaCarcaca-comprimentoCarcaca", "=eixoAntebraco-raioPontaCarcaca"],
      "P4": ["=comprimentoAntebraco+raioPontaCarcaca-comprimentoCarcaca", "=eixoAntebraco+raioPontaCarcaca"]
    },
    "partes": {
      "base": { "poligono": ["BA", "BB", "BC", "BD", "BE", "BF", "BG", "BH"], "raioDoCanto": { "BA": "raioChapa", "BB": "raioChapa" } },
      "braco": {
        "poligono": ["pontaBraco.canto2", "pontaBraco.canto1", "pontaBraco.lado1", "R4", "R5", "R6", "U2", "U1", "R9", "R10", "R11", "pontaBraco.lado2"],
        "raioDoCanto": { "pontaBraco.canto2": "raioPontaBraco", "pontaBraco.canto1": "raioPontaBraco" }
      },
      "antebraco": { "barra": ["tamborAntebraco.fim", "F3"], "espessura": "diametroAntebraco" },
      "carcacaPunho": {
        "poligono": ["P1", "pontaCarcaca.canto2", "pontaCarcaca.canto1", "P4"],
        "raioDoCanto": { "P1": "raioCarcaca", "pontaCarcaca.canto2": "raioPontaCarcaca", "pontaCarcaca.canto1": "raioPontaCarcaca", "P4": "raioCarcaca" }
      }
    },
    "usos": {
      "blocoCaixa": {
        "peca": "blocoDeJunta",
        "parametros": { "largura": "larguraCaixa", "altura": "alturaCaixa", "raioTopo1": "=8*escalaBaixo", "raioTopo2": "=15*escalaBaixo" },
        "origem": ["=-meiaBase+avancoCaixa-larguraCaixa", "=nivelDoChao+folgaCaixa"],
        "nomeiaPartes": { "corpo": "caixaLateral" }
      },
      "tamborCintura": {
        "peca": "anelCoaxial",
        "parametros": { "diametro": "diametroCintura", "comprimento": "alturaCintura" },
        "origem": [0, "topoBase"],
        "nomeiaPartes": { "corpo": "anelCintura" }
      },
      "tamborOmbro": {
        "peca": "anelCoaxial",
        "parametros": { "diametro": "diametroOmbro", "comprimento": "alturaOmbro" },
        "origem": [0, "=topoBase+alturaCintura"],
        "nomeiaPartes": { "corpo": "ombro" }
      },
      "pontaBraco": {
        "peca": "pontaConcentrica",
        "parametros": { "raio": "raioPontaBraco", "angulo": -90 },
        "origem": [0, "juntaOmbro"]
      },
      "tamborCotovelo": {
        "peca": "anelCoaxial",
        "parametros": { "diametro": "diametroCima", "comprimento": "alturaAnelCotovelo" },
        "origem": ["=-recuoCima", "=eixoAntebraco-anelCotoveloAbaixo"],
        "nomeiaPartes": { "corpo": "anelCotovelo" }
      },
      "blocoCotovelo": {
        "peca": "blocoDeJunta",
        "parametros": { "largura": "diametroCima", "altura": "alturaCotovelo", "raioTopo1": "raioCotovelo", "raioTopo2": "raioCotovelo" },
        "origem": ["=-bordaCimaEsquerda", "=eixoAntebraco-anelCotoveloAbaixo+alturaAnelCotovelo"],
        "nomeiaPartes": { "corpo": "cotovelo" }
      },
      "tamborJunta": {
        "peca": "anelCoaxial",
        "parametros": { "diametro": "diametroJunta", "comprimento": "larguraJunta", "angulo": 0 },
        "origem": ["bordaCimaDireita", "eixoAntebraco"],
        "nomeiaPartes": { "corpo": "juntaCotovelo" }
      },
      "tamborAntebraco": {
        "peca": "anelCoaxial",
        "parametros": { "diametro": "diametroJunta", "comprimento": "larguraAnelAntebraco", "canto": "raioAnelAntebraco", "angulo": 0 },
        "origem": ["=bordaCimaDireita+larguraJunta", "eixoAntebraco"],
        "nomeiaPartes": { "corpo": "anelAntebraco" }
      },
      "pontaCarcaca": {
        "peca": "pontaConcentrica",
        "parametros": { "raio": "raioPontaCarcaca", "angulo": 0 },
        "origem": ["comprimentoAntebraco", "eixoAntebraco"]
      },
      "tamborPunho": {
        "peca": "anelCoaxial",
        "parametros": { "diametro": "larguraPunho", "comprimento": "comprimentoAneis", "canto": "raioAneis", "angulo": -90 },
        "origem": ["comprimentoAntebraco", "eixoAntebraco"],
        "nomeiaPartes": { "corpo": "aneisPunho" }
      },
      "punho": {
        "peca": "flangeComCubo",
        "parametros": {
          "larguraGarfo": "=102*escalaLarguraPunho", "alturaGarfo": "=102*escalaAlturaPunho",
          "larguraPescoco": "=56*escalaLarguraPunho", "alturaPescoco": "=26*escalaAlturaPunho",
          "diametroFlange": "=160*escalaLarguraPunho", "espessuraFlange": "=41*escalaAlturaPunho",
          "raioDoTopo": "=5*escalaLarguraPunho", "raioDoFundo1": "=4*escalaLarguraPunho", "raioDoFundo2": "=10*escalaLarguraPunho", "angulo": -90
        },
        "origem": ["comprimentoAntebraco", "=eixoAntebraco-comprimentoAneis"],
        "nomeiaPartes": { "cubo": "garfoPunho", "disco": "flange" }
      }
    },
    "frenteParaFundo": [
      "caixaLateral", "base", "anelCintura", "braco", "ombro", "anelCotovelo", "cotovelo", "juntaCotovelo",
      "anelAntebraco", "carcacaPunho", "antebraco", "aneisPunho", "garfoPunho", "flange"
    ],
    "relacoes": [
      { "nome": "chapa no chão à esquerda", "sobre": ["BA", "chao"] },
      { "nome": "chapa no chão à direita", "sobre": ["BB", "chao"] },
      { "nome": "borda esquerda da chapa a prumo", "vertical": ["BA", "BH"] },
      { "nome": "borda direita da chapa a prumo", "vertical": ["BB", "BC"] },
      { "nome": "espessura da chapa", "distancia": ["BH", "chao"], "mm": "espessuraChapa", "lado": "acima" },
      { "nome": "face de cima da chapa de nível (esquerda)", "horizontal": ["BH", "BG"] },
      { "nome": "face de cima da chapa de nível (meio)", "horizontal": ["BG", "BD"] },
      { "nome": "face de cima da chapa de nível (direita)", "horizontal": ["BD", "BC"] },
      { "nome": "meia largura da base (esquerda)", "distancia": ["BG", "eixoDaBase"], "mm": "meiaBase", "lado": "esquerda" },
      { "nome": "meia largura da base (direita)", "distancia": ["BD", "eixoDaBase"], "mm": "meiaBase", "lado": "direita" },
      { "nome": "lado esquerdo da base a prumo", "vertical": ["BG", "BF"] },
      { "nome": "lado direito da base a prumo", "vertical": ["BD", "BE"] },
      { "nome": "altura da base", "distancia": ["BE", "chao"], "mm": "alturaBase", "lado": "acima" },
      { "nome": "topo da base de nível", "horizontal": ["BF", "BE"] },
      { "nome": "chapa passa do corpo à esquerda", "distancia": ["BH", ["BG", "BF"]], "mm": "sobraChapa", "lado": "esquerda" },
      { "nome": "chapa passa do corpo à direita", "distancia": ["BC", ["BD", "BE"]], "mm": "sobraChapa", "lado": "direita" },

      { "nome": "folga da caixa sobre o chão", "distancia": ["blocoCaixa.base1", "chao"], "mm": "folgaCaixa", "lado": "acima" },
      { "nome": "fundo da caixa de nível", "horizontal": ["blocoCaixa.base1", "blocoCaixa.base2"] },
      { "nome": "caixa avança sobre a base", "distancia": ["blocoCaixa.base2", ["BG", "BF"]], "mm": "avancoCaixa", "lado": "direita" },

      { "nome": "anel da cintura no eixo da base", "sobre": ["tamborCintura.inicio", "eixoDaBase"] },
      { "nome": "anel da cintura assenta no topo da base", "sobre": ["tamborCintura.inicio", ["BF", "BE"]] },
      { "nome": "anel da cintura em pé no eixo", "sobre": ["tamborCintura.fim", "eixoDaBase"] },
      { "nome": "ombro empilhado na cintura", "coincidente": ["tamborOmbro.inicio", "tamborCintura.fim"] },
      { "nome": "ombro em pé no eixo", "sobre": ["tamborOmbro.fim", "eixoDaBase"] },

      { "nome": "ponta do braço concêntrica com a junta do ombro", "coincidente": ["pontaBraco.junta", "tamborOmbro.meio"] },
      { "nome": "ponta do braço de nível", "horizontal": ["pontaBraco.lado1", "pontaBraco.lado2"] },
      { "nome": "braço sai do topo do ombro (direita)", "horizontal": ["R4", "tamborOmbro.fim"] },
      { "nome": "recuo do braço na saída do ombro (direita)", "distancia": ["R4", "U2"], "mm": "recuoSaidaOmbro", "eixo": "h", "lado": "esquerda" },
      { "nome": "braço sai do topo do ombro (esquerda)", "horizontal": ["R11", "tamborOmbro.fim"] },
      { "nome": "recuo do braço na saída do ombro (esquerda)", "distancia": ["R11", "U1"], "mm": "recuoSaidaOmbro", "eixo": "h", "lado": "direita" },
      { "nome": "recuo do braço sob o alargamento (direita)", "distancia": ["R5", "U2"], "mm": "recuoAlargamento", "eixo": "h", "lado": "esquerda" },
      { "nome": "alargamento do braço começa (direita)", "distancia": ["R5", "U2"], "mm": "inicioAlargamento", "eixo": "v", "lado": "abaixo" },
      { "nome": "recuo do braço sob o alargamento (esquerda)", "distancia": ["R10", "U1"], "mm": "recuoAlargamento", "eixo": "h", "lado": "direita" },
      { "nome": "alargamento do braço começa (esquerda)", "distancia": ["R10", "U1"], "mm": "inicioAlargamento", "eixo": "v", "lado": "abaixo" },
      { "nome": "alargamento chega ao prumo da coluna (direita)", "vertical": ["R6", "U2"] },
      { "nome": "alargamento termina abaixo do anel (direita)", "distancia": ["R6", "U2"], "mm": "fimAlargamento", "eixo": "v", "lado": "abaixo" },
      { "nome": "alargamento chega ao prumo da coluna (esquerda)", "vertical": ["R9", "U1"] },
      { "nome": "alargamento termina abaixo do anel (esquerda)", "distancia": ["R9", "U1"], "mm": "fimAlargamento", "eixo": "v", "lado": "abaixo" },
      { "nome": "pé do anel do cotovelo à esquerda", "horizontal": ["U1", "tamborCotovelo.inicio"] },
      { "nome": "lado esquerdo da coluna de cima", "distancia": ["U1", "tamborCotovelo.inicio"], "mm": "=diametroCima/2", "eixo": "h", "lado": "esquerda" },
      { "nome": "pé do anel do cotovelo à direita", "horizontal": ["U2", "tamborCotovelo.inicio"] },
      { "nome": "lado direito da coluna de cima", "distancia": ["U2", "tamborCotovelo.inicio"], "mm": "=diametroCima/2", "eixo": "h", "lado": "direita" },

      { "nome": "eixo da coluna de cima recuado do eixo da base", "distancia": ["tamborCotovelo.inicio", "eixoDaBase"], "mm": "recuoCima", "lado": "esquerda" },
      { "nome": "anel do cotovelo abaixo do eixo do antebraço", "distancia": ["tamborCotovelo.inicio", "tamborJunta.inicio"], "mm": "anelCotoveloAbaixo", "eixo": "v", "lado": "abaixo" },
      { "nome": "anel do cotovelo a prumo", "vertical": ["tamborCotovelo.inicio", "tamborCotovelo.fim"] },
      { "nome": "cotovelo assenta no anel (altura)", "horizontal": ["blocoCotovelo.base1", "tamborCotovelo.fim"] },
      { "nome": "cotovelo assenta no anel (lado)", "distancia": ["blocoCotovelo.base1", "tamborCotovelo.fim"], "mm": "=diametroCima/2", "eixo": "h", "lado": "esquerda" },
      { "nome": "base do cotovelo de nível", "horizontal": ["blocoCotovelo.base1", "blocoCotovelo.base2"] },

      { "nome": "junta do cotovelo sai da face direita do cotovelo", "sobre": ["tamborJunta.inicio", ["blocoCotovelo.base2", "blocoCotovelo.topo2"]] },
      { "nome": "comprimento do braço, da junta do ombro ao eixo do antebraço", "distancia": ["tamborJunta.inicio", "tamborOmbro.meio"], "mm": "comprimentoBraco", "eixo": "v", "lado": "acima" },
      { "nome": "junta do cotovelo no eixo do antebraço", "horizontal": ["tamborJunta.inicio", "tamborJunta.fim"] },
      { "nome": "anel do antebraço empilhado na junta", "coincidente": ["tamborAntebraco.inicio", "tamborJunta.fim"] },
      { "nome": "anel do antebraço no eixo", "horizontal": ["tamborAntebraco.fim", "tamborJunta.inicio"] },
      { "nome": "tubo do antebraço no eixo", "horizontal": ["F3", "tamborJunta.inicio"] },
      { "nome": "tubo do antebraço entra na carcaça do punho", "distancia": ["F3", "P1"], "mm": "entradaDoTubo", "eixo": "h", "lado": "direita" },

      { "nome": "eixo do punho na altura do antebraço", "horizontal": ["tamborPunho.inicio", "tamborJunta.inicio"] },
      { "nome": "comprimento do antebraço, do eixo da base ao eixo do punho", "distancia": ["tamborPunho.inicio", "eixoDaBase"], "mm": "comprimentoAntebraco", "lado": "direita" },
      { "nome": "anéis do punho a prumo", "vertical": ["tamborPunho.inicio", "tamborPunho.fim"] },
