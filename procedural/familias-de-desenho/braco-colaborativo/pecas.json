{
  "formato": "mecanifica.pecas-de-desenho@1",
  "pecas": {
    "anelCoaxial": {
      "descricao": "tambor num eixo: a barra do início ao fim com a espessura igual ao diâmetro e o meio marcado. Empilha-se pondo o início de um no fim do outro. A orientação vem do uso: o eixo (h ou v) e o sentido (acima, abaixo, direita ou esquerda) em que o fim fica do início, e a distância entre os dois tem sinal. O ângulo (graus, de h para v) é a direção do início para o fim e só serve ao chute, mas precisa apontar para o mesmo lado do sentido: o uso que pede o tambor para baixo e o chuta para cima sai com o aviso de peça virada.",
      "parametros": { "diametro": null, "comprimento": null, "canto": 1, "angulo": 90, "eixo": "v", "sentido": "acima" },
      "pontos": {
        "P": [0, 0],
        "Q": ["=comprimento*cos(angulo)", "=comprimento*sin(angulo)"],
        "M": ["=comprimento/2*cos(angulo)", "=comprimento/2*sin(angulo)"]
      },
      "partes": {
        "corpo": { "barra": ["P", "Q"], "espessura": "diametro", "raioDoCanto": "canto" }
      },
      "relacoes": [
        { "nome": "comprimento", "distancia": ["Q", "P"], "mm": "comprimento", "eixo": "eixo", "lado": "sentido" },
        { "nome": "meio no eixo", "sobre": ["M", ["P", "Q"]] },
        { "nome": "meio a meio caminho", "igual": [["P", "M"], ["M", "Q"]] }
      ],
      "ligacoes": { "inicio": "P", "fim": "Q", "meio": "M", "corpo": "corpo" }
    },

    "pontaConcentrica": {
      "descricao": "a ponta arredondada de um elo, concêntrica com a junta: os dois lados a um raio da junta, na reta que passa por ela, e os dois cantos a um raio de cada lado, em esquadro. O polígono do elo cita os cantos e os arredonda com o mesmo raio, e a ponta sai em semicírculo com centro na junta. O ângulo (graus) é a direção para onde a ponta aponta e só serve ao chute; o desenho de fora dá a direção da reta dos lados.",
      "parametros": { "raio": null, "angulo": -90 },
      "pontos": {
        "C": [0, 0],
        "S1": ["=raio*cos(angulo+90)", "=raio*sin(angulo+90)"],
        "S2": ["=raio*cos(angulo-90)", "=raio*sin(angulo-90)"],
        "K1": ["=raio*cos(angulo+90)+raio*cos(angulo)", "=raio*sin(angulo+90)+raio*sin(angulo)"],
        "K2": ["=raio*cos(angulo-90)+raio*cos(angulo)", "=raio*sin(angulo-90)+raio*sin(angulo)"]
      },
      "relacoes": [
        { "nome": "lados alinhados com a junta", "sobre": ["C", ["S1", "S2"]] },
        { "nome": "lado 1 a um raio da junta", "distancia": ["C", "S1"], "mm": "raio" },
        { "nome": "lado 2 a um raio da junta", "distancia": ["C", "S2"], "mm": "raio" },
        { "nome": "canto 1 em esquadro", "perpendicular": [["S1", "K1"], ["S1", "S2"]] },
        { "nome": "canto 1 a um raio do lado", "distancia": ["S1", "K1"], "mm": "raio" },
        { "nome": "canto 2 em esquadro", "perpendicular": [["S2", "K2"], ["S1", "S2"]] },
        { "nome": "canto 2 a um raio do lado", "distancia": ["S2", "K2"], "mm": "raio" }
      ],
      "ligacoes": { "junta": "C", "lado1": "S1", "lado2": "S2", "canto1": "K1", "canto2": "K2" }
    },

    "flangeComCubo": {
      "descricao": "o garfo com o pescoço (o cubo) e a flange (o disco, uma cápsula), simétricos em torno do eixo que vai do topo do garfo ao centro da flange. O desenho de fora prende o topo e a direção do eixo. O ângulo (graus) é a direção do topo para a flange e só serve ao chute.",
      "parametros": {
        "larguraGarfo": null, "alturaGarfo": null, "larguraPescoco": null, "alturaPescoco": null,
        "diametroFlange": null, "espessuraFlange": null,
        "raioDoTopo": 5, "raioDoFundo1": 4, "raioDoFundo2": 10, "angulo": -90
      },
      "pontos": {
        "T": [0, 0],
        "GH": ["=-larguraGarfo/2*cos(angulo+90)", "=-larguraGarfo/2*sin(angulo+90)"],
        "GG": ["=larguraGarfo/2*cos(angulo+90)", "=larguraGarfo/2*sin(angulo+90)"],
        "GA": ["=alturaGarfo*cos(angulo)-larguraGarfo/2*cos(angulo+90)", "=alturaGarfo*sin(angulo)-larguraGarfo/2*sin(angulo+90)"],
        "GF": ["=alturaGarfo*cos(angulo)+larguraGarfo/2*cos(angulo+90)", "=alturaGarfo*sin(angulo)+larguraGarfo/2*sin(angulo+90)"],
        "GB": ["=alturaGarfo*cos(angulo)-larguraPescoco/2*cos(angulo+90)", "=alturaGarfo*sin(angulo)-larguraPescoco/2*sin(angulo+90)"],
        "GE": ["=alturaGarfo*cos(angulo)+larguraPescoco/2*cos(angulo+90)", "=alturaGarfo*sin(angulo)+larguraPescoco/2*sin(angulo+90)"],
        "GC": ["=(alturaGarfo+alturaPescoco)*cos(angulo)-larguraPescoco/2*cos(angulo+90)", "=(alturaGarfo+alturaPescoco)*sin(angulo)-larguraPescoco/2*sin(angulo+90)"],
        "GD": ["=(alturaGarfo+alturaPescoco)*cos(angulo)+larguraPescoco/2*cos(angulo+90)", "=(alturaGarfo+alturaPescoco)*sin(angulo)+larguraPescoco/2*sin(angulo+90)"],
        "N": ["=(alturaGarfo+alturaPescoco)*cos(angulo)", "=(alturaGarfo+alturaPescoco)*sin(angulo)"],
        "M": ["=(alturaGarfo+alturaPescoco+espessuraFlange/2)*cos(angulo)", "=(alturaGarfo+alturaPescoco+espessuraFlange/2)*sin(angulo)"],
        "L1": ["=(alturaGarfo+alturaPescoco+espessuraFlange/2)*cos(angulo)-diametroFlange/2*cos(angulo+90)", "=(alturaGarfo+alturaPescoco+espessuraFlange/2)*sin(angulo)-diametroFlange/2*sin(angulo+90)"],
        "L2": ["=(alturaGarfo+alturaPescoco+espessuraFlange/2)*cos(angulo)+diametroFlange/2*cos(angulo+90)", "=(alturaGarfo+alturaPescoco+espessuraFlange/2)*sin(angulo)+diametroFlange/2*sin(angulo+90)"]
      },
      "construcao": { "eixo": { "reta": ["T", "M"] } },
      "partes": {
        "cubo": {
          "poligono": ["GA", "GB", "GC", "GD", "GE", "GF", "GG", "GH"],
          "raioDoCanto": { "GA": "raioDoFundo1", "GF": "raioDoFundo2", "GG": "raioDoTopo", "GH": "raioDoTopo" }
        },
        "disco": { "barra": ["L1", "L2"], "espessura": "espessuraFlange", "raioDoCanto": "=espessuraFlange/2" }
      },
      "relacoes": [
        { "nome": "topo do garfo atravessa o eixo", "sobre": ["T", ["GH", "GG"]] },
        { "nome": "topo do garfo simétrico", "simetrico": ["GH", "GG", "eixo"] },
        { "nome": "largura do garfo", "distancia": ["GH", "GG"], "mm": "larguraGarfo" },
        { "nome": "lado do garfo paralelo ao eixo", "paralela": [["GH", "GA"], "eixo"] },
        { "nome": "altura do garfo", "distancia": ["GH", "GA"], "mm": "alturaGarfo" },
        { "nome": "fundo do garfo simétrico", "simetrico": ["GA", "GF", "eixo"] },
        { "nome": "pescoço sai do fundo do garfo", "sobre": ["GB", ["GA", "GF"]] },
        { "nome": "pé do pescoço simétrico", "simetrico": ["GB", "GE", "eixo"] },
        { "nome": "largura do pescoço", "distancia": ["GB", "GE"], "mm": "larguraPescoco" },
        { "nome": "lado do pescoço paralelo ao eixo", "paralela": [["GB", "GC"], "eixo"] },
        { "nome": "altura do pescoço", "distancia": ["GB", "GC"], "mm": "alturaPescoco" },
        { "nome": "fundo do pescoço simétrico", "simetrico": ["GC", "GD", "eixo"] },
        { "nome": "fundo do pescoço atravessa o eixo", "sobre": ["N", ["GC", "GD"]] },
        { "nome": "fundo do pescoço no eixo", "sobre": ["N", "eixo"] },
        { "nome": "flange presa sob o pescoço", "distancia": ["N", "M"], "mm": "=espessuraFlange/2" },
        { "nome": "flange atravessa o eixo", "sobre": ["M", ["L1", "L2"]] },
        { "nome": "flange simétrica", "simetrico": ["L1", "L2", "eixo"] },
        { "nome": "diâmetro da flange", "distancia": ["L1", "L2"], "mm": "diametroFlange" }
      ],
      "ligacoes": { "topo": "T", "centroDaFlange": "M", "eixo": "eixo", "cubo": "cubo", "disco": "disco" },
      "frenteParaFundo": ["cubo", "disco"]
    },

    "blocoDeJunta": {
      "descricao": "o retângulo com só os cantos de uma ponta arredondados: a base de canto vivo, assentada no que vem antes, e o topo arredondado. O ângulo (graus) é a direção da base para o topo e só serve ao chute; o desenho de fora prende a base e a direção dela.",
      "parametros": { "largura": null, "altura": null, "raioTopo1": null, "raioTopo2": null, "angulo": 90 },
      "pontos": {
        "B1": [0, 0],
        "B2": ["=largura*cos(angulo-90)", "=largura*sin(angulo-90)"],
        "T2": ["=largura*cos(angulo-90)+altura*cos(angulo)", "=largura*sin(angulo-90)+altura*sin(angulo)"],
        "T1": ["=altura*cos(angulo)", "=altura*sin(angulo)"]
      },
      "partes": {
        "corpo": { "poligono": ["B1", "B2", "T2", "T1"], "raioDoCanto": { "T2": "raioTopo2", "T1": "raioTopo1" } }
      },
      "relacoes": [
        { "nome": "largura", "distancia": ["B1", "B2"], "mm": "largura" },
        { "nome": "lado 2 em esquadro com a base", "perpendicular": [["B1", "B2"], ["B2", "T2"]] },
        { "nome": "altura", "distancia": ["B2", "T2"], "mm": "altura" },
        { "nome": "topo em esquadro com o lado 2", "perpendicular": [["B2", "T2"], ["T2", "T1"]] },
        { "nome": "lado 1 em esquadro com o topo", "perpendicular": [["T2", "T1"], ["T1", "B1"]] }
      ],
      "ligacoes": { "base1": "B1", "base2": "B2", "topo1": "T1", "topo2": "T2", "corpo": "corpo" }
    }
  }
}
