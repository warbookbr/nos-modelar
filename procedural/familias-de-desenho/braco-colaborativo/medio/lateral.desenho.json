     "=raio*sin(angulo+90)"
    ],
    "S2": [
     "=raio*cos(angulo-90)",
     "=raio*sin(angulo-90)"
    ],
    "K1": [
     "=raio*cos(angulo+90)+raio*cos(angulo)",
     "=raio*sin(angulo+90)+raio*sin(angulo)"
    ],
    "K2": [
     "=raio*cos(angulo-90)+raio*cos(angulo)",
     "=raio*sin(angulo-90)+raio*sin(angulo)"
