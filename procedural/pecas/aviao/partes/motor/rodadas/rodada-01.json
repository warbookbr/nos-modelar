          "texto": "  },"
        },
        {
          "tipo": "+",
          "linha": 86,
          "texto": "  /* Fechamento das pontas dos lofts: quanto o polo fica além da última seção, ao longo do caminho. */"
        },
        {
          "tipo": "+",
          "linha": 87,
          "texto": "  tampa: { avanco: 0.5 },"
        },
        {
          "tipo": "+",
          "linha": 88,
          "texto": "  /* Quanto o raio do canto fica abaixo da meia dimensão menor da seção, em mm. Um canto de raio igual à meia altura, como o da boca de"
        },
        {
          "tipo": "+",
          "linha": 89,
          "texto": "     ar e o da entrada de ar, deixa dois pontos do contorno no mesmo lugar, e a faixa entre eles sai com área nula. */"
        },
        {
          "tipo": "+",
          "linha": 90,
          "texto": "  folgaDoRaio: 0.5,"
        },
        {
          "tipo": "+",
          "linha": 91,
          "texto": "};"
        },
        {
          "tipo": "+",
          "linha": 92,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 93,
          "texto": "const m = (mm) => mm / 1000;"
        },
        {
          "tipo": "+",
          "linha": 94,
          "texto": "const soma = (a, b) => a.map((v, k) => v + b[k]);"
        },
        {
          "tipo": "+",
          "linha": 95,
          "texto": "const sub = (a, b) => a.map((v, k) => v - b[k]);"
        },
        {
          "tipo": "+",
          "linha": 96,
          "texto": "const mul = (a, s) => a.map((v) => v * s);"
        },
        {
          "tipo": "+",
          "linha": 97,
          "texto": "const escalar = (a, b) => a.reduce((s, v, k) => s + v * b[k], 0);"
        },
        {
          "tipo": "+",
          "linha": 98,
          "texto": "const unitario = (a) => mul(a, 1 / Math.hypot(...a));"
        },
        {
          "tipo": "+",
          "linha": 99,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 100,
          "texto": "/* O loft em z: o eixo é o 2, o plano da seção é x por y, o +w do núcleo aponta para -y e a `orientacao` fixa o +u em x. */"
        },
        {
          "tipo": "+",
          "linha": 101,
          "texto": "const ORIENTACAO_EM_Z = [1, 0, 0];"
        },
        {
          "tipo": "+",
          "linha": 102,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 103,
          "texto": "/* Área com sinal pelo cadarço, sobre os dois primeiros números de cada ponto; o núcleo só aceita contorno anti-horário. */"
        },
        {
          "tipo": "+",
          "linha": 104,
          "texto": "function areaDoContorno(pontos) {"
        },
        {
          "tipo": "+",
          "linha": 105,
          "texto": "  let area = 0;"
        },
        {
          "tipo": "+",
          "linha": 106,
          "texto": "  for (let i = 0; i < pontos.length; i++) {"
        },
        {
          "tipo": "+",
          "linha": 107,
          "texto": "    const a = pontos[i];"
        },
        {
          "tipo": "+",
          "linha": 108,
          "texto": "    const b = pontos[(i + 1) % pontos.length];"
        },
        {
          "tipo": "+",
          "linha": 109,
          "texto": "    area += a[0] * b[1] - b[0] * a[1];"
        },
        {
          "tipo": "+",
          "linha": 110,
          "texto": "  }"
        },
        {
          "tipo": "+",
          "linha": 111,
          "texto": "  return area / 2;"
        },
        {
          "tipo": "+",
          "linha": 112,
          "texto": "}"
        },
        {
          "tipo": "+",
          "linha": 113,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 114,
          "texto": "/* A cúbica de Hermite por trechos, com a tangente do PCHIP. `nos` são `{ w, v, viva }`: a posição, a lista de valores e se o nó é"
        },
        {
          "tipo": "+",
          "linha": 115,
          "texto": "   aresta. Devolve os nós e, entre cada par deles, as estações pedidas em `trechos` (um número de trechos por vão). Num nó que é"
        },
        {
          "tipo": "+",
          "linha": 116,
          "texto": "   aresta a curva se parte: cada lado termina nele como uma curva termina na ponta, e dois nós vivos seguidos ficam ligados por reta. */"
        },
        {
          "tipo": "+",
          "linha": 117,
          "texto": "function tangenteInterna(h0, h1, d0, d1) {"
        },
        {
          "tipo": "+",
          "linha": 118,
          "texto": "  if (d0 * d1 <= 0) return 0;"
        },
        {
          "tipo": "+",
          "linha": 119,
          "texto": "  const a = 2 * h1 + h0;"
        },
        {
          "tipo": "+",
          "linha": 120,
          "texto": "  const b = h1 + 2 * h0;"
        },
        {
          "tipo": "+",
          "linha": 121,
          "texto": "  return (a + b) / (a / d0 + b / d1);"
        },
        {
          "tipo": "+",
          "linha": 122,
          "texto": "}"
        },
        {
          "tipo": "+",
          "linha": 123,
          "texto": "function tangenteDaPonta(h0, h1, d0, d1) {"
        },
        {
          "tipo": "+",
          "linha": 124,
          "texto": "  let d = ((2 * h0 + h1) * d0 - h0 * d1) / (h0 + h1);"
        },
        {
          "tipo": "+",
          "linha": 125,
          "texto": "  if (Math.sign(d) !== Math.sign(d0)) d = 0;"
        },
        {
          "tipo": "+",
          "linha": 126,
          "texto": "  else if (Math.sign(d0) !== Math.sign(d1) && Math.abs(d) > 3 * Math.abs(d0)) d = 3 * d0;"
        },
        {
          "tipo": "+",
          "linha": 127,
          "texto": "  return d;"
        },
        {
          "tipo": "+",
          "linha": 128,
          "texto": "}"
        },
        {
          "tipo": "+",
          "linha": 129,
          "texto": "function estacoesPorHermite(nos, trechos) {"
        },
        {
          "tipo": "+",
          "linha": 130,
          "texto": "  const n = nos.length;"
        },
        {
          "tipo": "+",
          "linha": 131,
          "texto": "  if (trechos.length !== n - 1) throw new Error(`capo: ${n} estações pedem ${n - 1} números em trechos, e a TABELA traz ${trechos.length}`);"
        },
        {
          "tipo": "+",
          "linha": 132,
          "texto": "  const h = nos.slice(1).map((no, k) => no.w - nos[k].w);"
        },
        {
          "tipo": "+",
          "linha": 133,
          "texto": "  const coordenadas = nos[0].v.map((_, c) => c);"
        },
        {
          "tipo": "+",
          "linha": 134,
          "texto": "  const inclinacao = h.map((hk, k) => nos[k + 1].v.map((y, c) => (y - nos[k].v[c]) / hk));"
        },
        {
          "tipo": "+",
          "linha": 135,
          "texto": "  const liso = (j) => !nos[j].viva && j > 0 && j < n - 1;"
        },
        {
          "tipo": "+",
          "linha": 136,
          "texto": "  const esq = new Array(n);"
        },
        {
          "tipo": "+",
          "linha": 137,
          "texto": "  const dir = new Array(n);"
        },
        {
          "tipo": "+",
          "linha": 138,
          "texto": "  for (let k = 0; k < n; k++) {"
        },
        {
          "tipo": "+",
          "linha": 139,
          "texto": "    const temEsq = k > 0;"
        },
        {
          "tipo": "+",
          "linha": 140,
          "texto": "    const temDir = k < n - 1;"
        },
        {
          "tipo": "+",
          "linha": 141,
          "texto": "    if (temEsq && temDir && !nos[k].viva) {"
        },
        {
          "tipo": "+",
          "linha": 142,
          "texto": "      const t = coordenadas.map((c) => tangenteInterna(h[k - 1], h[k], inclinacao[k - 1][c], inclinacao[k][c]));"
        },
        {
          "tipo": "+",
          "linha": 143,
          "texto": "      esq[k] = t;"
        },
        {
          "tipo": "+",
          "linha": 144,
          "texto": "      dir[k] = t;"
        },
        {
          "tipo": "+",
          "linha": 145,
          "texto": "      continue;"
        },
        {
          "tipo": "+",
          "linha": 146,
          "texto": "    }"
        },
        {
          "tipo": "+",
          "linha": 147,
          "texto": "    if (temEsq) {"
        },
        {
          "tipo": "+",
          "linha": 148,
          "texto": "      esq[k] = k >= 2 && liso(k - 1)"
        },
        {
          "tipo": "+",
          "linha": 149,
          "texto": "        ? coordenadas.map((c) => tangenteDaPonta(h[k - 1], h[k - 2], inclinacao[k - 1][c], inclinacao[k - 2][c]))"
        },
        {
          "tipo": "+",
          "linha": 150,
          "texto": "        : inclinacao[k - 1];"
        },
        {
          "tipo": "+",
          "linha": 151,
          "texto": "    }"
        },
        {
          "tipo": "+",
          "linha": 152,
          "texto": "    if (temDir) {"
        },
        {
          "tipo": "+",
          "linha": 153,
          "texto": "      dir[k] = k + 2 < n && liso(k + 1)"
        },
        {
          "tipo": "+",
          "linha": 154,
          "texto": "        ? coordenadas.map((c) => tangenteDaPonta(h[k], h[k + 1], inclinacao[k][c], inclinacao[k + 1][c]))"
        },
        {
          "tipo": "+",
          "linha": 155,
          "texto": "        : inclinacao[k];"
        },
        {
          "tipo": "+",
          "linha": 156,
          "texto": "    }"
        },
        {
          "tipo": "+",
          "linha": 157,
          "texto": "  }"
        },
        {
          "tipo": "+",
          "linha": 158,
          "texto": "  const saida = [];"
        },
        {
          "tipo": "+",
          "linha": 159,
          "texto": "  for (let k = 0; k < n; k++) {"
        },
        {
          "tipo": "+",
          "linha": 160,
          "texto": "    saida.push({ w: nos[k].w, v: nos[k].v });"
        },
        {
          "tipo": "+",
          "linha": 161,
          "texto": "    if (k === n - 1) continue;"
        },
        {
          "tipo": "+",
          "linha": 162,
          "texto": "    const quantos = trechos[k];"
        },
        {
          "tipo": "+",
          "linha": 163,
          "texto": "    if (!Number.isInteger(quantos) || quantos < 1) throw new Error(`capo: trechos[${k}] precisa ser inteiro maior ou igual a 1`);"
        },
        {
          "tipo": "+",
          "linha": 164,
          "texto": "    for (let j = 1; j < quantos; j++) {"
        },
        {
          "tipo": "+",
          "linha": 165,
          "texto": "      const t = j / quantos;"
        },
        {
          "tipo": "+",
          "linha": 166,
          "texto": "      const [h00, h10, h01, h11] = [2 * t ** 3 - 3 * t ** 2 + 1, t ** 3 - 2 * t ** 2 + t, -2 * t ** 3 + 3 * t ** 2, t ** 3 - t ** 2];"
        },
        {
          "tipo": "+",
          "linha": 167,
          "texto": "      saida.push({"
        },
        {
          "tipo": "+",
          "linha": 168,
          "texto": "        w: nos[k].w + t * h[k],"
        },
        {
          "tipo": "+",
          "linha": 169,
          "texto": "        v: nos[k].v.map((y0, c) => h00 * y0 + h10 * h[k] * dir[k][c] + h01 * nos[k + 1].v[c] + h11 * h[k] * esq[k + 1][c]),"
        },
        {
          "tipo": "+",
          "linha": 170,
          "texto": "      });"
        },
        {
          "tipo": "+",
          "linha": 171,
          "texto": "    }"
        },
        {
          "tipo": "+",
          "linha": 172,
          "texto": "  }"
        },
        {
          "tipo": "+",
          "linha": 173,
          "texto": "  return saida;"
        },
        {
          "tipo": "+",
          "linha": 174,
          "texto": "}"
        },
        {
          "tipo": "+",
          "linha": 175,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 176,
          "texto": "/* O contorno de uma seção de retângulo arredondado no plano do loft em z, [u, w, raio] com u = x e w = -(y - y0). Os quatro cantos"
        },
        {
          "tipo": "+",
          "linha": 177,
          "texto": "   saem do mesmo raio, limitado pela meia dimensão menor, e o contorno que sai no sentido horário é invertido. */"
        },
        {
          "tipo": "+",
          "linha": 178,
          "texto": "function contornoDaSecao({ hw, topo, base, raio }, y0, folga) {"
        },
        {
          "tipo": "+",
          "linha": 179,
          "texto": "  const meio = (topo + base) / 2;"
        },
        {
          "tipo": "+",
          "linha": 180,
          "texto": "  const hy = (topo - base) / 2;"
        },
        {
          "tipo": "+",
          "linha": 181,
          "texto": "  const r = Math.min(raio, hw - folga, hy - folga);"
        },
        {
          "tipo": "+",
          "linha": 182,
          "texto": "  const cantos = [[hw, topo, r], [-hw, topo, r], [-hw, base, r], [hw, base, r]];"
        },
        {
          "tipo": "+",
          "linha": 183,
          "texto": "  const contorno = cantos.map(([x, y, raioDoCanto]) => [x, -(y - y0), raioDoCanto]);"
        },
        {
          "tipo": "+",
          "linha": 184,
          "texto": "  return { meio, contorno: areaDoContorno(contorno) < 0 ? contorno.reverse() : contorno };"
        },
        {
          "tipo": "+",
          "linha": 185,
          "texto": "}"
        },
        {
          "tipo": "+",
          "linha": 186,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 187,
          "texto": "/* Um loft em z por seções de retângulo arredondado, em metro: `secoes` são `{ z, hw, topo, base, raio }`, com a meia largura em torno"
        },
        {
          "tipo": "+",
          "linha": 188,
          "texto": "   de `x`. A reta do caminho passa pelo centro da primeira seção; o centro das outras entra no contorno. Devolve as seções, com um polo de raio zero antes da primeira e"
        },
        {
          "tipo": "+",
          "linha": 189,
          "texto": "   depois da última, os `lados`, a `orientacao` e, para cada polo, a região que o seleciona e o deslocamento que o leva ao centro da"
        },
        {
          "tipo": "+",
          "linha": 190,
          "texto": "   seção de que ele fecha a ponta. */"
        },
        {
          "tipo": "+",
          "linha": 191,
          "texto": "function loftEmZ({ nome, x = 0, secoes, avanco, segmentos, folga }) {"
        },
        {
          "tipo": "+",
          "linha": 192,
          "texto": "  const y0 = (secoes[0].topo + secoes[0].base) / 2;"
        },
        {
          "tipo": "+",
          "linha": 193,
          "texto": "  const feitas = secoes.map((s) => ({ ...contornoDaSecao(s, y0, folga), z: s.z }));"
        },
        {
          "tipo": "+",
          "linha": 194,
          "texto": "  const lados = feitas[0].contorno.length * (segmentos + 1);"
        },
        {
          "tipo": "+",
          "linha": 195,
          "texto": "  const nV = feitas.length * lados + 2;"
        },
        {
          "tipo": "+",
          "linha": 196,
          "texto": "  const nF = (feitas.length + 1) * lados;"
        },
        {
          "tipo": "+",
          "linha": 197,
          "texto": "  if (nV > 1000 || nF > 1000) {"
        },
        {
          "tipo": "+",
          "linha": 198,
          "texto": "    throw new Error(`${nome}: ${feitas.length} seções de ${lados} pontos estouram o bloco de 1000 ids de um passo (${nV} vértices, ${nF} faces)`);"
        },
        {
          "tipo": "+",
          "linha": 199,
          "texto": "  }"
        },
        {
          "tipo": "+",
          "linha": 200,
          "texto": "  const polo = (s, sentido, meio) => {"
        }
      ],
      "cortada": true
    }
  }
