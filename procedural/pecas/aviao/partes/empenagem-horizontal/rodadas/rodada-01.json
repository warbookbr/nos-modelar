        },
        {
          "tipo": "+",
          "linha": 108,
          "texto": "const m = (mm) => mm / 1000;"
        },
        {
          "tipo": "+",
          "linha": 109,
          "texto": "const GRAUS = Math.PI / 180;"
        },
        {
          "tipo": "+",
          "linha": 110,
          "texto": "const mAll = (v) => v.map(m);"
        },
        {
          "tipo": "+",
          "linha": 111,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 112,
          "texto": "let registro = null;"
        },
        {
          "tipo": "+",
          "linha": 113,
          "texto": "const registroDeFamilias = () => { registro ??= criarRegistroDeFamilias(); return registro; };"
        },
        {
          "tipo": "+",
