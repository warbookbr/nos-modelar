          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 115,
          "texto": "/* O ponto da reta que passa por (xa, a) e (xb, b), em x. Serve para interpolar e para prolongar além das duas pontas. */"
        },
        {
          "tipo": "+",
          "linha": 116,
          "texto": "const naReta = (a, xa, b, xb, x) => a.map((p, k) => ["
        },
        {
          "tipo": "+",
          "linha": 117,
          "texto": "  p[0] + ((b[k][0] - p[0]) * (x - xa)) / (xb - xa),"
        },
        {
          "tipo": "+",
          "linha": 118,
          "texto": "  p[1] + ((b[k][1] - p[1]) * (x - xa)) / (xb - xa),"
        },
        {
          "tipo": "+",
          "linha": 119,
          "texto": "]);"
        },
        {
          "tipo": "+",
          "linha": 120,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 121,
          "texto": "/* O contorno de sete pontos do profundor em uma seção, [z, y] em mm, anti-horário em (z, y): o topo do nariz, o arco, a ponta do"
        },
        {
          "tipo": "+",
          "linha": 122,
          "texto": "   nariz, o arco de baixo, a base do nariz e as duas pontas do bordo de fuga. */"
        },
        {
          "tipo": "+",
          "linha": 123,
          "texto": "function contornoDoProfundor(t, s) {"
        },
        {
          "tipo": "+",
          "linha": 124,
          "texto": "  const [n1, n2] = t.profundor.nariz;"
        },
        {
          "tipo": "+",
          "linha": 125,
          "texto": "  const b = t.profundor.meiaEspessuraDoBordoDeFuga;"
        },
        {
          "tipo": "+",
          "linha": 126,
          "texto": "  return ["
        },
        {
          "tipo": "+",
          "linha": 127,
          "texto": "    [s.dobradica + 0.5 * s.T, s.yc + 0.5 * s.T],"
        },
        {
          "tipo": "+",
          "linha": 128,
          "texto": "    [s.dobradica + n1 * s.T, s.yc + n2 * s.T],"
        },
        {
          "tipo": "+",
          "linha": 129,
          "texto": "    [s.dobradica, s.yc],"
        },
        {
          "tipo": "+",
          "linha": 130,
          "texto": "    [s.dobradica + n1 * s.T, s.yc - n2 * s.T],"
        },
        {
          "tipo": "+",
          "linha": 131,
          "texto": "    [s.dobradica + 0.5 * s.T, s.yc - 0.5 * s.T],"
        },
        {
          "tipo": "+",
          "linha": 132,
          "texto": "    [s.dobradica + s.L, s.yc - b],"
        },
        {
          "tipo": "+",
          "linha": 133,
          "texto": "    [s.dobradica + s.L, s.yc + b],"
        },
        {
          "tipo": "+",
          "linha": 134,
          "texto": "  ];"
        },
        {
          "tipo": "+",
          "linha": 135,
          "texto": "}"
        },
        {
          "tipo": "+",
          "linha": 136,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 137,
          "texto": "/* O contorno deslocado `d` para fora, com a quina em esquadria: cada vértice anda `d` pela soma das normais das duas arestas, dividida"
        },
        {
          "tipo": "+",
          "linha": 138,
          "texto": "   por um mais o produto escalar delas. O contorno é anti-horário em (z, y), e a normal de fora de uma aresta (ex, ey) é (ey, -ex). */"
        },
        {
          "tipo": "+",
          "linha": 139,
          "texto": "function deslocarContorno(pontos, d) {"
        },
        {
          "tipo": "+",
          "linha": 140,
          "texto": "  const n = pontos.length;"
        },
        {
          "tipo": "+",
          "linha": 141,
          "texto": "  const normal = (a, b) => {"
        },
        {
          "tipo": "+",
          "linha": 142,
          "texto": "    const ex = b[0] - a[0]; const ey = b[1] - a[1]; const l = Math.hypot(ex, ey);"
        },
        {
          "tipo": "+",
          "linha": 143,
          "texto": "    return [ey / l, -ex / l];"
        },
        {
          "tipo": "+",
          "linha": 144,
          "texto": "  };"
        },
        {
          "tipo": "+",
          "linha": 145,
          "texto": "  return pontos.map((p, i) => {"
        },
        {
          "tipo": "+",
          "linha": 146,
          "texto": "    const antes = normal(pontos[(i + n - 1) % n], p);"
        },
        {
          "tipo": "+",
          "linha": 147,
          "texto": "    const depois = normal(p, pontos[(i + 1) % n]);"
        },
        {
          "tipo": "+",
          "linha": 148,
          "texto": "    const k = d / (1 + antes[0] * depois[0] + antes[1] * depois[1]);"
        },
        {
          "tipo": "+",
          "linha": 149,
          "texto": "    return [p[0] + k * (antes[0] + depois[0]), p[1] + k * (antes[1] + depois[1])];"
        },
        {
          "tipo": "+",
          "linha": 150,
          "texto": "  });"
        },
        {
          "tipo": "+",
          "linha": 151,
          "texto": "}"
        },
        {
          "tipo": "+",
          "linha": 152,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 153,
          "texto": "/* O retângulo de cantos arredondados centrado em (cx, cy), anti-horário em (x, y), com `segmentos` segmentos por canto: os pontos de"
        },
        {
          "tipo": "+",
          "linha": 154,
          "texto": "   cada canto a partir do de baixo à direita, de -90 a 0 graus e assim por diante. */"
        },
        {
          "tipo": "+",
          "linha": 155,
          "texto": "function retanguloArredondado([largura, altura], raio, segmentos, [cx, cy]) {"
        },
        {
          "tipo": "+",
          "linha": 156,
          "texto": "  const r = Math.min(raio, largura / 2, altura / 2);"
        },
        {
          "tipo": "+",
          "linha": 157,
          "texto": "  const cantos = ["
        },
        {
          "tipo": "+",
          "linha": 158,
          "texto": "    [largura / 2 - r, -altura / 2 + r, -90], [largura / 2 - r, altura / 2 - r, 0],"
        },
        {
          "tipo": "+",
          "linha": 159,
          "texto": "    [-largura / 2 + r, altura / 2 - r, 90], [-largura / 2 + r, -altura / 2 + r, 180],"
        },
        {
          "tipo": "+",
          "linha": 160,
          "texto": "  ];"
        },
        {
          "tipo": "+",
          "linha": 161,
          "texto": "  return cantos.flatMap(([ox, oy, a0]) => Array.from({ length: segmentos + 1 }, (_, i) => {"
        },
        {
          "tipo": "+",
          "linha": 162,
          "texto": "    const a = (a0 + (90 * i) / segmentos) * GRAUS;"
        },
        {
          "tipo": "+",
          "linha": 163,
          "texto": "    return [cx + ox + r * Math.cos(a), cy + oy + r * Math.sin(a)];"
        },
        {
          "tipo": "+",
          "linha": 164,
          "texto": "  }));"
        },
        {
          "tipo": "+",
          "linha": 165,
          "texto": "}"
        },
        {
          "tipo": "+",
          "linha": 166,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 167,
          "texto": "/* A cúbica de Hermite por trechos com a tangente de Fritsch e Carlson (a do PCHIP), a mesma que o esboço passa pelas seções de um loft"
        },
        {
          "tipo": "+",
          "linha": 168,
          "texto": "   `suave`: passa por todos os valores, tem tangente contínua neles e não passa do valor de nenhuma seção entre duas vizinhas. Devolve"
        },
        {
          "tipo": "+",
          "linha": 169,
          "texto": "   as posições e os valores nas seções e nas estações entre elas, `trechos[k]` trechos no vão k. */"
        },
        {
          "tipo": "+",
          "linha": 170,
          "texto": "function curvaSuave(posicoes, valores, trechos) {"
        },
        {
          "tipo": "+",
          "linha": 171,
          "texto": "  const n = posicoes.length;"
        },
        {
          "tipo": "+",
          "linha": 172,
          "texto": "  if (trechos.length !== n - 1) throw new Error(`suporte: ${n} seções pedem ${n - 1} números em trechos, e a TABELA traz ${trechos.length}`);"
        },
        {
          "tipo": "+",
          "linha": 173,
          "texto": "  const h = posicoes.slice(1).map((p, k) => p - posicoes[k]);"
        },
        {
          "tipo": "+",
          "linha": 174,
          "texto": "  const d = valores.slice(1).map((v, k) => (v - valores[k]) / h[k]);"
        },
        {
          "tipo": "+",
          "linha": 175,
          "texto": "  const interna = (h0, h1, d0, d1) => {"
        },
        {
          "tipo": "+",
          "linha": 176,
          "texto": "    if (d0 * d1 <= 0) return 0;"
        },
        {
          "tipo": "+",
          "linha": 177,
          "texto": "    const a = 2 * h1 + h0;"
        },
        {
          "tipo": "+",
          "linha": 178,
          "texto": "    const b = h1 + 2 * h0;"
        },
        {
          "tipo": "+",
          "linha": 179,
          "texto": "    return (a + b) / (a / d0 + b / d1);"
        },
        {
          "tipo": "+",
          "linha": 180,
          "texto": "  };"
        },
        {
          "tipo": "+",
          "linha": 181,
          "texto": "  const daPonta = (h0, h1, d0, d1) => {"
        },
        {
          "tipo": "+",
          "linha": 182,
          "texto": "    const t = ((2 * h0 + h1) * d0 - h0 * d1) / (h0 + h1);"
        },
        {
          "tipo": "+",
          "linha": 183,
          "texto": "    if (Math.sign(t) !== Math.sign(d0)) return 0;"
        },
        {
          "tipo": "+",
          "linha": 184,
          "texto": "    if (Math.sign(d0) !== Math.sign(d1) && Math.abs(t) > 3 * Math.abs(d0)) return 3 * d0;"
        },
        {
          "tipo": "+",
          "linha": 185,
          "texto": "    return t;"
        },
        {
          "tipo": "+",
          "linha": 186,
          "texto": "  };"
        },
        {
          "tipo": "+",
          "linha": 187,
          "texto": "  const tangente = valores.map((_, k) => {"
        },
        {
          "tipo": "+",
          "linha": 188,
          "texto": "    if (k === 0) return daPonta(h[0], h[1], d[0], d[1]);"
        },
        {
          "tipo": "+",
          "linha": 189,
          "texto": "    if (k === n - 1) return daPonta(h[n - 2], h[n - 3], d[n - 2], d[n - 3]);"
        },
        {
          "tipo": "+",
          "linha": 190,
          "texto": "    return interna(h[k - 1], h[k], d[k - 1], d[k]);"
        },
        {
          "tipo": "+",
          "linha": 191,
          "texto": "  });"
        },
        {
          "tipo": "+",
          "linha": 192,
          "texto": "  const saida = { posicoes: [], valores: [] };"
        },
        {
          "tipo": "+",
          "linha": 193,
          "texto": "  for (let k = 0; k < n - 1; k++) {"
        },
        {
          "tipo": "+",
          "linha": 194,
          "texto": "    const quantos = trechos[k];"
        },
        {
          "tipo": "+",
          "linha": 195,
          "texto": "    if (!Number.isInteger(quantos) || quantos < 1) throw new Error(`suporte: trechos[${k}] precisa ser inteiro maior ou igual a 1`);"
        },
        {
          "tipo": "+",
          "linha": 196,
          "texto": "    for (let j = 0; j < quantos; j++) {"
        },
        {
          "tipo": "+",
          "linha": 197,
          "texto": "      const t = j / quantos;"
        },
        {
          "tipo": "+",
          "linha": 198,
          "texto": "      const [h00, h10, h01, h11] = [2 * t ** 3 - 3 * t ** 2 + 1, t ** 3 - 2 * t ** 2 + t, -2 * t ** 3 + 3 * t ** 2, t ** 3 - t ** 2];"
        },
        {
          "tipo": "+",
          "linha": 199,
          "texto": "      saida.posicoes.push(posicoes[k] + t * h[k]);"
        },
        {
          "tipo": "+",
          "linha": 200,
          "texto": "      saida.valores.push(h00 * valores[k] + h10 * h[k] * tangente[k] + h01 * valores[k + 1] + h11 * h[k] * tangente[k + 1]);"
        }
      ],
      "cortada": true
    }
  }
}
