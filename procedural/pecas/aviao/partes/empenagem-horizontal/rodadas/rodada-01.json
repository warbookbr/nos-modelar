          "texto": " */"
        },
        {
          "tipo": "+",
          "linha": 35,
          "texto": "import { chamar, criarRegistroDeFamilias } from '../../../../../familias/index.js';"
        },
        {
          "tipo": "+",
          "linha": 36,
          "texto": "import { expandirChamadasDeComposicao } from '../../../../../nucleo/composicoes.js';"
        },
        {
          "tipo": "+",
          "linha": 37,
          "texto": "import { nucleo } from '../../../../../nucleo/entrada.js';"
        },
        {
          "tipo": "+",
          "linha": 38,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 39,
          "texto": "const ESBOCO = '../../../../../docs/mecanifica/banco-de-provas/aviao-2026-10-11/esboco-r2/aviao.esboco.json';"
        },
        {
          "tipo": "+",
          "linha": 40,
          "texto": "const LADOS = [['D', 'd', 'direito'], ['E', 'e', 'esquerdo']];"
        },
        {
          "tipo": "+",
          "linha": 41,
          "texto": "const porLado = (fazer) => LADOS.flatMap(([L, l, nome]) => fazer(L, l, nome));"
