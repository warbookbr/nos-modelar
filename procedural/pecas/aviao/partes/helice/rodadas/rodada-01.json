          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 65,
          "texto": "let registro = null;"
        },
        {
          "tipo": "+",
          "linha": 66,
          "texto": "const registroDeFamilias = () => { registro ??= criarRegistroDeFamilias(); return registro; };"
