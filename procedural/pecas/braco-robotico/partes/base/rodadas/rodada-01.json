          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 47,
          "texto": "const m = (mm) => mm / 1000;"
        },
        {
          "tipo": "+",
          "linha": 48,
          "texto": "const ID = { corpo: 100, pe: 200, caixa: 300, botao: 400 };"
        },
        {
          "tipo": "+",
          "linha": 49,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 50,
          "texto": "/* Retângulo de cantos arredondados em [u,w], encolhido `recuo` de cada lado. */"
        },
        {
          "tipo": "+",
          "linha": 51,
          "texto": "function retangulo(meioU, meioW, canto, recuo) {"
        },
        {
          "tipo": "+",
          "linha": 52,
          "texto": "  const u = meioU - recuo, w = meioW - recuo, c = Math.max(canto - recuo, 0.0005);"
        },
        {
          "tipo": "+",
          "linha": 53,
          "texto": "  return [[u, w, c], [-u, w, c], [-u, -w, c], [u, -w, c]];"
        },
        {
          "tipo": "+",
          "linha": 54,
          "texto": "}"
        },
        {
          "tipo": "+",
          "linha": 55,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 56,
          "texto": "/* Placa de bordas arredondadas: loft vertical de seções retangulares, com a"
        },
        {
          "tipo": "+",
          "linha": 57,
          "texto": "   quina de cima e de baixo aproximada por seções recuadas num quarto de arco. */"
        },
        {
          "tipo": "+",
          "linha": 58,
          "texto": "function placa(origemId, centroX, centroZ, y0, y1, meioU, meioW, canto, filete) {"
        },
        {
          "tipo": "+",
          "linha": 59,
          "texto": "  const secoes = [{ pos: [centroX, y0, centroZ], raio: 0 }];"
        },
        {
          "tipo": "+",
          "linha": 60,
          "texto": "  /* O ponto do arco no próprio fundo fica de fora: a seção coincidiria com o polo, e o loft"
        },
        {
          "tipo": "+",
          "linha": 61,
          "texto": "     recusa segmento de comprimento zero. A tampa vira leque quase plano. */"
        },
        {
          "tipo": "+",
          "linha": 62,
          "texto": "  const arco = [0.3827, 0.7071, 0.9239, 1];"
        },
        {
          "tipo": "+",
          "linha": 63,
          "texto": "  for (const k of arco) {"
        },
        {
          "tipo": "+",
          "linha": 64,
          "texto": "    const a = Math.acos(k);"
        },
        {
          "tipo": "+",
          "linha": 65,
          "texto": "    secoes.push({ pos: [centroX, y0 + filete * (1 - Math.sin(a)), centroZ], contorno: retangulo(meioU, meioW, canto, filete * (1 - Math.cos(a))) });"
        },
        {
          "tipo": "+",
          "linha": 66,
          "texto": "  }"
        },
        {
          "tipo": "+",
          "linha": 67,
          "texto": "  for (const k of [...arco].reverse()) {"
        },
        {
          "tipo": "+",
          "linha": 68,
          "texto": "    const a = Math.acos(k);"
        },
        {
          "tipo": "+",
          "linha": 69,
          "texto": "    secoes.push({ pos: [centroX, y1 - filete * (1 - Math.sin(a)), centroZ], contorno: retangulo(meioU, meioW, canto, filete * (1 - Math.cos(a))) });"
        },
        {
          "tipo": "+",
          "linha": 70,
          "texto": "  }"
        },
        {
          "tipo": "+",
          "linha": 71,
          "texto": "  secoes.push({ pos: [centroX, y1, centroZ], raio: 0 });"
        },
        {
          "tipo": "+",
          "linha": 72,
          "texto": "  return ['loft', { origemId, secoes, lados: 4 * 9, segmentosCurva: 8, orientacao: [1, 0, 0] }];"
        },
        {
          "tipo": "+",
          "linha": 73,
          "texto": "}"
        },
        {
          "tipo": "+",
          "linha": 74,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 75,
          "texto": "export function derivar(t = TABELA) {"
        },
        {
          "tipo": "+",
          "linha": 76,
          "texto": "  const R = m(t.raioDoCorpo);"
        },
        {
          "tipo": "+",
          "linha": 77,
          "texto": "  const yPe = m(t.alturaDoPe);"
        },
        {
          "tipo": "+",
          "linha": 78,
          "texto": "  const yTopo = yPe + m(t.alturaDoCorpo);"
        },
        {
          "tipo": "+",
          "linha": 79,
          "texto": "  const xFora = -(R + m(t.saidaDaCaixa));"
        },
        {
          "tipo": "+",
          "linha": 80,
          "texto": "  const xDentro = -(R - m(t.entradaDaCaixa));"
        },
        {
          "tipo": "+",
          "linha": 81,
          "texto": "  return {"
        },
        {
          "tipo": "+",
          "linha": 82,
          "texto": "    R, yPe, yTopo,"
        },
        {
          "tipo": "+",
          "linha": 83,
          "texto": "    meioPe: m(t.ladoDoPe) / 2,"
        },
        {
          "tipo": "+",
          "linha": 84,
          "texto": "    caixa: {"
        },
        {
          "tipo": "+",
          "linha": 85,
          "texto": "      centroX: (xFora + xDentro) / 2,"
        },
        {
          "tipo": "+",
          "linha": 86,
          "texto": "      meioU: (xDentro - xFora) / 2,"
        },
        {
          "tipo": "+",
          "linha": 87,
          "texto": "      meioW: m(t.larguraDaCaixa) / 2,"
        },
        {
          "tipo": "+",
          "linha": 88,
          "texto": "      y0: yPe - m(t.afundoDaCaixa),"
        },
        {
          "tipo": "+",
          "linha": 89,
          "texto": "      y1: yTopo - m(t.caixaAbaixoDoTopo),"
        },
        {
          "tipo": "+",
          "linha": 90,
          "texto": "      xFora,"
        },
        {
          "tipo": "+",
          "linha": 91,
          "texto": "    },"
        },
        {
          "tipo": "+",
          "linha": 92,
          "texto": "    botao: { x: xFora, y: yPe + m(t.alturaDoBotao) },"
        },
        {
          "tipo": "+",
          "linha": 93,
          "texto": "  };"
        },
        {
          "tipo": "+",
          "linha": 94,
          "texto": "}"
        },
        {
          "tipo": "+",
          "linha": 95,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 96,
          "texto": "export function gerarPassos(t = TABELA) {"
        },
        {
          "tipo": "+",
          "linha": 97,
          "texto": "  const P = derivar(t);"
        },
        {
          "tipo": "+",
          "linha": 98,
          "texto": "  const passos = [];"
        },
        {
          "tipo": "+",
          "linha": 99,
          "texto": "  passos.push(['lathe', {"
        },
        {
          "tipo": "+",
          "linha": 100,
          "texto": "    origemId: ID.corpo, lados: t.ladosDoCorpo, segmentosCurva: 8,"
        },
        {
          "tipo": "+",
          "linha": 101,
          "texto": "    perfil: [[0, P.yPe], [P.R, P.yPe], [P.R, P.yTopo, m(t.fileteDoTopo)], [0, P.yTopo]],"
        },
        {
          "tipo": "+",
          "linha": 102,
          "texto": "  }]);"
        },
        {
          "tipo": "+",
          "linha": 103,
          "texto": "  passos.push(['parte', { nome: 'corpo', sel: { origem: { op: 'lathe', id: ID.corpo } } }]);"
        },
        {
          "tipo": "+",
          "linha": 104,
          "texto": "  passos.push(placa(ID.pe, 0, 0, 0, P.yPe, P.meioPe, P.meioPe, m(t.cantoDoPe), m(t.fileteDoPe)));"
        },
        {
          "tipo": "+",
          "linha": 105,
          "texto": "  passos.push(['parte', { nome: 'pe', sel: { origem: { op: 'loft', id: ID.pe } } }]);"
        },
        {
          "tipo": "+",
          "linha": 106,
          "texto": "  const C = P.caixa;"
        },
        {
          "tipo": "+",
          "linha": 107,
          "texto": "  passos.push(placa(ID.caixa, C.centroX, 0, C.y0, C.y1, C.meioU, C.meioW, m(t.cantoDaCaixa), m(t.fileteDaCaixa)));"
        },
        {
          "tipo": "+",
          "linha": 108,
          "texto": "  passos.push(['lathe', {"
        },
        {
          "tipo": "+",
          "linha": 109,
          "texto": "    origemId: ID.botao, eixo: 'x', lados: 24, segmentosCurva: 4,"
        },
        {
          "tipo": "+",
          "linha": 110,
          "texto": "    perfil: [[0, -m(t.saidaDoBotao)], [m(t.raioDoBotao), -m(t.saidaDoBotao), m(2)], [m(t.raioDoBotao), m(1)], [0, m(1)]],"
        },
        {
          "tipo": "+",
          "linha": 111,
          "texto": "    em: [P.botao.x, P.botao.y, 0],"
        },
        {
          "tipo": "+",
          "linha": 112,
          "texto": "  }]);"
        },
        {
          "tipo": "+",
          "linha": 113,
          "texto": "  passos.push(['parte', { nome: 'caixaLateral', sel: { origem: { op: 'loft', id: ID.caixa } } }]);"
        },
        {
          "tipo": "+",
          "linha": 114,
          "texto": "  passos.push(['parte', { nome: 'caixaLateral', sel: { origem: { op: 'lathe', id: ID.botao } } }]);"
        },
        {
          "tipo": "+",
          "linha": 115,
          "texto": "  passos.push(['publicarPorta', {"
        },
        {
