        },
        {
          "tipo": "+",
          "linha": 124,
          "texto": "}"
        },
        {
          "tipo": "+",
          "linha": 125,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 126,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 127,
          "texto": "const receita = {"
        },
        {
