          "linha": 72,
          "texto": "  passos.push(['liso', { sel: { origem: { op: 'lathe', id: ID.anel } } }]);"
        },
        {
          "tipo": "+",
          "linha": 73,
          "texto": "  return passos;"
        },
        {
          "tipo": "+",
          "linha": 74,
          "texto": "}"
        },
