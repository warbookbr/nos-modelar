        {
          "tipo": "+",
          "linha": 31,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 32,
          "texto": "export const MATERIAIS = { anelEscuro: { cor: '#4a4d52', aspereza: 0.45 } };"
