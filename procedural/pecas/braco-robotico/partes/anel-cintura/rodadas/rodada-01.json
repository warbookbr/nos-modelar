        {
          "tipo": "+",
          "linha": 23,
          "texto": "  altura: 40,"
        },
        {
          "tipo": "+",
          "linha": 24,
          "texto": "  /* Acabamento, escolhido pelo modelador. */"
        },
        {
          "tipo": "+",
          "linha": 25,
          "texto": "  chanfro: 2,"
        },
        {
          "tipo": "+",
          "linha": 26,
          "texto": "  suaveDoChanfro: 0.8,"
        },
        {
          "tipo": "+",
          "linha": 27,
          "texto": "  larguraDaRanhura: 3,"
