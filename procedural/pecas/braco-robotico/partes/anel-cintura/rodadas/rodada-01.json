          "tipo": "+",
          "linha": 53,
          "texto": "     separando as duas faixas. */"
        },
        {
          "tipo": "+",
          "linha": 54,
          "texto": "  passos.push(['lathe', {"
        },
        {
          "tipo": "+",
          "linha": 55,
          "texto": "    origemId: ID.anel, lados: t.lados, segmentosCurva: 3,"
        },
        {
          "tipo": "+",
          "linha": 56,
          "texto": "    perfil: ["
        },
        {
          "tipo": "+",
          "linha": 57,
          "texto": "      [0, 0], [R - c, 0, s], [R, c, s],"
        },
        {
          "tipo": "+",
          "linha": 58,
          "texto": "      [R, meio - w], [rRanhura, meio - w], [rRanhura, meio + w], [R, meio + w],"
        },
        {
          "tipo": "+",
          "linha": 59,
          "texto": "      [R, h - c, s], [R - c, h, s], [0, h],"
        },
        {
          "tipo": "+",
          "linha": 60,
          "texto": "    ],"
        },
        {
          "tipo": "+",
          "linha": 61,
          "texto": "  }]);"
        },
        {
          "tipo": "+",
          "linha": 62,
          "texto": "  passos.push(['parte', { nome: 'anel', sel: { origem: { op: 'lathe', id: ID.anel } } }]);"
        },
        {
          "tipo": "+",
          "linha": 63,
          "texto": "  passos.push(['publicarPorta', {"
        },
        {
          "tipo": "+",
          "linha": 64,
          "texto": "    nome: 'apoio', de: { op: 'lathe', id: ID.anel },"
        },
        {
          "tipo": "+",
          "linha": 65,
          "texto": "    interface: { forma: 'anel', papel: 'ocupa', eixo: [0, 1, 0], centro: [0, 0, 0], raioInterno: R - 0.010, raioExterno: R, inicio: 0, fim: 0.005 },"
        },
        {
          "tipo": "+",
          "linha": 66,
          "texto": "  }]);"
        },
        {
          "tipo": "+",
          "linha": 67,
          "texto": "  passos.push(['publicarPorta', {"
        },
        {
          "tipo": "+",
          "linha": 68,
          "texto": "    nome: 'topo', de: { op: 'lathe', id: ID.anel },"
        },
        {
          "tipo": "+",
          "linha": 69,
          "texto": "    interface: { forma: 'anel', papel: 'recebe', eixo: [0, 1, 0], centro: [0, h, 0], raioInterno: 0, raioExterno: R, inicio: -0.005, fim: 0 },"
        },
        {
          "tipo": "+",
          "linha": 70,
          "texto": "  }]);"
        },
        {
          "tipo": "+",
          "linha": 71,
          "texto": "  passos.push(['material', { usa: 'anelEscuro', sel: { origem: { op: 'lathe', id: ID.anel } } }]);"
