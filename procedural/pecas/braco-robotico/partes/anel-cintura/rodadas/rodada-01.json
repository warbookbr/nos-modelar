        {
          "tipo": "+",
          "linha": 33,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 34,
          "texto": "const m = (mm) => mm / 1000;"
        },
        {
          "tipo": "+",
          "linha": 35,
          "texto": "const ID = { anel: 100 };"
        },
        {
          "tipo": "+",
          "linha": 36,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 37,
          "texto": "export function derivar(t = TABELA) {"
        },
        {
          "tipo": "+",
          "linha": 38,
          "texto": "  const R = m(t.raio);"
        },
        {
          "tipo": "+",
          "linha": 39,
          "texto": "  const h = m(t.altura);"
        },
        {
          "tipo": "+",
          "linha": 40,
          "texto": "  const c = m(t.chanfro);"
        },
        {
          "tipo": "+",
          "linha": 41,
          "texto": "  const s = m(t.suaveDoChanfro);"
        },
        {
          "tipo": "+",
          "linha": 42,
          "texto": "  const meio = h / 2;"
        },
        {
          "tipo": "+",
          "linha": 43,
          "texto": "  const w = m(t.larguraDaRanhura) / 2;"
        },
        {
          "tipo": "+",
          "linha": 44,
          "texto": "  return { R, h, c, s, meio, w, rRanhura: R - m(t.fundoDaRanhura) };"
        },
        {
          "tipo": "+",
          "linha": 45,
          "texto": "}"
        },
        {
          "tipo": "+",
          "linha": 46,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 47,
          "texto": "export function gerarPassos(t = TABELA) {"
        },
        {
          "tipo": "+",
          "linha": 48,
          "texto": "  const P = derivar(t);"
        },
        {
          "tipo": "+",
          "linha": 49,
          "texto": "  const { R, h, c, s, meio, w, rRanhura } = P;"
        },
        {
          "tipo": "+",
          "linha": 50,
          "texto": "  const passos = [];"
        },
        {
          "tipo": "+",
          "linha": 51,
          "texto": "  /* Perfil: chanfro estreito embaixo e em cima, com as duas bordas do chanfro"
