        {
          "tipo": "+",
          "linha": 70,
          "texto": "export function gerarPassos(t = TABELA) {"
        },
        {
          "tipo": "+",
          "linha": 71,
          "texto": "  const P = derivar(t);"
        },
        {
          "tipo": "+",
          "linha": 72,
          "texto": "  const { R, a, Rc, Rt, e, zFace, zCostas, c, f, yBoca, zFim, yEixo } = P;"
        },
        {
          "tipo": "+",
          "linha": 73,
          "texto": "  const passos = [];"
        },
        {
          "tipo": "+",
          "linha": 74,
          "texto": "  const secoes = ["
        },
        {
          "tipo": "+",
          "linha": 75,
          "texto": "    { pos: [0, 0, 0], raio: 0 },"
        },
        {
          "tipo": "+",
          "linha": 76,
          "texto": "    { pos: [0, 0.0004, 0], raio: R - c },"
        },
        {
          "tipo": "+",
          "linha": 77,
          "texto": "    { pos: [0, c, 0], raio: R },"
        },
        {
          "tipo": "+",
          "linha": 78,
          "texto": "    { pos: [0, a, 0], raio: R },"
        },
        {
          "tipo": "+",
          "linha": 79,
          "texto": "  ];"
        },
        {
          "tipo": "+",
          "linha": 80,
          "texto": "  const n = t.estacoesDaCurva;"
        },
        {
          "tipo": "+",
          "linha": 81,
          "texto": "  for (let i = 1; i <= n; i++) {"
        },
        {
          "tipo": "+",
          "linha": 82,
          "texto": "    const th = (Math.PI / 2) * (i / n);"
        },
        {
          "tipo": "+",
          "linha": 83,
          "texto": "    secoes.push({ pos: [0, a + Rc * Math.sin(th), Rc - Rc * Math.cos(th)], raio: R });"
        },
        {
          "tipo": "+",
          "linha": 84,
          "texto": "  }"
        },
        {
          "tipo": "+",
          "linha": 85,
          "texto": "  secoes.push({ pos: [0, yBoca, zFim], raio: R });"
        },
        {
          "tipo": "+",
          "linha": 86,
          "texto": "  secoes.push({ pos: [0, yBoca, zFim + 0.0004], raio: 0 });"
        },
        {
          "tipo": "+",
          "linha": 87,
          "texto": "  passos.push(['loft', { origemId: ID.pescoco, secoes, lados: t.lados, orientacao: [1, 0, 0] }]);"
        },
        {
          "tipo": "+",
          "linha": 88,
          "texto": "  passos.push(['parte', { nome: 'pescoco', sel: { origem: { op: 'loft', id: ID.pescoco } } }]);"
        },
        {
          "tipo": "+",
          "linha": 89,
