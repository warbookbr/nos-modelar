        },
        {
          "tipo": "+",
          "linha": 52,
          "texto": "export function derivar(t = TABELA) {"
        },
        {
          "tipo": "+",
          "linha": 53,
          "texto": "  const R = m(t.raioDoPescoco);"
        },
        {
          "tipo": "+",
          "linha": 54,
          "texto": "  const a = m(t.alturaReta);"
        },
        {
          "tipo": "+",
          "linha": 55,
          "texto": "  const Rc = m(t.raioDaCurva);"
        },
        {
          "tipo": "+",
          "linha": 56,
          "texto": "  const yEixo = m(t.alturaDoEixo);"
        },
        {
          "tipo": "+",
          "linha": 57,
          "texto": "  const Rt = m(t.raioDoTambor);"
        },
        {
          "tipo": "+",
          "linha": 58,
          "texto": "  const e = m(t.espessuraDoTambor);"
        },
        {
          "tipo": "+",
          "linha": 59,
          "texto": "  const zFace = m(t.avancoDaFace);"
        },
        {
          "tipo": "+",
          "linha": 60,
          "texto": "  const zCostas = zFace - e;"
        },
        {
          "tipo": "+",
          "linha": 61,
          "texto": "  const c = m(t.chanfroDoPescoco);"
        },
        {
          "tipo": "+",
          "linha": 62,
          "texto": "  const f = m(t.fileteDoTambor);"
        },
        {
          "tipo": "+",
          "linha": 63,
          "texto": "  /* Centro da curva: o trecho reto sobe até a, a curva gira 90 graus em torno"
        },
        {
          "tipo": "+",
          "linha": 64,
          "texto": "     de um eixo X em (y = a, z = Rc); a boca de cima fica em y = a + Rc. */"
        },
        {
          "tipo": "+",
          "linha": 65,
          "texto": "  const yBoca = a + Rc;"
        },
        {
          "tipo": "+",
          "linha": 66,
          "texto": "  const zFim = Rc + m(t.entradaNoTambor);"
        },
        {
          "tipo": "+",
          "linha": 67,
          "texto": "  return { R, a, Rc, yEixo, Rt, e, zFace, zCostas, c, f, yBoca, zFim };"
