          "tipo": "+",
          "linha": 39,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 40,
          "texto": "export function gerarPassos(t = TABELA) {"
        },
        {
          "tipo": "+",
          "linha": 41,
          "texto": "  const formas = derivar(t);"
        },
        {
          "tipo": "+",
          "linha": 42,
          "texto": "  const { passos } = passosDasFormas(formas);"
        },
        {
          "tipo": "+",
          "linha": 43,
          "texto": "  passos.push(porta('apoio', origemDa(formas, 'garra'), { forma: 'plano', papel: 'apoia', ponto: [t.ponta, t.alturaDoEixo, 0], normal: [-1, 0, 0], extensao: [40, 40] }));"
