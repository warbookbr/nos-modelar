          "tipo": "+",
          "linha": 31,
          "texto": "      caixa: [t.ponta, t.ponta + t.comprimento, t.alturaDoEixo - t.altura / 2, t.alturaDoEixo + t.altura / 2, -t.largura / 2, t.largura / 2],"
        },
        {
          "tipo": "+",
          "linha": 32,
          "texto": "      furos: [-1, 1].flatMap((sy) => [-1, 1].map((sz) => ({"
        },
        {
          "tipo": "+",
          "linha": 33,
          "texto": "        eixo: 'x', base: [t.ponta - 1, t.alturaDoEixo + (sy * t.passoDosFurosM3) / 2, (sz * t.passoDosFurosM3) / 2], comprimento: t.fundoDoFuroM3 + 1, raio: t.raioDoFuroM3, lados: 12,"
        },
        {
          "tipo": "+",
          "linha": 34,
          "texto": "      }))) },"
        },
        {
          "tipo": "+",
          "linha": 35,
          "texto": "  ];"
