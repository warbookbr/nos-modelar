          "tipo": "+",
          "linha": 18,
          "texto": "  largura: 40,"
        },
        {
          "tipo": "+",
          "linha": 19,
          "texto": "  chanfro: 4,"
        },
        {
          "tipo": "+",
          "linha": 20,
          "texto": "  /* Os quatro M3 da placa da ponta do segundo elo, cegos de 10 mm, no quadrado de 24 mm. */"
