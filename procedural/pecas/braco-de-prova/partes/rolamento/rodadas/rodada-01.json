          "texto": "    objeto: 'rolamento do lado de trás do ombro, onde gira o pino do primeiro elo',"
        },
        {
          "tipo": "+",
          "linha": 53,
          "texto": "    referencias: ['../../../../../docs/modelar/banco-de-provas/braco-de-prova-2026-11-23/elos-opcoes.png'],"
        },
        {
          "tipo": "+",
