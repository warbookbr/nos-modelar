          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 92,
          "texto": "export const ALIASES = ["
        },
        {
          "tipo": "+",
          "linha": 93,
          "texto": "  ...Object.entries(BASE).map(([nome, base]) => [`furo${nome}`, { unir: ["
        },
        {
          "tipo": "+",
          "linha": 94,
          "texto": "    { origem: { op: 'cilindro', id: base + 40 } },"
        },
        {
          "tipo": "+",
