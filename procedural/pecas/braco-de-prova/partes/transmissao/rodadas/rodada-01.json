          "tipo": "+",
          "linha": 96,
          "texto": "    { origem: { op: 'cilindro', id: base + 40, tampa: 'topo' } },"
        },
        {
          "tipo": "+",
          "linha": 97,
          "texto": "  ] }]),"
        },
        {
          "tipo": "+",
          "linha": 98,
          "texto": "  ...[1, 2, 3, 4].map((k) => [`correia${k}`, { unir: ["
        },
        {
          "tipo": "+",
          "linha": 99,
          "texto": "    { origem: { op: 'cilindro', id: ID_CORREIA + k } },"
        },
        {
          "tipo": "+",
          "linha": 100,
          "texto": "    { origem: { op: 'cilindro', id: ID_CORREIA + k, tampa: 'fundo' } },"
        },
        {
          "tipo": "+",
          "linha": 101,
          "texto": "    { origem: { op: 'cilindro', id: ID_CORREIA + k, tampa: 'topo' } },"
        },
        {
          "tipo": "+",
          "linha": 102,
          "texto": "  ] }]),"
        },
        {
          "tipo": "+",
          "linha": 103,
          "texto": "];"
        },
        {
          "tipo": "+",
          "linha": 104,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 105,
          "texto": "export function gerarPassos(t = TABELA) {"
        },
        {
          "tipo": "+",
          "linha": 106,
          "texto": "  const { polias, correia } = derivar(t);"
        },
        {
          "tipo": "+",
          "linha": 107,
          "texto": "  const passos = [];"
        },
        {
          "tipo": "+",
          "linha": 108,
          "texto": "  const y = t.alturaDoEixo;"
        },
        {
          "tipo": "+",
          "linha": 109,
          "texto": "  const origens = {};"
        },
        {
          "tipo": "+",
          "linha": 110,
          "texto": "  for (const [nome, pol] of Object.entries(polias)) {"
        },
        {
          "tipo": "+",
          "linha": 111,
          "texto": "    let sel = null;"
        },
        {
          "tipo": "+",
          "linha": 112,
          "texto": "    for (const passo of pol.passos) {"
        },
        {
          "tipo": "+",
          "linha": 113,
          "texto": "      const [op, args] = comBase(passo, BASE[nome]);"
        },
        {
          "tipo": "+",
          "linha": 114,
          "texto": "      if (op === 'publicarPorta') continue;"
        },
        {
          "tipo": "+",
          "linha": 115,
          "texto": "      if (op === 'parte') {"
        },
        {
          "tipo": "+",
          "linha": 116,
          "texto": "        passos.push(['rotaciona', { sel: args.sel, eixo: 'x', graus: 90, pivo: [0, 0, 0] }]);"
        },
        {
          "tipo": "+",
          "linha": 117,
          "texto": "        passos.push(['transladar', { sel: args.sel, d: [m(pol.x), m(y), m(-pol.meioDaFaixa)] }]);"
        },
        {
          "tipo": "+",
          "linha": 118,
          "texto": "        /* O furo do perfil é o nominal; o da folga do encaixe é tirado depois, e é dele que sai a porta. */"
        },
        {
          "tipo": "+",
          "linha": 119,
          "texto": "        const idFuro = BASE[nome] + 40;"
        },
        {
          "tipo": "+",
          "linha": 120,
          "texto": "        passos.push(['cilindro', { origemId: idFuro, raio: m(pol.furo / 2), altura: m(pol.comprimento + 2), lados: 18, eixo: 'z', em: [m(pol.x), m(y), m(-pol.meioDaFaixa - 1)] }]);"
        },
        {
          "tipo": "+",
          "linha": 121,
          "texto": "        passos.push(['subtrair', { origemId: idFuro + 1, solidos: [args.sel, { alias: `furo${nome}` }] }]);"
        },
        {
          "tipo": "+",
          "linha": 122,
          "texto": "        sel = { origem: { op: 'subtrair', id: idFuro + 1 } };"
        },
        {
          "tipo": "+",
          "linha": 123,
          "texto": "        passos.push(['parte', { nome, sel }]);"
        },
        {
          "tipo": "+",
          "linha": 124,
          "texto": "        passos.push(['material', { usa: 'aluminio', sel }]);"
        },
        {
          "tipo": "+",
          "linha": 125,
          "texto": "        continue;"
        },
        {
          "tipo": "+",
          "linha": 126,
          "texto": "      }"
        },
        {
          "tipo": "+",
          "linha": 127,
          "texto": "      passos.push([op, args]);"
        },
        {
          "tipo": "+",
          "linha": 128,
          "texto": "    }"
        },
        {
          "tipo": "+",
          "linha": 129,
          "texto": "    origens[nome] = sel.origem;"
        },
        {
          "tipo": "+",
          "linha": 130,
          "texto": "  }"
        },
        {
          "tipo": "+",
          "linha": 131,
          "texto": "  const w = t.larguraDaCorreia;"
        },
        {
          "tipo": "+",
          "linha": 132,
          "texto": "  const e = t.espessuraDaCorreia;"
        },
        {
          "tipo": "+",
          "linha": 133,
          "texto": "  /* O anel de 36 lados circunscreve o externo da polia, para o meio de cada lado não entrar nos dentes. */"
        },
        {
          "tipo": "+",
          "linha": 134,
          "texto": "  const anel = (k, x, rExterno) => {"
        },
        {
          "tipo": "+",
          "linha": 135,
          "texto": "    const r = rExterno / Math.cos(Math.PI / 36) + 0.05;"
        },
        {
          "tipo": "+",
          "linha": 136,
          "texto": "    passos.push(['cilindro', { origemId: ID_CORREIA + k, raio: m(r + e), altura: m(w), lados: 36, eixo: 'z', em: [m(x), m(y), m(-w / 2)] }]);"
        },
        {
          "tipo": "+",
          "linha": 137,
          "texto": "    passos.push(['cilindro', { origemId: ID_CORREIA + k + 1, raio: m(r), altura: m(w + 2), lados: 36, eixo: 'z', em: [m(x), m(y), m(-w / 2 - 1)] }]);"
        },
        {
          "tipo": "+",
          "linha": 138,
          "texto": "    passos.push(['subtrair', { origemId: ID_CORREIA + 10 + k, solidos: [{ alias: `correia${k}` }, { alias: `correia${k + 1}` }] }]);"
        },
        {
          "tipo": "+",
          "linha": 139,
          "texto": "    return { origem: { op: 'subtrair', id: ID_CORREIA + 10 + k } };"
        },
        {
          "tipo": "+",
          "linha": 140,
          "texto": "  };"
        },
        {
          "tipo": "+",
          "linha": 141,
          "texto": "  const anelPequeno = anel(1, t.eixoDoMotor, correia.r1);"
        },
        {
          "tipo": "+",
          "linha": 142,
          "texto": "  const anelGrande = anel(3, t.cotovelo, correia.r2);"
        },
        {
          "tipo": "+",
          "linha": 143,
          "texto": "  const tangente = (id, sinal, centro) => {"
        },
        {
          "tipo": "+",
          "linha": 144,
          "texto": "    const sel = { origem: { op: 'cubo', id } };"
        },
        {
          "tipo": "+",
          "linha": 145,
          "texto": "    passos.push(['cubo', { origemId: id, larg: m(correia.comprimento), alt: m(e), prof: m(w), em: [0, sinal > 0 ? 0 : m(-e), 0] }]);"
        },
        {
          "tipo": "+",
          "linha": 146,
          "texto": "    passos.push(['rotaciona', { sel, eixo: 'z', graus: (sinal * correia.a * 180) / Math.PI, pivo: [0, 0, 0] }]);"
        },
        {
          "tipo": "+",
          "linha": 147,
          "texto": "    passos.push(['transladar', { sel, d: [m(centro[0]), m(centro[1]), 0] }]);"
        },
        {
          "tipo": "+",
          "linha": 148,
          "texto": "    return sel;"
        },
        {
          "tipo": "+",
          "linha": 149,
          "texto": "  };"
        },
        {
          "tipo": "+",
          "linha": 150,
          "texto": "  const deCima = tangente(ID_CORREIA + 20, 1, correia.meioDeCima);"
        },
        {
          "tipo": "+",
          "linha": 151,
          "texto": "  const deBaixo = tangente(ID_CORREIA + 21, -1, correia.meioDeBaixo);"
        },
        {
          "tipo": "+",
          "linha": 152,
          "texto": "  const sel = { origem: { op: 'unir', id: ID_CORREIA + 30 } };"
        },
        {
          "tipo": "+",
          "linha": 153,
          "texto": "  passos.push(['unir', { origemId: ID_CORREIA + 30, solidos: [anelPequeno, anelGrande, deCima, deBaixo] }]);"
        },
        {
          "tipo": "+",
          "linha": 154,
          "texto": "  passos.push(['parte', { nome: 'correia', sel }]);"
        },
        {
          "tipo": "+",
          "linha": 155,
          "texto": "  passos.push(['material', { usa: 'correia', sel }]);"
        },
        {
          "tipo": "+",
          "linha": 156,
          "texto": "  /* Depois do quarto de volta em x, o y da família vira +z: a polia vai de −meioDaFaixa (o lado do cubo, atrás) até"
        },
        {
          "tipo": "+",
          "linha": 157,
          "texto": "     comprimento − meioDaFaixa, e o furo cobre esse trecho todo. */"
        },
        {
          "tipo": "+",
          "linha": 158,
          "texto": "  const pp = polias.poliaPequena;"
        },
        {
          "tipo": "+",
          "linha": 159,
          "texto": "  const pg = polias.poliaGrande;"
        },
        {
          "tipo": "+",
          "linha": 160,
          "texto": "  passos.push(porta('furoDaPoliaPequena', origens.poliaPequena, {"
        },
        {
          "tipo": "+",
          "linha": 161,
          "texto": "    forma: 'cilindro', papel: 'interna', eixo: [0, 0, 1], centro: [t.eixoDoMotor, y, t.faceDoMotor], raio: t.furoPequeno / 2,"
        },
        {
          "tipo": "+",
          "linha": 162,
          "texto": "    inicio: -pp.meioDaFaixa - t.faceDoMotor, fim: pp.comprimento - pp.meioDaFaixa - t.faceDoMotor,"
        },
        {
          "tipo": "+",
          "linha": 163,
          "texto": "  }));"
        },
        {
          "tipo": "+",
          "linha": 164,
          "texto": "  passos.push(porta('furoDaPoliaGrande', origens.poliaGrande, {"
        },
        {
          "tipo": "+",
          "linha": 165,
          "texto": "    forma: 'cilindro', papel: 'interna', eixo: [0, 0, 1], centro: [t.cotovelo, y, -pg.meioDaFaixa], raio: t.furoGrande / 2, inicio: 0, fim: pg.comprimento,"
        },
        {
          "tipo": "+",
          "linha": 166,
          "texto": "  }));"
        },
        {
          "tipo": "+",
          "linha": 167,
          "texto": "  return passos;"
        },
        {
          "tipo": "+",
          "linha": 168,
          "texto": "}"
