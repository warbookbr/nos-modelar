        {
          "tipo": "+",
          "linha": 46,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 47,
          "texto": "let registro = null;"
        },
        {
          "tipo": "+",
          "linha": 48,
          "texto": "const familias = () => { registro ??= criarRegistroDeFamilias(); return registro; };"
        },
        {
          "tipo": "+",
          "linha": 49,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 50,
          "texto": "/* A polia da família é um corpo de revolução em torno de y, com o cubo de y 0 ao comprimento do cubo e a faixa da correia"
        },
        {
          "tipo": "+",
          "linha": 51,
          "texto": "   acima dele; a faixa é centrada no plano do braço (z 0) por um quarto de volta em x (y vira +z) e uma translação, com o cubo para trás, do lado do motor. */"
        },
        {
          "tipo": "+",
          "linha": 52,
          "texto": "function polia(t, id, perfil, furo, x) {"
        },
        {
          "tipo": "+",
          "linha": 53,
          "texto": "  const familia = familias().obter('polia-e-correia');"
        },
        {
          "tipo": "+",
          "linha": 54,
          "texto": "  const p = familia.contrato.perfis[perfil].parametros;"
        },
        {
          "tipo": "+",
          "linha": 55,
          "texto": "  const chamada = chamar(familia, id, p);"
        },
        {
          "tipo": "+",
          "linha": 56,
          "texto": "  const passos = expandirChamadasDeComposicao(familias().registroComposicoes, [chamada]).passos;"
        },
        {
          "tipo": "+",
          "linha": 57,
          "texto": "  /* O comprimento é o topo do perfil da revolução; a faixa (com as flanges, se houver) fica entre o cubo e o topo. */"
        },
        {
          "tipo": "+",
          "linha": 58,
          "texto": "  const perfilDoTorno = passos.find(([op]) => op === 'lathe')[1].perfil;"
        },
        {
          "tipo": "+",
          "linha": 59,
          "texto": "  const comprimento = Math.max(...perfilDoTorno.map(([, yy]) => yy)) * 1000;"
        },
        {
          "tipo": "+",
          "linha": 60,
          "texto": "  const meioDaFaixa = (p.comprimentoDoCubo + comprimento) / 2;"
        },
        {
          "tipo": "+",
          "linha": 61,
          "texto": "  return { p, passos, meioDaFaixa, comprimento, x, furo, primitivo: (p.dentes * 2) / Math.PI };"
        },
        {
          "tipo": "+",
          "linha": 62,
          "texto": "}"
        },
        {
          "tipo": "+",
          "linha": 63,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 64,
          "texto": "export function derivar(t = TABELA) {"
        },
        {
          "tipo": "+",
          "linha": 65,
          "texto": "  const pequena = polia(t, 'polia-pequena', t.perfilPequena, t.furoPequeno, t.eixoDoMotor);"
        },
        {
          "tipo": "+",
          "linha": 66,
          "texto": "  const grande = polia(t, 'polia-grande', t.perfilGrande, t.furoGrande, t.cotovelo);"
        },
        {
          "tipo": "+",
          "linha": 67,
          "texto": "  /* As tangentes externas: com r1 < r2 e d entre os centros, sen(a) = (r2 − r1)/d; o ponto de tangência de cima é o centro"
        },
        {
          "tipo": "+",
          "linha": 68,
          "texto": "     mais r·(−sen a, cos a) e o de baixo o centro mais r·(−sen a, −cos a). A correia assenta no diâmetro externo. */"
        },
        {
          "tipo": "+",
          "linha": 69,
          "texto": "  const y = t.alturaDoEixo;"
        },
        {
          "tipo": "+",
          "linha": 70,
          "texto": "  const r1 = pequena.primitivo / 2 - t.diferencaPrimitiva;"
        },
        {
          "tipo": "+",
          "linha": 71,
          "texto": "  const r2 = grande.primitivo / 2 - t.diferencaPrimitiva;"
        },
        {
          "tipo": "+",
          "linha": 72,
          "texto": "  const d = t.cotovelo - t.eixoDoMotor;"
        },
        {
          "tipo": "+",
          "linha": 73,
          "texto": "  const a = Math.asin((r2 - r1) / d);"
        },
        {
          "tipo": "+",
          "linha": 74,
          "texto": "  const comprimento = Math.sqrt(d * d - (r2 - r1) ** 2);"
        },
        {
          "tipo": "+",
          "linha": 75,
          "texto": "  const meio = (sinal) => {"
        },
        {
          "tipo": "+",
          "linha": 76,
          "texto": "    const p1 = [t.eixoDoMotor - r1 * Math.sin(a), y + sinal * r1 * Math.cos(a)];"
        },
        {
          "tipo": "+",
          "linha": 77,
          "texto": "    const p2 = [t.cotovelo - r2 * Math.sin(a), y + sinal * r2 * Math.cos(a)];"
        },
        {
          "tipo": "+",
          "linha": 78,
          "texto": "    return [(p1[0] + p2[0]) / 2, (p1[1] + p2[1]) / 2];"
        },
        {
          "tipo": "+",
          "linha": 79,
          "texto": "  };"
        },
        {
          "tipo": "+",
          "linha": 80,
          "texto": "  const correia = { r1, r2, a, comprimento, meioDeCima: meio(1), meioDeBaixo: meio(-1) };"
        },
        {
          "tipo": "+",
          "linha": 81,
          "texto": "  return { polias: { poliaPequena: pequena, poliaGrande: grande }, correia };"
        },
        {
          "tipo": "+",
          "linha": 82,
          "texto": "}"
        },
        {
          "tipo": "+",
          "linha": 83,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 84,
          "texto": "/* Os ids locais da família (de 10 a 30) somam a base de cada polia. */"
        },
        {
          "tipo": "+",
          "linha": 85,
          "texto": "const comBase = (v, base) => {"
        },
        {
          "tipo": "+",
          "linha": 86,
          "texto": "  if (Array.isArray(v)) return v.map((x) => comBase(x, base));"
        },
        {
          "tipo": "+",
          "linha": 87,
          "texto": "  if (v && typeof v === 'object') return Object.fromEntries(Object.entries(v).map(([k, x]) => [k, k === 'origemId' || (k === 'id' && typeof v.op === 'string') ? x + base : comBase(x, base)]));"
        },
        {
          "tipo": "+",
          "linha": 88,
          "texto": "  return v;"
        },
        {
          "tipo": "+",
          "linha": 89,
          "texto": "};"
        },
        {
          "tipo": "+",
          "linha": 90,
          "texto": "const BASE = { poliaPequena: 100, poliaGrande: 200 };"
        },
        {
          "tipo": "+",
