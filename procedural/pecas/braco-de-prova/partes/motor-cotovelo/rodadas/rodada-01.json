        {
          "tipo": "+",
          "linha": 7,
          "texto": " *"
        },
        {
          "tipo": "+",
          "linha": 8,
          "texto": " * Referencial: o da montagem (ver `../../comum/blocos.mjs`)."
        },
        {
          "tipo": "+",
          "linha": 9,
          "texto": " *"
        },
        {
          "tipo": "+",
          "linha": 10,
          "texto": " * Portas: `face` (plano, apoia, normal +z, na face do eixo) e `eixo` (cilindro externo, eixo +z, com o centro na face do"
        },
        {
          "tipo": "+",
          "linha": 11,
          "texto": " * motor), onde a polia pequena se prende."
        },
        {
          "tipo": "+",
          "linha": 12,
          "texto": " */"
        },
        {
          "tipo": "+",
          "linha": 13,
          "texto": "import { passosDasFormas, aliasesDasFormas, porta, origemDa, MATERIAIS as CORES } from '../../../comum/blocos.mjs';"
        },
        {
          "tipo": "+",
          "linha": 14,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 15,
          "texto": "export const TABELA = {"
        },
        {
          "tipo": "+",
          "linha": 16,
          "texto": "  alturaDoEixo: 140,"
        },
        {
          "tipo": "+",
          "linha": 17,
          "texto": "  eixoDoMotor: 80,"
        },
        {
          "tipo": "+",
          "linha": 18,
          "texto": "  /* Face de fora da parede de trás do primeiro elo. */"
        },
        {
          "tipo": "+",
          "linha": 19,
          "texto": "  faceDoElo: -26,"
        },
        {
          "tipo": "+",
          "linha": 20,
          "texto": "  lado: 42.3,"
        },
        {
          "tipo": "+",
          "linha": 21,
          "texto": "  comprimento: 40,"
        },
        {
          "tipo": "+",
          "linha": 22,
          "texto": "  raioDoEixo: 2.5,"
        },
        {
          "tipo": "+",
          "linha": 23,
          "texto": "  comprimentoDoEixo: 24,"
        },
        {
          "tipo": "+",
          "linha": 24,
          "texto": "  chanfro: 2,"
        },
        {
          "tipo": "+",
          "linha": 25,
          "texto": "  /* A flange do NEMA 17 (NEMA ICS 16): quatro furos M3 no quadrado de 31 mm, 4,5 mm de fundo, e o ressalto de 22 mm por"
        },
        {
          "tipo": "+",
          "linha": 26,
          "texto": "     2 mm em volta do eixo. */"
        },
        {
          "tipo": "+",
          "linha": 27,
          "texto": "  passoDosFuros: 31,"
        },
        {
          "tipo": "+",
          "linha": 28,
          "texto": "  raioDoFuroM3: 1.5,"
        },
        {
          "tipo": "+",
          "linha": 29,
          "texto": "  fundoDoFuro: 4.5,"
        },
        {
          "tipo": "+",
          "linha": 30,
          "texto": "  raioDoRessalto: 11,"
        },
        {
          "tipo": "+",
          "linha": 31,
          "texto": "  alturaDoRessalto: 2,"
        },
        {
          "tipo": "+",
          "linha": 32,
          "texto": "};"
        },
        {
          "tipo": "+",
          "linha": 33,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 34,
          "texto": "export const MATERIAIS = CORES;"
        },
        {
          "tipo": "+",
          "linha": 35,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 36,
          "texto": "/* Os quatro furos cegos da flange, abertos na face do eixo. */"
        },
        {
          "tipo": "+",
          "linha": 37,
          "texto": "const furosDaFlange = (t) => [-1, 1].flatMap((sx) => [-1, 1].map((sy) => ({"
        },
        {
          "tipo": "+",
          "linha": 38,
          "texto": "  eixo: 'z', base: [t.eixoDoMotor + (sx * t.passoDosFuros) / 2, t.alturaDoEixo + (sy * t.passoDosFuros) / 2, t.faceDoElo - t.fundoDoFuro],"
        },
        {
          "tipo": "+",
          "linha": 39,
          "texto": "  comprimento: t.fundoDoFuro + 1, raio: t.raioDoFuroM3, lados: 12,"
        },
        {
          "tipo": "+",
          "linha": 40,
          "texto": "})));"
        },
        {
          "tipo": "+",
          "linha": 41,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 42,
          "texto": "export function derivar(t = TABELA) {"
        },
        {
          "tipo": "+",
          "linha": 43,
          "texto": "  const h = t.lado / 2;"
        },
        {
          "tipo": "+",
          "linha": 44,
          "texto": "  return ["
        },
        {
          "tipo": "+",
          "linha": 45,
          "texto": "    { nome: 'motor', material: 'motor', chanfro: t.chanfro, caixa: [t.eixoDoMotor - h, t.eixoDoMotor + h, t.alturaDoEixo - h, t.alturaDoEixo + h, t.faceDoElo - t.comprimento, t.faceDoElo],"
        },
        {
          "tipo": "+",
          "linha": 46,
          "texto": "      furos: furosDaFlange(t) },"
        },
        {
          "tipo": "+",
          "linha": 47,
          "texto": "    { nome: 'ressalto', material: 'motor', eixo: 'z', base: [t.eixoDoMotor, t.alturaDoEixo, t.faceDoElo], comprimento: t.alturaDoRessalto, raio: t.raioDoRessalto, lados: 36 },"
        },
        {
          "tipo": "+",
          "linha": 48,
          "texto": "    { nome: 'eixo', material: 'aco', eixo: 'z', base: [t.eixoDoMotor, t.alturaDoEixo, t.faceDoElo], comprimento: t.comprimentoDoEixo, raio: t.raioDoEixo, lados: 18 },"
        },
        {
          "tipo": "+",
          "linha": 49,
          "texto": "  ];"
        },
        {
          "tipo": "+",
          "linha": 50,
          "texto": "}"
        },
        {
          "tipo": "+",
          "linha": 51,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 52,
          "texto": "export const ALIASES = aliasesDasFormas(derivar(TABELA));"
