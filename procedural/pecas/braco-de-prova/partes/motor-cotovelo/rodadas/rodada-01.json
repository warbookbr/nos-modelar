        {
          "tipo": "+",
          "linha": 53,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 54,
          "texto": "export function gerarPassos(t = TABELA) {"
        },
        {
          "tipo": "+",
          "linha": 55,
          "texto": "  const formas = derivar(t);"
        },
        {
          "tipo": "+",
          "linha": 56,
          "texto": "  const { passos } = passosDasFormas(formas);"
        },
        {
          "tipo": "+",
          "linha": 57,
          "texto": "  passos.push(porta('face', origemDa(formas, 'motor'), { forma: 'plano', papel: 'apoia', ponto: [t.eixoDoMotor, t.alturaDoEixo, t.faceDoElo], normal: [0, 0, 1], extensao: [42.3, 42.3] }));"
        },
        {
          "tipo": "+",
          "linha": 58,
          "texto": "  passos.push(porta('eixo', origemDa(formas, 'eixo'), {"
        },
        {
          "tipo": "+",
          "linha": 59,
          "texto": "    forma: 'cilindro', papel: 'externa', eixo: [0, 0, 1], centro: [t.eixoDoMotor, t.alturaDoEixo, t.faceDoElo], raio: t.raioDoEixo, inicio: 0, fim: t.comprimentoDoEixo,"
        },
        {
          "tipo": "+",
          "linha": 60,
          "texto": "  }));"
        },
        {
          "tipo": "+",
          "linha": 61,
          "texto": "  return passos;"
        },
        {
          "tipo": "+",
          "linha": 62,
          "texto": "}"
        },
        {
          "tipo": "+",
          "linha": 63,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 64,
          "texto": "const receita = {"
