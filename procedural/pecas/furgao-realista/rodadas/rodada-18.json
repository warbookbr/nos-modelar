          "texto": ""
        },
        {
          "tipo": "-",
          "linha": 365,
          "texto": "/* O comprimento acumulado de uma polilinha. */"
        },
        {
          "tipo": "-",
          "linha": 366,
          "texto": "function acumulado(pl) {"
        },
        {
          "tipo": "-",
          "linha": 367,
          "texto": "  const s = [0];"
        },
        {
          "tipo": "-",
          "linha": 368,
          "texto": "  for (let i = 1; i < pl.length; i += 1) s.push(s[i - 1] + Math.hypot(pl[i][0] - pl[i - 1][0], pl[i][1] - pl[i - 1][1]));"
        },
        {
          "tipo": "-",
          "linha": 369,
          "texto": "  return s;"
        },
        {
          "tipo": "-",
          "linha": 370,
          "texto": "}"
        },
        {
          "tipo": "-",
          "linha": 371,
          "texto": ""
        },
        {
          "tipo": "-",
          "linha": 372,
          "texto": "/* O ponto da polilinha à distância `d` do começo. */"
        },
        {
          "tipo": "-",
          "linha": 373,
          "texto": "function pontoNaDistancia(pl, s, d) {"
        },
        {
          "tipo": "-",
          "linha": 374,
          "texto": "  let i = 1;"
        },
        {
          "tipo": "-",
          "linha": 375,
          "texto": "  while (i < pl.length - 1 && s[i] < d) i += 1;"
        },
        {
          "tipo": "-",
          "linha": 376,
          "texto": "  const t = s[i] === s[i - 1] ? 0 : Math.min(1, Math.max(0, (d - s[i - 1]) / (s[i] - s[i - 1])));"
        },
        {
          "tipo": "-",
          "linha": 377,
          "texto": "  return [lerp(pl[i - 1][0], pl[i][0], t), lerp(pl[i - 1][1], pl[i][1], t)];"
        },
        {
          "tipo": "-",
          "linha": 378,
          "texto": "}"
        },
        {
          "tipo": "-",
          "linha": 379,
          "texto": ""
        },
        {
          "tipo": "-",
          "linha": 380,
          "texto": "/* O u da polilinha na altura v, pelo primeiro trecho que a atravessa (a polilinha sobe em v). */"
        },
        {
          "tipo": "-",
          "linha": 381,
          "texto": "function uNaAltura(pl, v) {"
        },
        {
          "tipo": "-",
          "linha": 382,
          "texto": "  for (let i = 1; i < pl.length; i += 1) {"
        },
        {
          "tipo": "-",
          "linha": 383,
          "texto": "    const [u0, v0] = pl[i - 1]; const [u1, v1] = pl[i];"
        },
        {
          "tipo": "-",
          "linha": 384,
          "texto": "    if ((v - v0) * (v - v1) <= 0 && v1 !== v0) return lerp(u0, u1, (v - v0) / (v1 - v0));"
        },
        {
          "tipo": "-",
          "linha": 385,
          "texto": "  }"
        },
        {
          "tipo": "-",
          "linha": 386,
          "texto": "  throw new Error(`furgao-realista: o perfil não chega à altura ${v}`);"
        },
        {
          "tipo": "-",
          "linha": 387,
          "texto": "}"
        },
        {
          "tipo": "-",
          "linha": 388,
          "texto": ""
        },
        {
          "tipo": "-",
          "linha": 389,
          "texto": "/* O trecho da polilinha entre as alturas v0 e v1 (sobe em v), cortado nelas. */"
        },
        {
          "tipo": "-",
          "linha": 390,
          "texto": "function trechoEntre(pl, v0, v1) {"
        },
        {
          "tipo": "-",
          "linha": 391,
          "texto": "  const saida = [[uNaAltura(pl, v0), v0]];"
        },
        {
          "tipo": "-",
          "linha": 392,
          "texto": "  for (const p of pl) if (p[1] > v0 + 1e-9 && p[1] < v1 - 1e-9) saida.push(p);"
        },
        {
          "tipo": "-",
          "linha": 393,
          "texto": "  return saida;"
        },
        {
          "tipo": "-",
          "linha": 394,
          "texto": "}"
        },
        {
          "tipo": "-",
          "linha": 395,
          "texto": ""
        },
        {
          "tipo": "-",
          "linha": 396,
          "texto": "/* O trecho da polilinha a partir do primeiro ponto em que ela atinge a altura v (o resto, até o fim). */"
        },
        {
          "tipo": "-",
          "linha": 397,
          "texto": "function aPartirDe(pl, v) {"
        },
        {
          "tipo": "-",
          "linha": 398,
          "texto": "  const s = acumulado(pl);"
        },
        {
          "tipo": "-",
          "linha": 399,
          "texto": "  for (let i = 1; i < pl.length; i += 1) {"
        },
        {
          "tipo": "-",
          "linha": 400,
          "texto": "    const [u0, v0] = pl[i - 1]; const [u1, v1] = pl[i];"
        },
        {
          "tipo": "-",
          "linha": 401,
          "texto": "    if ((v - v0) * (v - v1) <= 0 && v1 !== v0) {"
        },
        {
          "tipo": "-",
          "linha": 402,
          "texto": "      const p = [lerp(u0, u1, (v - v0) / (v1 - v0)), v];"
        },
        {
          "tipo": "-",
          "linha": 403,
          "texto": "      return { pl: [p, ...pl.slice(i)], s0: s[i - 1] + Math.hypot(p[0] - u0, p[1] - v0) };"
        },
        {
          "tipo": "-",
          "linha": 404,
          "texto": "    }"
        },
        {
          "tipo": "-",
          "linha": 405,
          "texto": "  }"
        },
        {
          "tipo": "-",
          "linha": 406,
          "texto": "  throw new Error(`furgao-realista: o perfil não chega à altura ${v}`);"
        },
        {
          "tipo": "-",
          "linha": 407,
          "texto": "}"
        },
        {
          "tipo": "-",
          "linha": 408,
          "texto": ""
        },
        {
          "tipo": "-",
          "linha": 409,
          "texto": "/* As alturas em que o perfil pede anel: a cada `passo` de arco ou a cada `giroMax` graus de giro, o que vier antes. */"
        },
        {
          "tipo": "-",
          "linha": 410,
          "texto": "function alturasDoPerfil(polilinha, passo, giroMax) {"
        },
        {
          "tipo": "-",
          "linha": 411,
          "texto": "  /* os trechos retos longos (o capô, o para-brisa) se dividem antes, para o passo de arco valer dentro deles */"
        },
        {
          "tipo": "-",
          "linha": 412,
          "texto": "  const pl = [polilinha[0]];"
        },
        {
          "tipo": "-",
          "linha": 413,
          "texto": "  for (let i = 1; i < polilinha.length; i += 1) {"
        },
        {
          "tipo": "-",
          "linha": 414,
          "texto": "    const [a, b] = [polilinha[i - 1], polilinha[i]];"
        },
        {
          "tipo": "-",
          "linha": 415,
          "texto": "    const n = Math.max(1, Math.ceil(Math.hypot(b[0] - a[0], b[1] - a[1]) / (passo / 8)));"
        },
        {
          "tipo": "-",
          "linha": 416,
          "texto": "    for (let k = 1; k <= n; k += 1) pl.push([lerp(a[0], b[0], k / n), lerp(a[1], b[1], k / n)]);"
        },
        {
          "tipo": "-",
          "linha": 417,
          "texto": "  }"
        },
        {
          "tipo": "-",
          "linha": 418,
          "texto": "  const alturas = [pl[0][1]];"
        },
        {
          "tipo": "-",
          "linha": 419,
          "texto": "  let arco = 0; let giro = 0;"
        },
        {
          "tipo": "-",
          "linha": 420,
          "texto": "  for (let i = 1; i < pl.length; i += 1) {"
        },
        {
          "tipo": "-",
          "linha": 421,
          "texto": "    arco += Math.hypot(pl[i][0] - pl[i - 1][0], pl[i][1] - pl[i - 1][1]);"
        },
        {
          "tipo": "-",
          "linha": 422,
          "texto": "    if (i + 1 < pl.length) {"
        },
        {
          "tipo": "-",
          "linha": 423,
          "texto": "      const a = Math.atan2(pl[i][1] - pl[i - 1][1], pl[i][0] - pl[i - 1][0]);"
        },
        {
          "tipo": "-",
          "linha": 424,
          "texto": "      const b = Math.atan2(pl[i + 1][1] - pl[i][1], pl[i + 1][0] - pl[i][0]);"
        },
        {
          "tipo": "-",
          "linha": 425,
          "texto": "      let d = b - a; while (d > Math.PI) d -= 2 * Math.PI; while (d < -Math.PI) d += 2 * Math.PI;"
        },
        {
          "tipo": "-",
          "linha": 426,
          "texto": "      giro += Math.abs(d) / grau;"
        },
        {
          "tipo": "-",
          "linha": 427,
          "texto": "    }"
        },
        {
          "tipo": "-",
          "linha": 428,
          "texto": "    if (arco >= passo || giro >= giroMax) { alturas.push(pl[i][1]); arco = 0; giro = 0; }"
        },
        {
          "tipo": "-",
          "linha": 429,
          "texto": "  }"
        },
        {
          "tipo": "-",
          "linha": 430,
          "texto": "  return alturas;"
        },
        {
          "tipo": "-",
          "linha": 431,
          "texto": "}"
        },
        {
          "tipo": "-",
          "linha": 432,
          "texto": ""
        },
        {
          "tipo": "-",
          "linha": 433,
          "texto": "/* Pontos igualmente espaçados entre a e b, sem as pontas, com passo de no máximo `passo`. */"
        },
        {
          "tipo": "-",
          "linha": 434,
          "texto": "function entre(a, b, passo) {"
        },
        {
          "tipo": "-",
          "linha": 435,
          "texto": "  const n = Math.max(1, Math.ceil(Math.abs(b - a) / passo - 1e-9));"
        },
        {
          "tipo": "-",
          "linha": 436,
          "texto": "  return Array.from({ length: n - 1 }, (_, k) => lerp(a, b, (k + 1) / n));"
        },
        {
          "tipo": "-",
          "linha": 437,
          "texto": "}"
        },
        {
          "tipo": "-",
          "linha": 438,
          "texto": ""
        },
        {
          "tipo": "-",
          "linha": 439,
          "texto": "/* ---------- a forma, em milímetro ---------- */"
        },
        {
          "tipo": "-",
          "linha": 440,
          "texto": ""
        },
        {
          "tipo": "-",
          "linha": 441,
          "texto": "/** Os perfis, as funções de fatia e as medidas derivadas, tudo da TABELA. */"
        },
        {
          "tipo": "-",
          "linha": 442,
          "texto": "export function forma(T) {"
        },
        {
          "tipo": "-",
          "linha": 443,
          "texto": "  const zFrente = T.comprimento / 2;"
        },
        {
          "tipo": "-",
          "linha": 444,
          "texto": "  const zTras = -T.comprimento / 2;"
        },
        {
          "tipo": "-",
          "linha": 445,
          "texto": "  const xMax = T.meia_largura;"
        },
        {
          "tipo": "-",
          "linha": 446,
          "texto": "  const ys = T.soleira_y;"
        },
        {
          "tipo": "-",
          "linha": 447,
          "texto": "  const zD = zFrente - T.balanco_dianteiro;"
        },
        {
          "tipo": "-",
          "linha": 448,
          "texto": "  const zT = zD - T.entre_eixos;"
        },
        {
          "tipo": "-",
          "linha": 449,
          "texto": "  const rPneu = T.pneu_diametro / 2;"
        },
        {
          "tipo": "-",
          "linha": 450,
          "texto": ""
        },
        {
          "tipo": "-",
          "linha": 451,
          "texto": "  /* perfil da frente, [z, y], do pé do nariz ao teto */"
        },
        {
          "tipo": "-",
          "linha": 452,
          "texto": "  const baseVidro = [zFrente - T.base_vidro_recuo, T.base_vidro_y];"
        },
        {
          "tipo": "-",
          "linha": 453,
          "texto": "  const boca = [baseVidro[0] + T.capo_comprimento, T.boca_y];"
        },
        {
          "tipo": "-",
          "linha": 454,
          "texto": "  const topoVidro = [baseVidro[0] - (T.topo_vidro_y - baseVidro[1]) / Math.tan(T.para_brisa_angulo * grau), T.topo_vidro_y];"
        },
        {
          "tipo": "-",
          "linha": 455,
          "texto": "  const anguloCapo = Math.atan2(baseVidro[1] - boca[1], boca[0] - baseVidro[0]) / grau;"
        },
        {
          "tipo": "-",
          "linha": 456,
          "texto": "  const frenteDensa = contornoComRaios(["
        },
        {
          "tipo": "-",
          "linha": 457,
          "texto": "    [zFrente - 4 * T.raio_nariz_base, ys], [zFrente, ys, T.raio_nariz_base], [zFrente, T.parachoque_topo_y, T.raio_parachoque_topo],"
        },
        {
          "tipo": "-",
          "linha": 458,
          "texto": "    [zFrente - T.degrau_frente_recuo, T.degrau_frente_y, T.raio_degrau_frente], [...boca, T.raio_boca], [...baseVidro, T.raio_base_vidro],"
        },
        {
          "tipo": "-",
          "linha": 459,
          "texto": "    [...topoVidro],"
        },
        {
          "tipo": "-",
          "linha": 460,
          "texto": "  ]);"
        },
        {
          "tipo": "-",
          "linha": 461,
          "texto": "  /* o perfil começa no pé do raio do nariz (o trecho reto da soleira fica de fora) */"
        },
        {
          "tipo": "-",
          "linha": 462,
          "texto": "  const frenteAteVidro = frenteDensa.slice(frenteDensa.findIndex((p) => p[0] > zFrente - T.raio_nariz_base - 1e-6));"
        },
        {
          "tipo": "-",
          "linha": 463,
          "texto": "  /* A curva do teto sobre o para-brisa: dois arcos tangentes, o de raio_arco_vidro saindo do para-brisa no topo do vidro e o de"
        },
        {
          "tipo": "-",
          "linha": 464,
          "texto": "     raio_arco_testa chegando ao teto plano, que somam os 55 graus do para-brisa. O filete não desenha dois raios emendados, então os"
        },
        {
          "tipo": "-",
          "linha": 465,
          "texto": "     arcos são calculados aqui: o ângulo da emenda sai da subida que falta até o teto. Uma direção é o ângulo do trecho, de 0 (para a"
        },
        {
          "tipo": "-",
          "linha": 466,
          "texto": "     frente) a 180 graus (para trás); no para-brisa ela é 180 menos o ângulo do vidro. */"
        },
        {
          "tipo": "-",
          "linha": 467,
          "texto": "  const dirVidro = Math.PI - T.para_brisa_angulo * grau;"
        },
        {
          "tipo": "-",
          "linha": 468,
          "texto": "  const cosEmenda = ((T.altura - T.topo_vidro_y) - T.raio_arco_testa - T.raio_arco_vidro * Math.cos(dirVidro)) / (T.raio_arco_testa - T.raio_arco_vidro);"
        },
        {
          "tipo": "-",
          "linha": 469,
          "texto": "  if (!(Math.abs(cosEmenda) <= 1)) throw new Error('furgao-realista: os dois raios da curva do teto não fecham a subida até o teto');"
        },
        {
          "tipo": "-",
          "linha": 470,
          "texto": "  const dirEmenda = Math.acos(cosEmenda);"
        },
        {
          "tipo": "-",
          "linha": 471,
          "texto": "  if (dirEmenda <= dirVidro || dirEmenda >= Math.PI) throw new Error('furgao-realista: a emenda dos dois raios da curva do teto sai fora da curva');"
        },
        {
          "tipo": "-",
          "linha": 472,
          "texto": "  const arcoTangente = (inicio, r, a, b) => {"
        },
        {
          "tipo": "-",
          "linha": 473,
          "texto": "    const n = Math.max(2, Math.ceil(Math.abs(b - a) / grau));"
        }
      ],
      "cortada": true
    }
