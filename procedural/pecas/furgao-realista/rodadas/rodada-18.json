        {
          "tipo": "-",
          "linha": 335,
          "texto": ""
        },
        {
          "tipo": "-",
          "linha": 336,
          "texto": "/* A poligonal com o raio de cada canto ([u, v, raio?]) virada em polilinha densa: cada canto com raio vira arco tangente aos dois"
        },
        {
          "tipo": "-",
          "linha": 337,
          "texto": "   trechos, amostrado a cada grau. O canto sem raio fica vivo. */"
        },
        {
          "tipo": "-",
          "linha": 338,
          "texto": "function contornoComRaios(pts) {"
        },
        {
          "tipo": "-",
          "linha": 339,
          "texto": "  const saida = [[pts[0][0], pts[0][1]]];"
        },
        {
          "tipo": "-",
          "linha": 340,
          "texto": "  for (let i = 1; i < pts.length - 1; i += 1) {"
        },
        {
          "tipo": "-",
          "linha": 341,
          "texto": "    const [px, py, r = 0] = pts[i];"
        },
        {
          "tipo": "-",
          "linha": 342,
          "texto": "    const a = pts[i - 1]; const b = pts[i + 1];"
        },
        {
          "tipo": "-",
          "linha": 343,
          "texto": "    const d1 = [px - a[0], py - a[1]]; const l1 = Math.hypot(...d1);"
        },
        {
          "tipo": "-",
          "linha": 344,
          "texto": "    const d2 = [b[0] - px, b[1] - py]; const l2 = Math.hypot(...d2);"
        },
        {
          "tipo": "-",
          "linha": 345,
          "texto": "    const u1 = [d1[0] / l1, d1[1] / l1]; const u2 = [d2[0] / l2, d2[1] / l2];"
        },
        {
          "tipo": "-",
          "linha": 346,
          "texto": "    const giro = Math.atan2(u1[0] * u2[1] - u1[1] * u2[0], u1[0] * u2[0] + u1[1] * u2[1]);"
        },
        {
          "tipo": "-",
          "linha": 347,
          "texto": "    if (!r || Math.abs(giro) < 1e-9) { saida.push([px, py]); continue; }"
        },
        {
          "tipo": "-",
          "linha": 348,
          "texto": "    const t = r * Math.tan(Math.abs(giro) / 2);"
        },
        {
          "tipo": "-",
          "linha": 349,
          "texto": "    if (t > l1 / 2 + 1e-6 || t > l2 / 2 + 1e-6) throw new Error(`furgao-realista: o raio ${r} no canto [${px}, ${py}] não cabe entre os vizinhos`);"
        },
        {
          "tipo": "-",
          "linha": 350,
          "texto": "    const t1 = [px - u1[0] * t, py - u1[1] * t];"
        },
        {
          "tipo": "-",
          "linha": 351,
          "texto": "    const sinal = Math.sign(giro);"
        },
        {
          "tipo": "-",
          "linha": 352,
          "texto": "    const n = [-u1[1] * sinal, u1[0] * sinal];"
        },
        {
          "tipo": "-",
          "linha": 353,
          "texto": "    const c = [t1[0] + n[0] * r, t1[1] + n[1] * r];"
        },
        {
          "tipo": "-",
          "linha": 354,
          "texto": "    const a0 = Math.atan2(t1[1] - c[1], t1[0] - c[0]);"
        },
        {
          "tipo": "-",
          "linha": 355,
          "texto": "    const passos = Math.max(2, Math.ceil(Math.abs(giro) / grau));"
        },
        {
          "tipo": "-",
          "linha": 356,
          "texto": "    for (let k = 0; k <= passos; k += 1) {"
        },
        {
          "tipo": "-",
          "linha": 357,
          "texto": "      const ang = a0 + (giro * k) / passos;"
        },
        {
          "tipo": "-",
          "linha": 358,
          "texto": "      saida.push([c[0] + r * Math.cos(ang), c[1] + r * Math.sin(ang)]);"
        },
        {
          "tipo": "-",
          "linha": 359,
          "texto": "    }"
        },
        {
          "tipo": "-",
          "linha": 360,
          "texto": "  }"
        },
        {
          "tipo": "-",
          "linha": 361,
          "texto": "  saida.push([pts.at(-1)[0], pts.at(-1)[1]]);"
        },
        {
          "tipo": "-",
          "linha": 362,
          "texto": "  return saida;"
        },
        {
          "tipo": "-",
          "linha": 363,
