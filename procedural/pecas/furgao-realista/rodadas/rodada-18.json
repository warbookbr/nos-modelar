        {
          "tipo": "-",
          "linha": 330,
          "texto": "const grau = Math.PI / 180;"
        },
        {
          "tipo": "-",
          "linha": 331,
          "texto": "const lerp = (a, b, t) => a + (b - a) * t;"
        },
        {
          "tipo": "-",
          "linha": 332,
          "texto": "const suave = (t) => { const u = Math.min(1, Math.max(0, t)); return u * u * (3 - 2 * u); };"
