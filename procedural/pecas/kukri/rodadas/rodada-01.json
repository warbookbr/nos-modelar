          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 55,
          "texto": "/* ---------- ajudantes de curva ---------- */"
        },
        {
          "tipo": "+",
          "linha": 56,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 57,
          "texto": "/** Interpola `tab` ([x, v] com x crescente) em x por Hermite monótono: sem overshoot, tangente nula nos extremos locais. */"
        },
        {
          "tipo": "+",
          "linha": 58,
          "texto": "function interpola(tab, x) {"
        },
        {
          "tipo": "+",
          "linha": 59,
          "texto": "  const n = tab.length;"
        },
        {
          "tipo": "+",
          "linha": 60,
          "texto": "  if (x <= tab[0][0]) return tab[0][1];"
        },
        {
          "tipo": "+",
          "linha": 61,
          "texto": "  if (x >= tab[n - 1][0]) return tab[n - 1][1];"
        },
        {
          "tipo": "+",
          "linha": 62,
          "texto": "  let i = 0;"
        },
        {
          "tipo": "+",
          "linha": 63,
          "texto": "  while (tab[i + 1][0] < x) i++;"
        },
        {
          "tipo": "+",
          "linha": 64,
          "texto": "  const sec = (k) => (tab[k + 1][1] - tab[k][1]) / (tab[k + 1][0] - tab[k][0]);"
        },
        {
          "tipo": "+",
          "linha": 65,
          "texto": "  const tang = (k) => {"
        },
        {
          "tipo": "+",
          "linha": 66,
          "texto": "    if (k === 0) return sec(0);"
        },
        {
          "tipo": "+",
          "linha": 67,
          "texto": "    if (k === n - 1) return sec(n - 2);"
        },
        {
          "tipo": "+",
          "linha": 68,
          "texto": "    const a = sec(k - 1); const b = sec(k);"
        },
        {
          "tipo": "+",
          "linha": 69,
          "texto": "    return a * b <= 0 ? 0 : (2 * a * b) / (a + b);"
        },
        {
          "tipo": "+",
          "linha": 70,
          "texto": "  };"
        },
        {
          "tipo": "+",
          "linha": 71,
          "texto": "  const [x0, y0] = tab[i]; const [x1, y1] = tab[i + 1];"
        },
        {
          "tipo": "+",
          "linha": 72,
          "texto": "  const h = x1 - x0; const t = (x - x0) / h;"
        },
        {
          "tipo": "+",
          "linha": 73,
          "texto": "  const h00 = 2 * t ** 3 - 3 * t ** 2 + 1; const h10 = t ** 3 - 2 * t ** 2 + t; const h01 = -2 * t ** 3 + 3 * t ** 2; const h11 = t ** 3 - t ** 2;"
        },
        {
          "tipo": "+",
          "linha": 74,
          "texto": "  return h00 * y0 + h10 * h * tang(i) + h01 * y1 + h11 * h * tang(i + 1);"
        },
        {
          "tipo": "+",
          "linha": 75,
          "texto": "}"
        },
        {
          "tipo": "+",
          "linha": 76,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 77,
          "texto": "const m = (mm) => mm / 1000;"
        },
        {
          "tipo": "+",
          "linha": 78,
          "texto": "const entre = (a, b, t) => Math.min(b, Math.max(a, t));"
        },
        {
          "tipo": "+",
          "linha": 79,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 80,
          "texto": "/* ---------- lâmina ---------- */"
        },
        {
          "tipo": "+",
          "linha": 81,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 82,
          "texto": "/** As estações em x do contorno da lâmina, da base à ponta. */"
        },
        {
          "tipo": "+",
          "linha": 83,
          "texto": "export function estacoes(T) {"
        },
        {
          "tipo": "+",
          "linha": 84,
          "texto": "  const xs = new Set([T.lamina_base, T.degrau_x, T.degrau_x + T.degrau_rampa, 280, 280 - T.quebra_suave / 2, 280 + T.quebra_suave / 2, T.comprimento]);"
        },
        {
          "tipo": "+",
          "linha": 85,
          "texto": "  for (let x = T.lamina_base; x < T.comprimento; x += T.passo_x) xs.add(x);"
        },
        {
          "tipo": "+",
          "linha": 86,
          "texto": "  return [...xs].sort((a, b) => a - b);"
        },
        {
          "tipo": "+",
          "linha": 87,
          "texto": "}"
        },
        {
          "tipo": "+",
          "linha": 88,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 89,
          "texto": "const zRetoDorso = (T, x) => (x <= 280 ? interpola(T.dorso_base_quebra, x) : interpola(T.dorso_quebra_ponta, x));"
        },
        {
          "tipo": "+",
          "linha": 90,
          "texto": "function zDorso(T, x) {"
        },
        {
          "tipo": "+",
          "linha": 91,
          "texto": "  const r = T.quebra_suave;"
        },
        {
          "tipo": "+",
          "linha": 92,
          "texto": "  if (!(Math.abs(x - 280) < r)) return zRetoDorso(T, x);"
        },
        {
          "tipo": "+",
          "linha": 93,
          "texto": "  const t = (x - 280 + r) / (2 * r);"
        },
        {
          "tipo": "+",
          "linha": 94,
          "texto": "  return (1 - t) ** 2 * zRetoDorso(T, 280 - r) + 2 * t * (1 - t) * zRetoDorso(T, 280) + t * t * zRetoDorso(T, 280 + r);"
        },
        {
          "tipo": "+",
          "linha": 95,
          "texto": "}"
        },
        {
          "tipo": "+",
          "linha": 96,
          "texto": "const zGume = (T, x) => interpola(T.gume, x);"
        },
        {
          "tipo": "+",
          "linha": 97,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 98,
          "texto": "/** Largura em z do chanfro do gume na estação x: nula no trecho sem fio, sobe no degrau e cede perto da ponta. */"
        },
        {
          "tipo": "+",
          "linha": 99,
          "texto": "export function larguraDoChanfro(T, x) {"
        },
        {
          "tipo": "+",
          "linha": 100,
          "texto": "  const rampa = entre(0, 1, (x - T.degrau_x) / T.degrau_rampa);"
        },
        {
          "tipo": "+",
          "linha": 101,
          "texto": "  return Math.min(T.chanfro_largura * rampa, T.chanfro_fracao * (zDorso(T, x) - zGume(T, x)));"
        },
        {
          "tipo": "+",
          "linha": 102,
          "texto": "}"
        },
        {
          "tipo": "+",
          "linha": 103,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 104,
          "texto": "/** O contorno da lâmina no plano s (distância do meio da chapa, em mm): { gume, dorsoPonta, dorsoBase, base } em [x, z]. */"
        },
        {
          "tipo": "+",
          "linha": 105,
          "texto": "export function lacoDaLamina(T, s) {"
        },
        {
          "tipo": "+",
          "linha": 106,
          "texto": "  const xs = estacoes(T);"
        },
        {
          "tipo": "+",
          "linha": 107,
          "texto": "  const meia = T.espessura_dorso / 2;"
        },
        {
          "tipo": "+",
          "linha": 108,
          "texto": "  const ponto = (x) => {"
        },
        {
          "tipo": "+",
          "linha": 109,
          "texto": "    const a = Math.abs(s);"
        },
        {
          "tipo": "+",
          "linha": 110,
          "texto": "    const larg = zDorso(T, x) - zGume(T, x);"
        },
        {
          "tipo": "+",
          "linha": 111,
          "texto": "    const rec = a > T.quina_dorso_ate ? Math.min(T.quina_dorso_recuo, 0.15 * larg) : 0;"
        },
        {
          "tipo": "+",
          "linha": 112,
          "texto": "    const zd = zDorso(T, x) - rec;"
        },
        {
          "tipo": "+",
          "linha": 113,
          "texto": "    const ze = zGume(T, x) + larguraDoChanfro(T, x) * (a / meia);"
        },
        {
          "tipo": "+",
          "linha": 114,
          "texto": "    return { d: [x, zd], e: [x, ze] };"
        },
        {
          "tipo": "+",
          "linha": 115,
          "texto": "  };"
        },
        {
          "tipo": "+",
          "linha": 116,
          "texto": "  const pts = xs.map(ponto);"
        },
        {
          "tipo": "+",
          "linha": 117,
          "texto": "  const gume = pts.map((p) => p.e);"
        },
        {
          "tipo": "+",
          "linha": 118,
          "texto": "  const dorso = pts.map((p) => p.d);"
        },
        {
          "tipo": "+",
          "linha": 119,
          "texto": "  const ponta = gume[gume.length - 1];"
        },
        {
          "tipo": "+",
          "linha": 120,
          "texto": "  const iQuebra = xs.indexOf(280);"
        },
        {
          "tipo": "+",
          "linha": 121,
          "texto": "  const dorsoPonta = dorso.slice(iQuebra).reverse();"
        },
        {
          "tipo": "+",
          "linha": 122,
          "texto": "  const dorsoBase = dorso.slice(0, iQuebra + 1).reverse();"
        },
        {
          "tipo": "+",
          "linha": 123,
          "texto": "  const base = [dorso[0], [(dorso[0][0] + gume[0][0]) / 2, (dorso[0][1] + gume[0][1]) / 2], gume[0]];"
        },
        {
          "tipo": "+",
          "linha": 124,
          "texto": "  return { gume, ponta: [ponta, ponta], dorsoPonta, dorsoBase, base };"
        },
        {
          "tipo": "+",
          "linha": 125,
          "texto": "}"
        },
        {
          "tipo": "+",
          "linha": 126,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 127,
          "texto": "export function argumentosDaLamina(T) {"
        },
        {
          "tipo": "+",
          "linha": 128,
          "texto": "  const niv = [-T.espessura_dorso / 2, -T.quina_dorso_ate, 0, T.quina_dorso_ate, T.espessura_dorso / 2];"
        },
        {
          "tipo": "+",
          "linha": 129,
          "texto": "  const l0 = lacoDaLamina(T, 0);"
        },
        {
          "tipo": "+",
          "linha": 130,
          "texto": "  return {"
        },
        {
          "tipo": "+",
          "linha": 131,
          "texto": "    nome: 'l', eixo: 'y', tampa: { de: 'base', ate: 'ponta' },"
        },
        {
          "tipo": "+",
          "linha": 132,
          "texto": "    trechos: ["
        },
        {
          "tipo": "+",
          "linha": 133,
          "texto": "      { nome: 'base', pontos: l0.base.length }, { nome: 'gume', pontos: l0.gume.length }, { nome: 'ponta', pontos: 2 },"
        },
        {
          "tipo": "+",
          "linha": 134,
          "texto": "      { nome: 'dorsoPonta', pontos: l0.dorsoPonta.length }, { nome: 'dorsoBase', pontos: l0.dorsoBase.length },"
        },
        {
          "tipo": "+",
          "linha": 135,
          "texto": "    ],"
        },
        {
          "tipo": "+",
          "linha": 136,
          "texto": "    lacos: niv.map((s) => {"
        },
        {
          "tipo": "+",
          "linha": 137,
          "texto": "      const l = lacoDaLamina(T, s);"
        },
        {
          "tipo": "+",
          "linha": 138,
          "texto": "      return { em: T.eixo_y + s, trechos: { base: l.base, gume: l.gume, ponta: l.ponta, dorsoPonta: l.dorsoPonta, dorsoBase: l.dorsoBase } };"
        },
        {
          "tipo": "+",
          "linha": 139,
          "texto": "    }),"
        },
        {
          "tipo": "+",
          "linha": 140,
          "texto": "    vincos: niv.map((_, i) => ({ nome: `plano${i}`, laco: `l${i}`, nitidez: 'viva' })),"
        },
        {
          "tipo": "+",
          "linha": 141,
          "texto": "    grupos: [{ nome: 'fio', trechos: ['gume'] }],"
        },
        {
          "tipo": "+",
          "linha": 142,
          "texto": "  };"
        },
        {
          "tipo": "+",
          "linha": 143,
          "texto": "}"
        },
        {
          "tipo": "+",
          "linha": 144,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 145,
          "texto": "/* ---------- cabo ---------- */"
        },
        {
          "tipo": "+",
          "linha": 146,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 147,
          "texto": "const centroZ = (T, x) => T.cabo_z_em_140 - T.cabo_z_inclinacao * (T.lamina_base - x);"
        },
        {
          "tipo": "+",
          "linha": 148,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 149,
          "texto": "/** Quanto o sulco entre gomos tira dos semieixos em x. Os sulcos ficam em lamina_base - 15 - k * gomo_passo. */"
        },
        {
          "tipo": "+",
          "linha": 150,
          "texto": "function sulco(T, x) {"
        },
        {
          "tipo": "+",
          "linha": 151,
          "texto": "  let d = 0;"
        },
        {
          "tipo": "+",
          "linha": 152,
          "texto": "  for (let k = 0; k < 6; k++) {"
        },
        {
          "tipo": "+",
          "linha": 153,
          "texto": "    const xc = T.cabo_frente - 15 - k * T.gomo_passo;"
        },
        {
          "tipo": "+",
          "linha": 154,
          "texto": "    const u = Math.abs(x - xc);"
        },
        {
          "tipo": "+",
          "linha": 155,
          "texto": "    if (u < T.gomo_sulco_meia_largura) d = Math.max(d, T.gomo_sulco * (0.5 + 0.5 * Math.cos((Math.PI * u) / T.gomo_sulco_meia_largura)));"
        },
        {
          "tipo": "+",
          "linha": 156,
          "texto": "  }"
        },
        {
          "tipo": "+",
          "linha": 157,
          "texto": "  return d;"
        },
        {
          "tipo": "+",
          "linha": 158,
          "texto": "}"
        },
        {
          "tipo": "+",
          "linha": 159,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 160,
          "texto": "/** A seção do cabo em x: centro e semieixos em z e y. */"
        },
        {
          "tipo": "+",
          "linha": 161,
          "texto": "export function secaoDoCabo(T, x) {"
        },
        {
          "tipo": "+",
          "linha": 162,
          "texto": "  if (x < 58) {"
        },
        {
          "tipo": "+",
          "linha": 163,
          "texto": "    const hi = interpola(T.bico_hi, x); const lo = interpola(T.bico_lo, x);"
        },
        {
          "tipo": "+",
          "linha": 164,
          "texto": "    return { zc: (hi + lo) / 2, sz: (hi - lo) / 2, sy: interpola(T.bico_hy, x) };"
        },
        {
          "tipo": "+",
          "linha": 165,
          "texto": "  }"
        },
        {
          "tipo": "+",
          "linha": 166,
          "texto": "  const t = entre(0, 1, (x - 60) / (126 - 60));"
        },
        {
          "tipo": "+",
          "linha": 167,
          "texto": "  const crista = T.cabo_meio_z_cresta_60 + (T.cabo_meio_z_cresta_126 - T.cabo_meio_z_cresta_60) * t;"
        },
        {
          "tipo": "+",
          "linha": 168,
          "texto": "  let sz = crista; let sy = T.cabo_meio_y;"
        },
        {
          "tipo": "+",
          "linha": 169,
          "texto": "  const d = sulco(T, x);"
        },
        {
          "tipo": "+",
          "linha": 170,
          "texto": "  sz -= d; sy -= d;"
        },
        {
          "tipo": "+",
          "linha": 171,
          "texto": "  if (x > T.guarda_ate) {"
        },
        {
          "tipo": "+",
          "linha": 172,
          "texto": "    const g = (x - T.guarda_ate) / (T.cabo_frente - T.guarda_ate);"
        },
        {
          "tipo": "+",
          "linha": 173,
          "texto": "    const alarga = g * g * (3 - 2 * g);"
        },
        {
          "tipo": "+",
          "linha": 174,
          "texto": "    sz = crista + (T.guarda_meio_z_frente - crista) * alarga;"
        },
        {
          "tipo": "+",
          "linha": 175,
          "texto": "    sy = T.guarda_meio_y_pico + (T.guarda_meio_y_frente - T.guarda_meio_y_pico) * g ** 2;"
        },
        {
          "tipo": "+",
          "linha": 176,
          "texto": "    sz -= d; sy -= Math.min(d, 0);"
        },
        {
          "tipo": "+",
          "linha": 177,
          "texto": "  }"
        },
        {
          "tipo": "+",
          "linha": 178,
          "texto": "  return { zc: centroZ(T, x), sz, sy };"
        },
        {
          "tipo": "+",
          "linha": 179,
          "texto": "}"
        },
        {
          "tipo": "+",
          "linha": 180,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 181,
          "texto": "export function planosDoCabo(T) {"
        },
        {
          "tipo": "+",
          "linha": 182,
          "texto": "  const guarda = [];"
        },
        {
          "tipo": "+",
          "linha": 183,
          "texto": "  for (let k = 0; ; k++) { const x = T.cabo_frente - 2.5 * k; if (x < 60) break; guarda.push(x); }"
        },
        {
          "tipo": "+",
          "linha": 184,
          "texto": "  return [...[...T.bico_planos].sort((a, b) => a - b), ...guarda.reverse()];"
        },
        {
          "tipo": "+",
          "linha": 185,
          "texto": "}"
        },
        {
          "tipo": "+",
          "linha": 186,
          "texto": ""
        },
        {
          "tipo": "+",
          "linha": 187,
          "texto": "function anel(T, x) {"
        },
        {
          "tipo": "+",
          "linha": 188,
          "texto": "  const { zc, sz, sy } = secaoDoCabo(T, x);"
        },
        {
          "tipo": "+",
          "linha": 189,
          "texto": "  const p = T.oval_expoente;"
        },
        {
          "tipo": "+",
          "linha": 190,
          "texto": "  const pt = (k) => {"
        },
        {
          "tipo": "+",
          "linha": 191,
          "texto": "    const th = (k * Math.PI) / 8;"
        },
        {
          "tipo": "+",
          "linha": 192,
          "texto": "    const c = Math.cos(th); const sn = Math.sin(th);"
        },
        {
          "tipo": "+",
          "linha": 193,
          "texto": "    const v = zc + sz * Math.sign(c) * Math.abs(c) ** (2 / p);"
        },
        {
          "tipo": "+",
          "linha": 194,
          "texto": "    const u = T.eixo_y + sy * Math.sign(sn) * Math.abs(sn) ** (2 / p);"
        },
        {
          "tipo": "+",
          "linha": 195,
          "texto": "    return [u, v];"
        },
        {
          "tipo": "+",
          "linha": 196,
          "texto": "  };"
        },
        {
          "tipo": "+",
          "linha": 197,
          "texto": "  const trecho = (k0) => Array.from({ length: 5 }, (_, i) => pt((k0 + i) % 16));"
        },
        {
          "tipo": "+",
          "linha": 198,
          "texto": "  return { a: trecho(0), b: trecho(4), c: trecho(8), d: trecho(12) };"
        },
        {
          "tipo": "+",
          "linha": 199,
          "texto": "}"
        },
        {
          "tipo": "+",
          "linha": 200,
          "texto": ""
        }
      ],
