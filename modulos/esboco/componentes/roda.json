    "aro": 420,
    "largura": 125,
    "espessuraDisco": "=largura/3",
    "diametroCubo": 90,
    "salienciaCubo": 30,
    "raios": 0,
    "raioCubo": "=diametroCubo/2",
    "larguraRaio": 14,
    "espessuraAro": 12,
    "larguraAro": "=largura*0.8",
    "flanges": 0,
    "diametroFlange": "=diametroCubo*1.7",
    "espessuraFlange": 8,
    "ombro": 0
  },
  "entradas": { "centro": null, "sobre": null, "alinha": null, "encosta": null, "desloca": null },
  "formas": [
    { "id": "pneu", "tipo": "anel", "diametroExterno": "diametro", "diametroInterno": "aro", "espessura": "largura", "eixo": "x", "centro": "@centro", "sobre": "@sobre", "alinha": "@alinha", "encosta": "@encosta", "desloca": "@desloca", "cor": "preto", "exceto": ["ombro", "!raios"] },
    { "id": "pneu", "tipo": "revolucao", "eixo": "x", "perfil": { "gerar": "pneu", "raio": "=diametro/2", "raioAro": "=aro/2", "largura": "largura", "ombro": "ombro" }, "centro": "@centro", "sobre": "@sobre", "alinha": "@alinha", "encosta": "@encosta", "desloca": "@desloca", "cor": "preto", "quando": ["ombro", "!raios"] },
    { "id": "disco", "tipo": "cilindro", "diametro": "aro", "comprimento": "espessuraDisco", "eixo": "x", "centro": "pneu.centro", "cor": "cinza", "quando": ["!raios", "!ombro"] },
    { "id": "disco", "tipo": "extrusao", "origem": "perfil", "eixo": "x", "comprimento": "espessuraDisco", "perfil": { "gerar": "raios", "n": "raios", "rin": "raioCubo", "rout": "=aro/2-espessuraAro", "largura": "larguraRaio" }, "centro": "pneu.centro", "cor": "cinza", "quando": "raios" },
    { "id": "aro", "tipo": "anel", "diametroExterno": "aro", "diametroInterno": "=aro-2*espessuraAro", "espessura": "larguraAro", "eixo": "x", "centro": "pneu.centro", "cor": "cinza", "quando": "raios" },
    { "id": "cuboE", "tipo": "cilindro", "diametro": "diametroCubo", "comprimento": "salienciaCubo", "eixo": "x", "ponta": { "id": "disco", "lado": "-x" }, "cor": "cinza", "exceto": ["ombro", "!raios"] },
    { "id": "cuboD", "tipo": "cilindro", "diametro": "diametroCubo", "comprimento": "salienciaCubo", "eixo": "x", "ponta": { "id": "disco", "lado": "+x" }, "cor": "cinza", "exceto": ["ombro", "!raios"] },
    { "id": "cuboE", "tipo": "cilindro", "diametro": "diametroCubo", "comprimento": "salienciaCubo", "eixo": "x", "ponta": { "id": "pneu", "lado": "-x" }, "cor": "cinza", "quando": ["ombro", "!raios"] },
    { "id": "cuboD", "tipo": "cilindro", "diametro": "diametroCubo", "comprimento": "salienciaCubo", "eixo": "x", "ponta": { "id": "pneu", "lado": "+x" }, "cor": "cinza", "quando": ["ombro", "!raios"] },
    { "id": "flangeE", "tipo": "cilindro", "diametro": "diametroFlange", "comprimento": "espessuraFlange", "eixo": "x", "ponta": { "id": "cuboE", "lado": "-x" }, "cor": "cinza", "quando": "flanges" },
    { "id": "flangeD", "tipo": "cilindro", "diametro": "diametroFlange", "comprimento": "espessuraFlange", "eixo": "x", "ponta": { "id": "cuboD", "lado": "+x" }, "cor": "cinza", "quando": "flanges" }
