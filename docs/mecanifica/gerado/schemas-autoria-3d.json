            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "estado": {
                      "const": "esperado"
                    }
                  },
                  "required": [
                    "estado"
                  ]
                },
                "then": {
                  "properties": {
                    "assinatura": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "estado": {
                      "const": "compilado"
                    }
                  },
                  "required": [
                    "estado"
                  ]
                },
                "then": {
                  "properties": {
                    "assinatura": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  }
                }
              }
            ]
          }
