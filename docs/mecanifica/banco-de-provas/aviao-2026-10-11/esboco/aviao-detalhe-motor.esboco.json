      { "pecas": ["fuselagem", "barbatana"], "max": 40, "motivo": "a barbatana ventral se funde ao ventre da cauda" },
      { "pecas": ["fuselagem", "portaE"], "max": 40, "motivo": "a porta fica rente ao flanco esquerdo da cabine" },
