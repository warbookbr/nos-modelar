    "empenagem-vertical": { "cor": "roxo", "funcao": "deriva e leme preso por eixo, montados no dorso da cauda da fuselagem" },
    "trem-do-nariz": { "cor": "amarelo", "funcao": "roda, perna, amortecedor e garfo do trem do nariz, presos sob o capô, com o braço que o liga ao ventre da fuselagem" },
    "trens-principais": { "cor": "vermelho", "funcao": "roda, perna, amortecedor e atuador de cada trem principal, presos sob a asa" }
