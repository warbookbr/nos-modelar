    "fuselagem": { "cor": "cinza", "funcao": "casco da fuselagem em seções lisas, do capô à ponta da cauda, com a barbatana ventral, o para-brisa, as janelas laterais e a porta traseira esquerda, que é a estrutura a que todo o resto do avião se prende" },
    "motor": { "cor": "verde", "funcao": "capô oco, aberto na frente em torno do cone da hélice, com o duto da entrada de ar dentro dele sob o cone, três venezianas de arrefecimento em cada flanco e os dois escapes laterais, preso à frente da fuselagem" },
    "helice": { "cor": "preto", "funcao": "cone e cinco pás em arranjo radial, que giram em torno do eixo do motor à frente do capô" },
