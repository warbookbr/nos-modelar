      { "pecas": ["capo", "entradaAr"], "max": 40, "motivo": "a entrada de ar sai do ventre do capô" },
      { "pecas": ["capo", "escapeE"], "max": 100, "motivo": "o tubo de escape sai do flanco do capô" },
      { "pecas": ["eixoFlapE", "asaE", "flapE"], "max": 20, "motivo": "o eixo do flap atravessa a borda de fuga da asa e a borda de ataque do flap" },
