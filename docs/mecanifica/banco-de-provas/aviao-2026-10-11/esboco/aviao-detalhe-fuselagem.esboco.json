    "motor": { "cor": "verde", "funcao": "capô oco, aberto na frente em torno do cone da hélice, com o duto da entrada de ar dentro dele sob o cone, três venezianas de arrefecimento em cada flanco e os dois escapes laterais, preso à frente da fuselagem" },
    "helice": { "cor": "preto", "funcao": "cone de ponta arredondada com placa traseira e cinco pás de perfil aerodinâmico torcido da raiz à ponta, cada uma presa ao cone por um colar, que giram em torno do eixo do motor à frente do capô" },
    "asas": { "cor": "azul", "funcao": "as duas metades da asa baixa, com diedro, aileron e flap em cada metade presos por eixo, presas aos flancos da fuselagem" },
