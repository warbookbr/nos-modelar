      { "pecas": ["eixoProfundorE", "estabE", "profundorE"], "max": 20, "motivo": "o eixo do profundor atravessa a borda de fuga do estabilizador e a de ataque do profundor" },
      { "pecas": ["eixoLeme", "deriva", "leme"], "max": 20, "motivo": "o eixo do leme atravessa a borda de fuga da deriva e a de ataque do leme" },
      { "pecas": ["pistaoPrincE", "rodaPrincE.*"], "max": 40, "motivo": "o amortecedor termina no eixo do cubo da roda" },
      { "pecas": ["pernaPrincE", "asaE"], "max": 50, "motivo": "a perna do trem principal se prende na longarina da asa" },
      { "pecas": ["atuadorPrincE", "asaE"], "max": 50, "motivo": "o atuador do trem principal se prende sob a raiz da asa" },
      { "pecas": ["pernaNariz", "capo"], "max": 40, "motivo": "a perna do trem do nariz se prende sob o capô" },
      { "pecas": ["bracoNariz", "fuselagem"], "max": 40, "motivo": "o braço do trem do nariz se prende no ventre da fuselagem" },
      { "pecas": ["fuselagem", "parabrisa", "molduraParabrisa", "divisorParabrisa"], "max": 40, "motivo": "o para-brisa, a moldura e o divisor assentam sobre o dorso da proa da cabine" },
      { "pecas": ["fuselagem", "janela1E", "janela2E", "janela3E", "janela4E", "molduraJanela1E", "molduraJanela2E", "molduraJanela3E", "molduraJanela4E", "portaE", "molduraPortaE"], "max": 40, "motivo": "vidros, molduras, porta e batente ficam rentes ao flanco esquerdo da cabine" },
      { "pecas": ["capo", "escapeE"], "max": 100, "motivo": "o tubo de escape assenta no flanco do capô, com o eixo a escSai mm da superfície" },
      { "pecas": ["capo", "flangeEscapeE", "bocalEscapeE"], "max": 80, "motivo": "o flange e o bocal do escape são anéis maiores que a distância do eixo ao flanco e afundam nele" },
