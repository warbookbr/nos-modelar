  "regra": {
    "julgamentosDaChave": 5,
    "julgamentosDasOutras": 3,
    "acerto": "A imagem acerta quando a mediana das notas cai na faixa da nota, no máximo um julgamento sai da faixa e cada defeito que o crítico decide é citado: o veredito traz um defeito de tipo entre os aceitos e com alguma das palavras do defeito na parte, no onde ou na evidência. Os defeitos que a medida decide não são cobrados do crítico, porque a medida os reprova antes de ele olhar.",
    "passa": {
      "minimo": 11,
      "de": 12,
      "obrigatorias": [
        "dobradicas-por-fora",
        "picape-baixa"
      ]
    }
  },
  "medidas": {
    "familias": {
      "cilindro-hidraulico": {
        "nota": "A razão entre o diâmetro da haste e o da camisa fica na faixa que as restrições do contrato derivam da ISO 6020-2: a haste de 0,45 a 0,75 do êmbolo e a camisa de 1,13 a 1,67 vezes o êmbolo dão de 0,27 a 0,66. A medida não declara contato nem forma: ponta no ar, travessia, peça fora do lugar e faceta ficam com o crítico.",
        "razoes": [
          {
            "nome": "hastePelaCamisa",
            "origem": "ficha",
            "mede": {
              "razao": [
                {
                  "caixa": "y",
                  "formas": [
                    "haste"
                  ]
                },
                {
                  "caixa": "y",
                  "formas": [
                    "tubo"
                  ]
                }
              ],
              "faixa": [
                0.27,
                0.67
              ]
            }
          }
        ]
      },
      "roda-pneu": {
        "nota": "O pneu é um anel (um furo passante), e o disco, com a chapa ou os raios, chega ao barril do aro: a razão entre a altura do disco e a do aro é a que o `derivar` dá, de 0,975, e a faixa deixa folga para o corte do raio. A medida não declara contato: o crítico decide o que ela não alcança.",
        "formas": {
          "pneu": "anel"
        },
        "razoes": [
          {
            "nome": "discoAlcancaOAro",
            "origem": "ia",
            "mede": {
