+/** Anota que `pedaco` nasceu de `pai` numa booleana (ou no refino da costura dela): o corte de uma face de entrada deixa o maior pedaço com o id e dá
+ *  id novo aos outros, e a origem que citava a face continua citando a superfície inteira. `st.pedacosDe` guarda o pai de cada pedaço de qualquer
+ *  operação; este mapa guarda só os da booleana, para a resolução de origem não expandir os pedaços que outras operações registram ali. */
+export function registraPedacoDaBooleana(st, pedaco, pai) {
+  const mapa = (st.pedacosDaBooleana ??= new Map());
+  const filhos = mapa.get(pai);
+  if (filhos) { if (!filhos.includes(pedaco)) filhos.push(pedaco); } else mapa.set(pai, [pedaco]);
+}
+
+/** Os pedaços da divisão por contorno e os da booleana, para a resolução de origem: devolve a lista com os pedaços de cada face logo depois dela
+ *  (os dos pedaços também). Os da divisão entram como em `comOsPedacosDaDivisao`. Os da booleana só entram se vivem (o pedaço que um passo
+ *  posterior apagou ou consumiu já não é da superfície) e se a lista ainda não os cita, para a ordem que o gerador deu não mudar. Devolve a
+ *  própria lista quando nenhuma face dela foi refeita. */
+export function comOsPedacosRefeitos(st, lista) {
+  const divisao = st.pedacosDaDivisao, booleana = st.pedacosDaBooleana;
+  if (!(divisao?.size || booleana?.size) || !lista.some((f) => divisao?.has(f) || booleana?.has(f))) return lista;
+  const citadas = new Set(lista);
+  const faces = []; const postas = new Set();
+  const desce = (f) => {
+    for (const p of booleana?.get(f) ?? []) {
+      if (citadas.has(p) || postas.has(p)) continue;   // a lista já a cita: ela entra no lugar dela, com os pedaços que tiver
+      if (st.F.has(p)) { postas.add(p); faces.push(p); for (const q of divisao?.get(p) ?? []) poe(q); }
+      desce(p);
+    }
+  };
+  const poe = (f) => {
+    if (postas.has(f)) return;
+    postas.add(f); faces.push(f);
+    for (const p of divisao?.get(f) ?? []) poe(p);
+    desce(f);
+  };
+  for (const f of lista) poe(f);
+  return faces;
+}
+
 /** A face é um pedaço que a divisão criou (e não a face cortada, que fica com o id). */
 export function ehPedacoDaDivisao(st, f) {
   const pai = st.pedacosDe?.get(f);
@@ -53,6 +88,12 @@ export function tirarDosPedacosDaDivisao(st, saidas) {
