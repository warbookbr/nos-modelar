@@ -0,0 +1,80 @@
+/* pedacos-da-booleana.test.mjs — a origem que cita uma face continua citando os pedaços dela depois de uma booleana que a refaz.
+ *
+ * A booleana deixa o maior pedaço de uma face cortada com o id e dá id novo aos outros (`st.pedacosDe`). Antes, a origem de um gerador anterior
+ * (`{op:'cubo', id:1, face:'direita'}`) resolvia só para o id que ficou, e uma `parte` ou um `material` por essa origem pegava um pedaço da face.
+ * Agora a resolução de origem soma os pedaços vivos, como já fazia com os da divisão por contorno. A fixture é um cubo de 2 de lado menos um prisma de
+ * 8 lados e raio 0,6 que o atravessa em x: as duas tampas em x ficam com um furo octogonal, e a área de cada uma é conhecida em fórmula. */
+import { describe, expect, it } from 'vitest';
+import { nucleo } from './entrada.js';
+
+const R = 0.6;
+const BASE = [
+  ['cubo', { origemId: 1, larg: 2, alt: 2, prof: 2, em: [0, 0, 0] }],
+  ['cilindro', { origemId: 2, raio: R, altura: 4, lados: 8, eixo: 'x', em: [-2, 1, 0.2] }],
+  ['subtrair', { origemId: 3, solidos: [{ origem: { op: 'cubo', id: 1 } }, { alias: 'cil' }] }],
+];
+const ALIAS = [['cil', { unir: [{ origem: { op: 'cilindro', id: 2 } }, { origem: { op: 'cilindro', id: 2, tampa: 'fundo' } }, { origem: { op: 'cilindro', id: 2, tampa: 'topo' } }] }]];
+const AREA_DA_TAMPA_COM_FURO = 4 - 2 * Math.SQRT2 * R * R;
+
+const areaDe = (n, f) => {
+  const P = f.vs.map((v) => n.V.get(v)); const a = [0, 0, 0];
+  for (let k = 1; k < P.length - 1; k++) {
+    const u = P[k].map((c, j) => c - P[0][j]), w = P[k + 1].map((c, j) => c - P[0][j]);
+    a[0] += u[1] * w[2] - u[2] * w[1]; a[1] += u[2] * w[0] - u[0] * w[2]; a[2] += u[0] * w[1] - u[1] * w[0];
+  }
+  return Math.hypot(...a) / 2;
+};
+const daParte = (passos, sel) => {
+  const n = nucleo([...passos, ['parte', { nome: 'p', sel }]], {}, {}, {}, null, ALIAS);
+  const faces = [...n.F.values()].filter((f) => f.parte === 'p');
+  return { n, ids: faces.map((f) => f.id), area: faces.reduce((s, f) => s + areaDe(n, f), 0) };
+};
+
+describe('origem de um gerador anterior depois de uma booleana que refaz a face citada', () => {
+  for (const face of ['esquerda', 'direita']) {
+    it(`a face ${face} do cubo cobre a tampa inteira, com os pedaços do corte`, () => {
+      const r = daParte(BASE, { origem: { op: 'cubo', id: 1, face } });
+      expect(r.n.orfaos).toEqual([]);
+      expect(r.ids.length).toBeGreaterThan(1);
+      expect(r.area).toBeCloseTo(AREA_DA_TAMPA_COM_FURO, 9);
+    });
+  }
+
+  it('a face que a booleana não cortou continua sendo uma só', () => {
+    const r = daParte(BASE, { origem: { op: 'cubo', id: 1, face: 'topo' } });
+    expect(r.ids).toHaveLength(1);
+    expect(r.area).toBeCloseTo(4, 9);
+  });
+
+  it('o cubo inteiro cobre as seis faces e os pedaços das duas tampas cortadas, sem repetir face', () => {
+    const r = daParte(BASE, { origem: { op: 'cubo', id: 1 } });
+    expect(r.ids).toHaveLength(6 + 2 * 8);
+    expect(new Set(r.ids).size).toBe(r.ids.length);
+    expect(r.area).toBeCloseTo(4 * 4 + 2 * AREA_DA_TAMPA_COM_FURO, 9);
+  });
+
+  it('a mesma entrada dá a mesma lista, na mesma ordem', () => {
+    const a = daParte(BASE, { origem: { op: 'cubo', id: 1, face: 'direita' } }).ids;
+    const b = daParte(BASE, { origem: { op: 'cubo', id: 1, face: 'direita' } }).ids;
+    expect(a).toEqual(b);
+    expect([...a].sort((x, y) => x - y)).toEqual(a);
+  });
+
+  it('a origem da própria booleana não ganha face nem perde a ordem que já tinha', () => {
+    const n = nucleo(BASE, {}, {}, {}, null, ALIAS);
+    const registrada = n.origens.get(3)[0].faces;
+    const r = daParte(BASE, { origem: { op: 'subtrair', id: 3 } });
+    expect(r.ids).toEqual(registrada.filter((f) => n.F.has(f)));
+  });
+
+  it('a cópia feita antes do corte não grita pelo pedaço que não conhece', () => {
+    const passos = [
+      ['cubo', { origemId: 1, larg: 2, alt: 2, prof: 2, em: [0, 0, 0] }],
+      ['espelha', { eixo: 'y', pos: 5, origemId: 4, derivaDe: { op: 'cubo', id: 1 }, sel: { origem: { op: 'cubo', id: 1 } } }],
+      ...BASE.slice(1),
+    ];
+    const n = nucleo([...passos, ['parte', { nome: 'c', sel: { origem: { op: 'espelha', id: 4, de: { op: 'cubo', id: 1 } } } }]], {}, {}, {}, null, ALIAS);
+    expect(n.orfaos).toEqual([]);
+    expect([...n.F.values()].filter((f) => f.parte === 'c')).toHaveLength(6);
+  });
+});
