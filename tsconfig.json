{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    "strict": true,
    // desligado de propósito (D-110, fase 2b): o gate cobre testes da Mecanifica
    // e do núcleo herdado sobre módulos .js sem tipos. Checar todo acesso por
    // índice (arr[i]/Map.get) só geraria ruído; `strict` continua ligado.
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    "noEmit": true
  },
  "include": ["tools/oficina/**/*.ts", "tools/mecanifica/**/*.ts"]
}
