node_modules/
dist/
coverage/
*.tsbuildinfo
.DS_Store
debug.log
laboratorio/.lab/
laboratorio/.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Tick runtime artifacts (generated per run, never committed — see tick.yml)
pending_commands.json
command_results.json

# Previews de sprites (8x, contact sheets, mapa mock) — artefatos de build,
# regenerados por `npm run build:sprites` (assets/tools/) em assets/preview/.
assets/preview/

# Screenshots da auditoria visual do FPS (`npm run olhar`, D-35) — evidência
# regenerável, nunca versionada (D-30).
tools/bancadas/out/
prototipos/fps/bake/out/

# Área temporária que `ativar-bancada.test.mjs` cria com mkdtemp. O teste limpa
# o que criou, mas a pasta `tmp/` em si fica, e execução interrompida deixa
# resíduo dentro dela. Ela precisa existir no disco e nunca no commit: é dentro
# do repositório, e não em /tmp, porque o confinamento de caminhos recusa
# destino fora da árvore.
tmp/

# rascunho de sessão do coder — nunca commitar
scratchpad/

# worktrees temporários de agentes isolados — código vive nos commits deles,
# nunca no diretório de trabalho principal
.claude/worktrees/
.worktrees/

# A malha do canário N6, 5,5 MB derivados de uma hipótese REPROVADA. O README
# da pasta proíbe reutilizar esse volume, e `construir-casco-visual.mjs` o
# regenera quando alguém quiser reexaminar. Versionar malha que ninguém pode
# usar é peso sem leitor.
autoria-assistida/experimentos/canario-casco-visual-n6/modelo-casco.json

# Exportações CAD/STEP geradas localmente
exportacoes/

# Sessão ativa da bancada — estado local, não versionado
sessao-ativa.json
public/sessao-ativa.json

# Arquivos temporários e de ambiente
.agent/
.mcp.json
.diario/
