{
  "formato": "mecanifica.proporcoes@1",
  "id": "braco-de-prova",
  "unidade": "mm",
  "nota": "Fixture do esqueleto de proporção: um tronco com bacia e um braço de duas juntas (ombro e cotovelo) com mão, e o espelho do lado esquerdo. O ombro abduz e o cotovelo dobra para dentro (eixo z), de modo que o antebraço alcança o tronco. `npm run esqueleto -- --proporcoes=tools/fixtures/esqueleto/proporcoes.json --escrever` grava andaime.json, articulacoes.json e esqueleto.json.",
  "medidas": {
    "alturaDoTronco": 1400,
    "larguraDosOmbros": 400,
    "comprimentoDoBraco": 300,
    "comprimentoDoAntebraco": 250,
    "raioDoTronco": 70,
    "raioDoOmbro": 40,
    "raioDoCotovelo": 32,
    "raioDaMao": 28,
    "raioDoBastaoDoBraco": 22,
    "raioDoBastaoDoAntebraco": 18,
    "comprimentoDoTorso": 450,
    "raioDoTorso": 80,
    "raioDaBacia": 90
  },
  "esqueleto": {
    "id": "braco-de-prova",
    "familia": "humanoide",
    "intencao": "Tronco com braço de prova de duas juntas, mão e o espelho esquerdo, na pose zero (braços pendentes).",
    "saidas": {
      "andaime": "andaime.json",
      "articulacoes": "articulacoes.json",
      "esqueleto": "esqueleto.json"
    },
    "raiz": {
      "id": "tronco",
      "posicao": [
        0,
        "=alturaDoTronco",
        0
      ],
      "raioDaBola": "=raioDoTronco"
    },
    "juntas": [
      {
        "id": "ombro-direito",
        "pai": "tronco",
        "comprimento": "=larguraDosOmbros / 2",
        "direcao": [
          1,
          0,
          0
        ],
        "raioDaBola": "=raioDoOmbro",
        "raioDoBastao": "=raioDoBastaoDoBraco",
        "eixo": [
          0,
          0,
          1
        ],
        "curso": {
          "minimo": -100,
          "maximo": 180
        }
      },
      {
        "id": "cotovelo-direito",
        "pai": "ombro-direito",
        "comprimento": "=comprimentoDoBraco",
        "direcao": [
          0,
          -1,
          0
        ],
        "raioDaBola": "=raioDoCotovelo",
        "raioDoBastao": "=raioDoBastaoDoBraco",
        "eixo": [
          0,
          0,
          1
        ],
        "curso": {
          "minimo": -140,
          "maximo": 0
        }
      },
      {
        "id": "mao-direito",
        "pai": "cotovelo-direito",
        "comprimento": "=comprimentoDoAntebraco",
        "direcao": [
          0,
          -1,
          0
        ],
        "raioDaBola": "=raioDaMao",
        "raioDoBastao": "=raioDoBastaoDoAntebraco"
      },
      {
        "id": "ombro-esquerdo",
        "pai": "tronco",
        "espelho": {
          "de": "ombro-direito",
          "plano": "x",
          "troca": [
            "direito",
            "esquerdo"
          ]
        }
      },
      {
        "id": "bacia",
        "pai": "tronco",
        "comprimento": "=comprimentoDoTorso",
        "direcao": [
          0,
          -1,
          0
        ],
        "raioDaBola": "=raioDaBacia",
        "raioDoBastao": "=raioDoTorso"
      }
    ],
    "poses": {
      "bracos-abertos": {
        "angulos": {
          "ombro-direito": 90,
          "ombro-esquerdo": 90
        }
      },
      "antebraco-no-tronco": {
        "angulos": {
          "cotovelo-direito": -90
        }
      }
    }
  }
}
