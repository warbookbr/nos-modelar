      { "id": "cotovelo-direito", "pai": "ombro-direito", "comprimento": "=comprimentoDoBraco", "direcao": [0, -1, 0], "raioDaBola": "=raioDoCotovelo", "raioDoBastao": "=raioDoBastaoDoBraco", "eixo": [1, 0, 0], "curso": { "minimo": 0, "maximo": 140 } },
      { "id": "mao-direito", "pai": "cotovelo-direito", "comprimento": "=comprimentoDoAntebraco", "direcao": [0, -1, 0], "raioDaBola": "=raioDaMao", "raioDoBastao": "=raioDoBastaoDoAntebraco" },
      { "id": "ombro-esquerdo", "pai": "tronco", "espelho": { "de": "ombro-direito", "plano": "x", "troca": ["direito", "esquerdo"] } }
