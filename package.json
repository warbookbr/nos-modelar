{
  "name": "mecanifica",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mecanifica - simulador 3D interativo para explicar sistemas automotivos.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coord": "node tools/coordenacao/coord.mjs",
    "bancada": "node tools/mecanifica/olhar-bancada.mjs",
    "revisar": "node tools/mecanifica/olhar-bancada.mjs --revisar",
    "preparar:modelagem": "node tools/modelagem/preparar-pacote.mjs",
    "validar:modelagem": "node tools/modelagem/validar-pacote.mjs",
    "revisar:modelagem": "node tools/modelagem/revisar-pacote.mjs",
    "comparar:revisao": "node tools/modelagem/comparar-revisao.mjs",
    "validar:critica": "node tools/modelagem/critica-modelagem.mjs",
    "guarda:portas": "node tools/mecanifica/guarda-portas-bancada.mjs",
    "descrever": "node tools/mecanifica/descrever-peca.mjs",
    "peca": "node tools/bancadas/olhar-peca.mjs",
    "executar": "node tools/bancadas/executar.mjs",
    "jogar": "node tools/bancadas/jogar.mjs",
    "porteiro": "node tools/bancadas/porteiro.mjs",
    "auditar": "node tools/bancadas/auditar.mjs",
    "gabarito": "node tools/bancadas/gabarito.mjs",
    "gabarito:selecao": "node tools/bancadas/gabarito-selecao.mjs",
    "gabarito:selecao:check": "node tools/bancadas/gabarito-selecao.mjs --check",
    "id-cru": "node tools/bancadas/id-cru.mjs",
    "id-cru:check": "node tools/bancadas/id-cru.mjs --check",
    "criar": "node tools/bancadas/criar.mjs",
    "bench": "node tools/bancadas/bench/benchmark.mjs",
    "mapa": "node tools/mapa/mapa.mjs",
    "mapa:check": "node tools/mapa/mapa.mjs --check",
    "docs:toc": "node tools/mapa/toc.mjs",
    "docs:toc:check": "node tools/mapa/toc.mjs --check",
    "docs:links": "node tools/mapa/links.mjs",
    "docs:links:check": "node tools/mapa/links.mjs --check"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "playwright": "1.56.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
