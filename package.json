{
  "name": "mecanifica",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mecanifica - simulador 3D interativo para explicar sistemas automotivos.",
  "engines": {
    "node": "^20.19.0 || ^22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "arquitetura:check": "node tools/arquitetura/independencia-catalogo.mjs",
    "arquitetura:lab:check": "node tools/arquitetura/independencia-laboratorio.mjs",
    "lab:test": "python3 -m pytest laboratorio/testes -q",
    "lab:check": "npm run arquitetura:lab:check && npm run lab:test",
    "arquitetura:motor": "node tools/arquitetura/mapear-motor-procedural.mjs",
    "arquitetura:motor:check": "node tools/arquitetura/mapear-motor-procedural.mjs --check",
    "baseline:motor": "node tools/oficina/corpus-motor-r00.mjs --check",
    "baseline:motor:medir": "node tools/oficina/corpus-motor-r00.mjs --medir",
    "catalogo:gerar": "node tools/catalogo/gerar-catalogo-capacidades.mjs",
    "catalogo:check": "node tools/catalogo/gerar-catalogo-capacidades.mjs --check",
    "autoria:schemas:gerar": "node tools/mecanifica/gerar-schemas-autoria-3d.mjs",
    "autoria:schemas:check": "node tools/mecanifica/gerar-schemas-autoria-3d.mjs --check",
    "autoria:n2:evidencias": "node tools/mecanifica/gerar-evidencias-forma-global-n2.mjs --png",
    "autoria:n2:evidencias:check": "node tools/mecanifica/gerar-evidencias-forma-global-n2.mjs --check",
    "percepcao:n3:evidencias": "node autoria-assistida/experimentos/canal-percepcao-n3/gerar-evidencias.mjs",
    "procedencia:check": "node tools/mecanifica/procedencia-check.mjs",
    "bancada:vazia:check": "node tools/mecanifica/guarda-bancada-vazia.mjs",
    "test": "vitest run",
    "mcp:check": "vitest run tools/mcp/mcp.test.mjs tools/mcp/procedural.test.mjs tools/mcp/perfis/autoria-execucao.test.mjs",
    "mcp:ensaio": "vitest run tools/mcp/ensaio-ponta-a-ponta.test.mjs",
    "test:watch": "vitest",
    "coord": "node tools/coordenacao/coord.mjs",
    "bancada": "node tools/mecanifica/olhar-bancada.mjs",
    "revisar": "node tools/mecanifica/olhar-bancada.mjs --revisar",
    "preparar:modelagem": "node tools/modelagem/preparar-pacote.mjs",
    "validar:modelagem": "node tools/modelagem/validar-pacote.mjs",
    "revisar:modelagem": "node tools/modelagem/revisar-pacote.mjs",
    "comparar:revisao": "node tools/modelagem/comparar-revisao.mjs",
    "fechar:aceite:visual": "node tools/modelagem/fechar-aceite-visual.mjs",
    "validar:critica": "node tools/modelagem/critica-modelagem.mjs",
    "guarda:portas": "node tools/mecanifica/guarda-portas-bancada.mjs",
    "guarda:camera": "node tools/mecanifica/guarda-camera-livre.mjs",
    "guarda:par": "node tools/mecanifica/guarda-inspecao-par.mjs",
    "descrever": "node tools/mecanifica/descrever-peca.mjs",
    "descrever:montagem": "node tools/mecanifica/descrever-montagem.mjs",
    "descrever:montagem:persistida": "node tools/mecanifica/descrever-montagem-persistida.mjs",
    "olhar:montagem": "node tools/mecanifica/olhar-montagem.mjs",
    "peca": "node tools/bancadas/olhar-peca.mjs",
    "executar": "node tools/bancadas/executar.mjs",
    "porteiro": "node tools/bancadas/porteiro.mjs",
    "gabarito": "node tools/bancadas/gabarito.mjs",
    "criar": "node tools/bancadas/criar.mjs",
    "mapa": "node tools/mapa/mapa.mjs",
    "mapa:check": "node tools/mapa/mapa.mjs --check",
    "docs:toc": "node tools/mapa/toc.mjs",
    "docs:toc:check": "node tools/mapa/toc.mjs --check",
    "docs:links": "node tools/mapa/links.mjs",
    "docs:links:check": "node tools/mapa/links.mjs --check",
    "planos:check": "node tools/mapa/planos.mjs --check",
    "docs:estrutura": "node tools/mapa/estrutura-docs.mjs",
    "docs:estrutura:check": "node tools/mapa/estrutura-docs.mjs --check",
    "exportar": "node tools/mecanifica/exportar.mjs",
    "exportar:check": "node tools/mecanifica/exportar.mjs --check",
    "exportar:step": "node tools/mecanifica/exportar-step.mjs",
    "exportar:obj": "node tools/mecanifica/exportar-obj.mjs",
    "ativar:bancada": "node tools/mecanifica/ativar-bancada.mjs",
    "malha:conferir": "node tools/mecanifica/conferir-malha.mjs",
    "olhar": "node tools/mecanifica/olhar.mjs",
    "comparar:alvo": "node tools/mecanifica/comparar-alvo.mjs",
    "gates": "npm run typecheck && npm run test && npm run mcp:check && npm run build && npm run arquitetura:check && npm run bancada:vazia:check && npm run porteiro && npm run exportar:check && npm run guarda:portas && npm run guarda:camera && npm run guarda:par && npm run mapa:check && npm run docs:toc:check && npm run docs:links:check && npm run planos:check && npm run docs:estrutura:check && npm run arquitetura:lab:check && npm run lab:test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "ajv": "^8.20.0",
    "earcut": "3.0.2",
    "occt-wasm": "4.3.2",
    "three": "^0.185.1",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^26.1.1",
    "playwright": "1.56.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
